---
const canonicalRoute = "/observability/traces";
const gatewayRoutes = {
  recent: "/gateway/traces/recent",
  events: "/gateway/traces/events",
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Traces - Observability</title>
    <meta name="description" content="Live Consuelo workspace traces." />
  </head>
  <body>
    <main
      class="trace-shell"
      data-trace-app
      data-route={canonicalRoute}
      data-feed-url={gatewayRoutes.recent}
      data-events-url={gatewayRoutes.events}
    >
      <header class="trace-chrome">
        <div class="trace-dots" aria-hidden="true"><span></span><span></span><span></span></div>
        <div class="trace-title">Traces</div>
        <div class="trace-state" data-live-state data-state="loading">loading</div>
      </header>
      <div class="trace-toolbar">
        <input class="trace-search" data-search placeholder="Search traces..." aria-label="Search traces" autocomplete="off" />
        <select class="trace-window" data-window aria-label="Trace time window">
          <option value="1d">1 day</option>
        </select>
      </div>
      <section class="trace-table-pane" aria-label="Trace table">
        <div class="trace-table">
          <div class="trace-head">
            <span></span><span>Time</span><span>Tool</span><span>Latency</span><span>Tokens</span><span>Branch</span><span>Input</span><span>Output</span><span>Trace</span><span>Status</span><span>Cost</span>
          </div>
          <div data-trace-rows><div class="trace-empty">Loading traces...</div></div>
        </div>
      </section>
      <footer class="trace-footer">
        <span><b data-trace-count>0</b> traces</span>
        <span>Rows per page <b>100</b></span>
        <span>Page <input data-page-input value="1" inputmode="numeric" aria-label="Page" /> of <b data-page-count>1</b></span>
        <button type="button" data-prev-page aria-label="Previous page">‹</button>
        <button type="button" data-next-page aria-label="Next page">›</button>
        <span data-footer-state>loading</span>
      </footer>
    </main>

    <script is:inline>
      window.__consueloObservabilityTraces = {
        routes: {
          recent: "/gateway/traces/recent",
          events: "/gateway/traces/events",
        },
        module: "traces",
        presentation: "direct-table",
      };
    </script>
  </body>
</html>
