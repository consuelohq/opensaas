---
import HomeCloudCta from '../components/home/HomeCloudCta.astro';
import HomeFeaturePreview from '../components/home/HomeFeaturePreview.astro';
import HomeHero from '../components/home/HomeHero.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import { homeFaqItems } from '../data/home-content';
import { getFaqSchema, getSoftwareApplicationSchema } from '../lib/site-seo';
import MarketingLayout from '../layouts/MarketingLayout.astro';

const description =
  'Connect ChatGPT, Codex, Claude, and the agents that come next to the same tools, memory, workflows, and machines.';

const schemaEntries = [
  getSoftwareApplicationSchema({
    name: 'Consuelo OS',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'macOS, Linux, Web',
    offers: {
      '@type': 'AggregateOffer',
      lowPrice: '0',
      highPrice: '200',
      priceCurrency: 'USD',
      offerCount: '4',
    },
  }),
  getFaqSchema(homeFaqItems),
];
---

<MarketingLayout
  title="Consuelo OS | Your workspace, connected to every agent"
  description={description}
  canonicalPath="/"
  image="/consuelo-os-og.png"
  imageAlt="Consuelo OS — Your workspace, connected to every agent."
  imageWidth={1200}
  imageHeight={630}
  schemaEntries={schemaEntries}
>
  <SiteHeader pageSections={[{ id: 'features', label: 'FEATURES' }, { id: 'faq', label: 'FAQ' }]} />
  <main>
    <HomeHero sectionId="intro" />
    <HomeFeaturePreview sectionId="features" />
    <HomeCloudCta />
  </main>
</MarketingLayout>
