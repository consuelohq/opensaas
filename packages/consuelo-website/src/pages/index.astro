---
import SiteFooter from '../components/site/SiteFooter.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import HomeHero from '../components/home/HomeHero.astro';
import { homepageSeo } from '../lib/homepage-seo';
import { getSoftwareApplicationSchema } from '../lib/site-seo';
import MarketingLayout from '../layouts/MarketingLayout.astro';

const schemaEntries = [
  getSoftwareApplicationSchema({
    offers: {
      '@type': 'AggregateOffer',
      lowPrice: '0',
      highPrice: '20',
      priceCurrency: 'USD',
      offerCount: '2',
    },
  }),
];
---

<MarketingLayout
  title={homepageSeo.title}
  description={homepageSeo.description}
  canonicalPath="/"
  image={homepageSeo.image}
  imageAlt={homepageSeo.imageAlt}
  imageWidth={1200}
  imageHeight={630}
  schemaEntries={schemaEntries}
>
  <SiteHeader pageSections={[]} />
  <HomeHero sectionId="intro" />
  <SiteFooter />
</MarketingLayout>
