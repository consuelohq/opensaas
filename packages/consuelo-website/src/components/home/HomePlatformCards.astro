---
import { homePlatformCards } from '../../data/home-content';

type Props = {
  sectionId?: string;
};

const { sectionId = 'platforms' } = Astro.props as Props;
---

<section
  id={sectionId}
  class="home-platforms site-section"
  data-section="platforms"
  aria-label="Consuelo platform install and connect options"
>
  <div class="home-platforms__inner site-container site-container--wide">
    <div class="home-platforms__grid">
      {
        homePlatformCards.map((card) => (
          <article class="home-platforms__card" data-platform-card={card.id}>
            <figure class="home-platforms__art">
              <img src={card.imageSrc} alt={card.imageAlt} loading="lazy" decoding="async" />
            </figure>

            <div class="home-platforms__body">
              <p class="home-platforms__eyebrow site-eyebrow">{card.eyebrow}</p>
              <h2 class="home-platforms__title">{card.title}</h2>

              {card.providers ? (
                <p class="home-platforms__providers" aria-hidden="true">
                  {card.providers.map((provider) => (
                    <span class="home-platforms__provider">{provider}</span>
                  ))}
                </p>
              ) : null}

              {card.terminalCommand ? (
                <div class="home-platforms__terminal" data-platform-terminal={card.id}>
                  <code class="home-platforms__command">{card.terminalCommand}</code>
                  <button
                    type="button"
                    class="home-platforms__copy-btn"
                    data-copy-command={card.id}
                    aria-label="Copy install command"
                  >
                    <svg class="home-platforms__copy-icon" viewBox="0 0 24 24" aria-hidden="true">
                      <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
                      <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
                    </svg>
                    <svg class="home-platforms__check-icon" viewBox="0 0 24 24" aria-hidden="true">
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                  </button>
                </div>
              ) : null}

              {card.ctaHref ? (
                <a class="home-platforms__cta site-button site-button--secondary" href={card.ctaHref}>
                  <span>{card.ctaLabel}</span>
                  <svg class="home-platforms__cta-arrow" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </a>
              ) : null}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script define:vars={{ homePlatformCards }}>
  const copyButtons = Array.from(document.querySelectorAll('[data-copy-command]'));

  copyButtons.forEach((button) => {
    button.addEventListener('click', async () => {
      const cardId = button.getAttribute('data-copy-command');
      const card = homePlatformCards.find((entry) => entry.id === cardId);

      if (!card?.terminalCommand || !navigator.clipboard) {
        return;
      }

      await navigator.clipboard.writeText(card.terminalCommand);
      button.classList.add('is-copied');
      window.setTimeout(() => button.classList.remove('is-copied'), 1400);
    });
  });
</script>

<style>
  .home-platforms {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
    background: var(--site-color-paper);
    color: var(--site-color-on-brand);
  }

  .home-platforms__inner {
    display: grid;
  }

  .home-platforms__grid {
    display: grid;
    gap: clamp(1rem, 2vw, 1.35rem);
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .home-platforms__card {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: clamp(1rem, 2vw, 1.35rem);
    background: var(--site-color-surface);
    color: var(--site-color-ink);
    padding: clamp(0.85rem, 1.6vw, 1.15rem);
    border: 1px solid color-mix(in srgb, var(--site-color-ink) 14%, transparent);
  }

  .home-platforms__art {
    margin: 0;
    overflow: hidden;
    aspect-ratio: 10 / 7;
    background: color-mix(in srgb, var(--site-color-ink) 8%, var(--site-color-surface));
  }

  .home-platforms__art img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .home-platforms__body {
    display: grid;
    gap: clamp(0.55rem, 1.2vw, 0.8rem);
    align-content: start;
    padding-inline: clamp(0.15rem, 0.6vw, 0.35rem);
    padding-bottom: clamp(0.2rem, 0.8vw, 0.45rem);
  }

  .home-platforms__eyebrow {
    margin: 0;
    color: var(--site-color-muted);
    font-size: clamp(0.62rem, 0.82vw, 0.72rem);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .home-platforms__title {
    margin: 0;
    font-family: var(--site-font-display);
    font-size: clamp(1.85rem, 3vw, 2.45rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-transform: none;
    color: var(--site-color-ink);
  }

  .home-platforms__providers {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 0;
  }

  .home-platforms__provider {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--site-color-line-strong);
    color: var(--site-color-ink);
    padding: 0.28rem 0.55rem;
    font: 400 0.72rem / 1 var(--site-font-mono);
    letter-spacing: 0.02em;
  }

  .home-platforms__terminal {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
    border: 1px solid var(--site-color-line);
    background: var(--site-color-surface);
    padding: 0.72rem 0.8rem;
  }

  .home-platforms__command {
    min-width: 0;
    color: var(--site-color-ink);
    font: 400 clamp(0.68rem, 0.82vw, 0.76rem) / 1.35 var(--site-font-mono);
    overflow-wrap: anywhere;
  }

  .home-platforms__copy-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.85rem;
    height: 1.85rem;
    border: 0;
    background: transparent;
    color: var(--site-color-muted);
    padding: 0;
    flex: 0 0 auto;
    cursor: pointer;
  }

  .home-platforms__copy-btn svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  .home-platforms__check-icon {
    display: none;
  }

  .home-platforms__copy-btn.is-copied {
    color: var(--site-color-secondary);
  }

  .home-platforms__copy-btn.is-copied .home-platforms__copy-icon {
    display: none;
  }

  .home-platforms__copy-btn.is-copied .home-platforms__check-icon {
    display: block;
  }

  .home-platforms__cta {
    width: fit-content;
    min-height: 2.45rem;
    margin-top: 0.15rem;
    border-radius: calc(var(--site-radius-sm) * 0.25);
    background: var(--site-color-surface);
    font-family: var(--site-font-mono);
    font-size: clamp(0.76rem, 0.9vw, 0.86rem);
    font-weight: 400;
    letter-spacing: 0;
  }

  .home-platforms__cta-arrow {
    width: 0.95rem;
    height: 0.95rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 960px) {
    .home-platforms__grid {
      grid-template-columns: 1fr;
    }

    .home-platforms__card {
      max-width: 34rem;
      width: 100%;
      justify-self: center;
    }
  }

  @media (max-width: 640px) {
    .home-platforms {
      padding-block: clamp(2rem, 8vw, 3rem);
    }

    .home-platforms__title {
      font-size: clamp(1.65rem, 8vw, 2rem);
    }
  }
</style>