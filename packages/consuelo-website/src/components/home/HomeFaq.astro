---
import { homeFaqItems } from '../../data/home-content';
---

<section class="home-faq" id="faq" aria-labelledby="home-faq-title" data-section="faq">
  <h2 id="home-faq-title">FAQ</h2>
  <div class="home-faq__list">
    {
      homeFaqItems.map((item) => (
        <details>
          <summary>
            <span>{item.question}</span>
            <span class="home-faq__icon" aria-hidden="true">+</span>
          </summary>
          <p>
            {item.answer}
            {item.linkHref && item.linkLabel && (
              <> <a href={item.linkHref}>{item.linkLabel}</a>.</>
            )}
          </p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .home-faq {
    padding: clamp(6rem, 11vw, 10rem) clamp(1rem, 5vw, 5rem) clamp(7rem, 12vw, 11rem);
  }

  .home-faq h2 {
    margin: 0 0 clamp(1.5rem, 3vw, 3rem);
    color: var(--site-color-brand);
    font-family: var(--site-font-display);
    font-size: clamp(5rem, 12vw, 11rem);
    font-weight: 430;
    letter-spacing: 0;
    line-height: 0.72;
    text-align: center;
  }

  .home-faq__list {
    width: min(100%, 60rem);
    margin: 0 auto;
    border-top: 1px dashed var(--site-color-line-strong);
  }

  .home-faq details {
    border-bottom: 1px dashed var(--site-color-line-strong);
    padding-inline: 0.85rem;
    transition: background var(--site-motion-fast);
  }

  .home-faq details:hover,
  .home-faq details:focus-within,
  .home-faq details[open] {
    background: #f1f1f1;
  }

  .home-faq summary {
    display: flex;
    min-height: 4.6rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--site-color-brand);
    font-family: var(--site-font-display);
    font-size: clamp(1.2rem, 1.8vw, 1.7rem);
    line-height: 1.05;
    list-style: none;
  }

  .home-faq summary::-webkit-details-marker {
    display: none;
  }

  .home-faq__icon {
    flex: 0 0 auto;
    font-family: var(--site-font-body);
    font-size: 1.5rem;
    font-weight: 300;
    transition: transform var(--site-motion-medium);
  }

  .home-faq details[open] .home-faq__icon {
    transform: rotate(45deg);
  }

  .home-faq p {
    max-width: 43rem;
    margin: -0.3rem 0 1.5rem;
    color: var(--site-color-muted);
    font-size: 0.94rem;
    line-height: 1.7;
  }

  .home-faq p a {
    color: var(--site-color-brand);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  @media (max-width: 600px) {
    .home-faq h2 {
      font-size: clamp(4.25rem, 22vw, 6rem);
    }

    .home-faq summary {
      min-height: 3.8rem;
      font-size: 1.15rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-faq__icon {
      transition: none;
    }
  }
</style>
