---
import { homeFaqItems } from '../../data/home-content';
---

<section class="home-faq" id="faq" aria-labelledby="home-faq-title" data-section="faq">
  <h2 id="home-faq-title">FAQ</h2>
  <div class="home-faq__list" data-home-faq-list>
    {
      homeFaqItems.map((item) => (
        <details data-home-faq-item>
          <summary>
            <span>{item.question}</span>
            <span class="home-faq__icon" aria-hidden="true">+</span>
          </summary>
          <div class="home-faq__answer">
            {item.details ? (
              item.details.map((block) =>
                block.type === 'paragraph' ? (
                  <p>{block.text}</p>
                ) : block.type === 'list' ? (
                  <ul class="home-faq__bullets">
                    {block.items.map((entry) => <li>{entry}</li>)}
                  </ul>
                ) : (
                  <ol class="home-faq__steps">
                    {block.items.map((entry) => (
                      <li>
                        <strong>{entry.label}</strong>
                        <span>{entry.text}</span>
                      </li>
                    ))}
                  </ol>
                ),
              )
            ) : (
              <p>{item.answer}</p>
            )}
            {item.linkHref && item.linkLabel && (
              <a class="home-faq__link" href={item.linkHref}>{item.linkLabel} →</a>
            )}
          </div>
        </details>
      ))
    }
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-home-faq-list]').forEach((list) => {
    const items = Array.from(list.querySelectorAll<HTMLDetailsElement>('[data-home-faq-item]'));

    items.forEach((item) => {
      item.addEventListener('toggle', () => {
        if (!item.open) {
          return;
        }

        items.forEach((otherItem) => {
          if (otherItem !== item) {
            otherItem.open = false;
          }
        });
      });
    });
  });
</script>

<style>
  .home-faq {
    padding: clamp(7.5rem, 12vw, 11rem) clamp(1rem, 5vw, 5rem) clamp(7rem, 12vw, 11rem);
  }

  .home-faq h2 {
    margin: 0 0 clamp(2.75rem, 4.5vw, 4.5rem);
    color: var(--site-color-brand);
    font-family: var(--site-font-display);
    font-size: clamp(5rem, 12vw, 11rem);
    font-weight: 430;
    letter-spacing: 0;
    line-height: 0.72;
    text-align: center;
  }

  .home-faq__list {
    width: min(100%, 60rem);
    margin: 0 auto;
    border-top: 1px dashed var(--site-color-line-strong);
  }

  .home-faq details {
    border-bottom: 1px dashed var(--site-color-line-strong);
    padding-inline: 0.85rem;
    transition: background var(--site-motion-fast);
  }

  .home-faq details:hover,
  .home-faq details:focus-within,
  .home-faq details[open] {
    background: var(--site-color-soft-white);
  }

  .home-faq summary {
    display: flex;
    min-height: 4.1rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--site-color-brand);
    cursor: pointer;
    font-family: var(--site-font-display);
    font-size: clamp(1.2rem, 1.8vw, 1.7rem);
    font-weight: 400;
    line-height: 1.05;
    list-style: none;
  }

  .home-faq summary::-webkit-details-marker {
    display: none;
  }

  .home-faq__icon {
    flex: 0 0 auto;
    font-family: var(--site-font-body);
    font-size: 1.8rem;
    font-weight: 700;
    transition: transform var(--site-motion-medium);
  }

  .home-faq details[open] .home-faq__icon {
    transform: rotate(45deg);
  }

  .home-faq__answer {
    display: grid;
    max-width: 48rem;
    gap: 0.9rem;
    margin: -0.15rem 0 1.75rem;
    color: var(--site-color-muted);
    font-size: 0.94rem;
    line-height: 1.65;
  }

  .home-faq__answer p {
    max-width: 44rem;
    margin: 0;
  }

  .home-faq__bullets,
  .home-faq__steps {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-faq__bullets li,
  .home-faq__steps li {
    position: relative;
    padding-left: 1.35rem;
  }

  .home-faq__bullets li::before {
    position: absolute;
    top: 0.62em;
    left: 0.18rem;
    width: 0.32rem;
    height: 0.32rem;
    background: var(--site-color-brand);
    content: '';
  }

  .home-faq__steps {
    counter-reset: faq-step;
  }

  .home-faq__steps li {
    display: grid;
    grid-template-columns: minmax(7rem, 0.32fr) 1fr;
    gap: 0.8rem;
    border-top: 1px solid var(--site-color-line);
    padding: 0.7rem 0 0;
    counter-increment: faq-step;
  }

  .home-faq__steps li:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .home-faq__steps strong {
    color: var(--site-color-brand);
    font: 650 0.72rem/1.35 var(--site-font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .home-faq__steps strong::before {
    content: counter(faq-step, decimal-leading-zero) ' ';
    opacity: 0.45;
  }

  .home-faq__link {
    width: fit-content;
    color: var(--site-color-brand);
    font: 650 0.72rem/1 var(--site-font-mono);
    letter-spacing: 0.08em;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-transform: uppercase;
  }

  @media (max-width: 600px) {
    .home-faq h2 {
      font-size: clamp(4.25rem, 22vw, 6rem);
    }

    .home-faq summary {
      min-height: 3.55rem;
      font-size: 1.15rem;
    }

    .home-faq__answer {
      font-size: 0.84rem;
      line-height: 1.6;
    }

    .home-faq__steps li {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-faq details,
    .home-faq__icon {
      transition: none;
    }
  }
</style>
