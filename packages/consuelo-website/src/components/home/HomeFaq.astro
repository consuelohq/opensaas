---
import { homeFaqItems } from '../../data/home-content';
---

<section class="home-faq" id="faq" aria-labelledby="home-faq-title" data-section="faq">
  <h2 id="home-faq-title">FAQ</h2>
  <div class="home-faq__list">
    {
      homeFaqItems.map((item) => (
        <details>
          <summary>
            <span>{item.question}</span>
            <span class="home-faq__icon" aria-hidden="true">+</span>
          </summary>
          <p>{item.answer}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .home-faq {
    padding: clamp(4rem, 9vw, 8rem) var(--site-panel-pad) clamp(5rem, 10vw, 9rem);
  }

  .home-faq h2 {
    margin: 0 0 clamp(1.5rem, 3vw, 3rem);
    color: var(--site-color-brand);
    font-family: var(--site-font-display);
    font-size: clamp(6rem, 16vw, 15rem);
    font-weight: 430;
    letter-spacing: 0;
    line-height: 0.72;
  }

  .home-faq__list {
    width: min(100%, 54rem);
    margin: 0 auto;
  }

  .home-faq details {
    border-bottom: 1px solid var(--site-color-line-strong);
  }

  .home-faq summary {
    display: flex;
    min-height: 4.6rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--site-color-brand);
    font-family: var(--site-font-display);
    font-size: clamp(1.45rem, 2.45vw, 2.25rem);
    line-height: 1.05;
    list-style: none;
  }

  .home-faq summary::-webkit-details-marker {
    display: none;
  }

  .home-faq__icon {
    flex: 0 0 auto;
    font-family: var(--site-font-body);
    font-size: 1.5rem;
    font-weight: 300;
    transition: transform var(--site-motion-medium);
  }

  .home-faq details[open] .home-faq__icon {
    transform: rotate(45deg);
  }

  .home-faq p {
    max-width: 43rem;
    margin: -0.3rem 0 1.5rem;
    color: #25256f;
    font-size: 0.94rem;
    line-height: 1.7;
  }

  @media (max-width: 600px) {
    .home-faq h2 {
      font-size: clamp(5.25rem, 28vw, 8rem);
    }

    .home-faq summary {
      min-height: 4.1rem;
      font-size: 1.35rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-faq__icon {
      transition: none;
    }
  }
</style>
