---
import { homeFeaturePreviewItems } from '../../data/home-content';
import FeatureArtwork from './FeatureArtwork.astro';

type Props = {
  sectionId?: string;
};

const { sectionId = 'features' } = Astro.props as Props;
---

<section
  id={sectionId}
  class="feature-preview"
  aria-labelledby="feature-preview-heading"
  data-testid="home-feature-preview"
>
  <div class="feature-preview__shell">
    <div class="feature-preview__panel">
      <div class="feature-preview__layout">
        <aside class="feature-preview__rail" aria-hidden="true">
          <div class="feature-preview__badge-rail">
            <div class="feature-preview__badge" aria-hidden="true">
              <span class="feature-preview__badge-mark">C</span>
            </div>
          </div>
        </aside>

        <div class="feature-preview__body">
          <header class="feature-preview__header">
            <p class="feature-preview__tabs" aria-hidden="true">
              <span class="feature-preview__tab feature-preview__tab--active">FEATURE</span>
              <span class="feature-preview__tab">PREVIEW</span>
            </p>
            <h2 id="feature-preview-heading" class="sr-only">Consuelo OS feature preview</h2>
          </header>

          <div class="feature-preview__grid">
            {
              homeFeaturePreviewItems.map((item) => (
                <article class="feature-preview__item">
                  <p class="feature-preview__index">
                    #{item.number} {item.label}
                  </p>
                  <h3 class="feature-preview__title">
                    {item.title.split('\n').map((line, lineIndex) => (
                      <>
                        {lineIndex > 0 ? <br /> : null}
                        {line}
                      </>
                    ))}
                  </h3>
                  <div class="feature-preview__artwork">
                    <FeatureArtwork motif={item.motif} alt={item.imageAlt} />
                  </div>
                  <p class="feature-preview__description">{item.body}</p>
                </article>
              ))
            }
          </div>
        </div>
      </div>

      <div class="feature-preview__wordmark-wrap" aria-hidden="true">
        <p class="feature-preview__wordmark">CONSUELO</p>
      </div>
    </div>
  </div>
</section>

<style>
  .feature-preview {
    --feature-paper: #f2ebe1;
    --feature-panel: #faf6ef;
    --feature-ink: #1a1512;
    --feature-muted: #6b5f54;
    --feature-frame: clamp(1.25rem, 3.5vw, 2.75rem);
    --feature-panel-pad: clamp(1.25rem, 2.8vw, 2.25rem);
    --feature-rail: clamp(4.75rem, 7.5vw, 6.25rem);
    --feature-art-bg: #ebe4d8;
    --feature-art-ink: #3d342c;
    --feature-art-brown: #8b7355;
    --feature-art-amber: #c9a227;
    --feature-art-stone: #d4cdc3;

    position: relative;
    padding: var(--feature-frame);
    background-color: var(--feature-paper);
    color: var(--feature-ink);
  }

  .feature-preview__shell {
    max-width: 92rem;
    margin-inline: auto;
  }

  .feature-preview__panel {
    display: flex;
    flex-direction: column;
    background: var(--feature-panel);
    padding:
      var(--feature-panel-pad)
      var(--feature-panel-pad)
      0;
    overflow: visible;
  }

  .feature-preview__layout {
    display: grid;
    grid-template-columns: var(--feature-rail) minmax(0, 1fr);
    column-gap: clamp(0.5rem, 1.5vw, 1.25rem);
  }

  /* Sticky rail: paper-colored top cap pins with the badge on scroll */
  .feature-preview__rail {
    position: relative;
    z-index: 5;
  }

  .feature-preview__badge-rail {
    position: sticky;
    top: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-top: calc(var(--feature-frame) + 0.75rem);
    margin-top: calc(-1 * var(--feature-panel-pad));
    margin-left: calc(-1 * var(--feature-panel-pad));
    padding-left: calc(var(--feature-panel-pad) + 0.35rem);
    padding-right: 0.85rem;
    padding-bottom: 1.75rem;
    background: linear-gradient(
      to bottom,
      var(--feature-paper) 0,
      var(--feature-paper) calc(var(--feature-frame) + 0.75rem),
      var(--feature-panel) calc(var(--feature-frame) + 0.75rem),
      var(--feature-panel) 100%
    );
  }

  .feature-preview__badge {
    display: grid;
    place-items: center;
    width: clamp(2.85rem, 4.2vw, 3.35rem);
    height: clamp(2.85rem, 4.2vw, 3.35rem);
    border: 1.5px solid var(--feature-ink);
    background: var(--feature-panel);
    flex-shrink: 0;
  }

  .feature-preview__badge-mark {
    font-family: var(--font-display, Georgia, 'Times New Roman', serif);
    font-size: clamp(1.35rem, 2vw, 1.65rem);
    font-weight: 500;
    line-height: 1;
    color: var(--feature-ink);
  }

  .feature-preview__body {
    min-width: 0;
    padding-top: 0.15rem;
  }

  .feature-preview__header {
    margin-bottom: clamp(1.25rem, 2.5vw, 2rem);
  }

  .feature-preview__tabs {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--feature-muted);
  }

  .feature-preview__tab--active {
    color: var(--feature-ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .feature-preview__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: clamp(0.65rem, 1.4vw, 1.1rem);
    row-gap: clamp(2rem, 4vw, 3.25rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  .feature-preview__item {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    min-width: 0;
  }

  .feature-preview__index {
    margin: 0;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--feature-muted);
  }

  .feature-preview__title {
    margin: 0;
    font-family: var(--font-display, Georgia, 'Times New Roman', serif);
    font-size: clamp(1.35rem, 2.1vw, 1.85rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.01em;
    color: var(--feature-ink);
    min-height: 2.2em;
  }

  .feature-preview__artwork {
    width: 100%;
    max-width: clamp(7.5rem, 13vw, 10rem);
    margin-inline: auto;
  }

  .feature-preview__description {
    margin: 0;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--feature-ink);
  }

  .feature-preview__wordmark-wrap {
    margin-inline: calc(-1 * var(--feature-panel-pad));
    margin-top: auto;
    padding-top: clamp(0.5rem, 1.5vw, 1rem);
    padding-bottom: clamp(0.35rem, 1vw, 0.65rem);
    container-type: inline-size;
  }

  .feature-preview__wordmark {
    margin: 0;
    font-family: var(--font-display, Georgia, 'Times New Roman', serif);
    font-size: clamp(3rem, 17cqi, 9.5rem);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    color: var(--feature-ink);
    white-space: nowrap;
    width: 100%;
    overflow: visible;
    text-align: left;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 960px) {
    .feature-preview__layout {
      grid-template-columns: 1fr;
    }

    .feature-preview__rail {
      display: none;
    }

    .feature-preview__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .feature-preview__grid {
      grid-template-columns: 1fr;
    }

    .feature-preview__wordmark {
      font-size: clamp(3.25rem, 22vw, 5.5rem);
      white-space: normal;
    }
  }
</style>