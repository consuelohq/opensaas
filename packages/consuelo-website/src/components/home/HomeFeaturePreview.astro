---
import { homeFeaturePreviewItems } from '../../data/home-content';
import FeatureArtwork from './FeatureArtwork.astro';

type Props = {
  sectionId?: string;
};

const { sectionId = 'features' } = Astro.props as Props;
---

<section
  id={sectionId}
  class="feature-preview"
  aria-labelledby="feature-preview-heading"
  data-testid="home-feature-preview"
>
  <div class="feature-preview__panel">
    <div class="feature-preview__masthead">
      <div class="feature-preview__pin-corner" aria-hidden="true">
        <div class="feature-preview__badge">
          <span class="feature-preview__badge-mark">C</span>
        </div>
      </div>

      <header class="feature-preview__header">
        <p class="feature-preview__tabs" aria-hidden="true">
          <span class="feature-preview__tab feature-preview__tab--active">FEATURE</span>
          <span class="feature-preview__tab">PREVIEW</span>
        </p>
        <h2 id="feature-preview-heading" class="sr-only">Consuelo OS feature preview</h2>
      </header>
    </div>

    <div class="feature-preview__grid">
      {
        homeFeaturePreviewItems.map((item) => (
          <article class="feature-preview__item">
            <p class="feature-preview__index">
              #{item.number} {item.label}
            </p>
            <h3 class="feature-preview__title">
              {item.title.split('\n').map((line, lineIndex) => (
                <>
                  {lineIndex > 0 ? <br /> : null}
                  {line}
                </>
              ))}
            </h3>
            <div class="feature-preview__artwork">
              <FeatureArtwork motif={item.motif} alt={item.imageAlt} />
            </div>
            <p class="feature-preview__description">{item.body}</p>
          </article>
        ))
      }
    </div>

    <div class="feature-preview__wordmark-wrap" aria-hidden="true">
      <p class="feature-preview__wordmark">CONSUELO</p>
    </div>
  </div>
</section>

<style>
  .feature-preview {
    padding: var(--site-frame-inset);
    background: var(--site-color-paper);
    color: var(--site-color-ink);
  }

  .feature-preview__panel {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--site-color-surface);
    padding:
      var(--site-panel-pad)
      var(--site-panel-pad)
      0;
    overflow: visible;
  }

  .feature-preview__masthead {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    column-gap: 1rem;
    margin-bottom: clamp(1.25rem, 2.5vw, 2rem);
  }

  /* Top-left only: subtle blue sliver + badge pins on scroll */
  .feature-preview__pin-corner {
    position: sticky;
    top: 0;
    z-index: 10;
    align-self: start;
    width: fit-content;
    margin-top: calc(-1 * var(--site-panel-pad));
    margin-left: calc(-1 * var(--site-panel-pad));
    padding:
      var(--site-sticky-sliver)
      0.85rem
      0.65rem
      var(--site-panel-pad);
    background: linear-gradient(
      to bottom,
      var(--site-color-paper) 0,
      var(--site-color-paper) var(--site-sticky-sliver),
      var(--site-color-surface) var(--site-sticky-sliver),
      var(--site-color-surface) 100%
    );
  }

  .feature-preview__badge {
    display: grid;
    place-items: center;
    width: clamp(2.85rem, 4.2vw, 3.35rem);
    height: clamp(2.85rem, 4.2vw, 3.35rem);
    border: 1.5px solid var(--site-color-ink);
    background: var(--site-color-surface);
    flex-shrink: 0;
  }

  .feature-preview__badge-mark {
    font-family: var(--site-font-display);
    font-size: clamp(1.35rem, 2vw, 1.65rem);
    font-weight: 500;
    line-height: 1;
    color: var(--site-color-ink);
  }

  .feature-preview__header {
    display: flex;
    justify-content: flex-end;
    align-items: flex-start;
    margin: 0;
    padding-top: 0.1rem;
  }

  .feature-preview__tabs {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    font-family: var(--site-font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--site-color-muted);
  }

  .feature-preview__tab--active {
    color: var(--site-color-ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .feature-preview__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: clamp(0.85rem, 1.8vw, 1.5rem);
    row-gap: clamp(2rem, 4vw, 3.25rem);
    padding-bottom: clamp(1.25rem, 2.5vw, 2rem);
  }

  .feature-preview__item {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    min-width: 0;
  }

  .feature-preview__index {
    margin: 0;
    font-family: var(--site-font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--site-color-muted);
  }

  .feature-preview__title {
    margin: 0;
    font-family: var(--site-font-display);
    font-size: clamp(1.35rem, 2.1vw, 1.85rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.01em;
    color: var(--site-color-ink);
    min-height: 2.2em;
  }

  .feature-preview__artwork {
    width: 100%;
  }

  .feature-preview__description {
    margin: 0;
    max-width: 24ch;
    font-family: var(--site-font-mono);
    font-size: clamp(0.7rem, 0.82vw, 0.78rem);
    font-weight: 600;
    line-height: 1.72;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--site-color-ink);
  }

  .feature-preview__wordmark-wrap {
    margin-inline: calc(-1 * var(--site-panel-pad));
    margin-top: auto;
    padding-top: clamp(0.1rem, 0.5vw, 0.35rem);
    padding-bottom: 0;
    overflow: visible;
  }

  .feature-preview__wordmark {
    margin: 0;
    padding: 0;
    font-family: var(--site-font-display);
    font-size: clamp(5.5rem, 20.5vw, 18rem);
    font-weight: 400;
    line-height: 0.66;
    letter-spacing: -0.07em;
    text-transform: uppercase;
    color: var(--site-color-ink);
    white-space: nowrap;
    width: 100%;
    overflow: visible;
    display: block;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 960px) {
    .feature-preview__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .feature-preview__description {
      max-width: none;
    }
  }

  @media (max-width: 640px) {
    .feature-preview__grid {
      grid-template-columns: 1fr;
    }

    .feature-preview__wordmark {
      font-size: clamp(3.25rem, 22vw, 6rem);
      white-space: normal;
    }
  }
</style>