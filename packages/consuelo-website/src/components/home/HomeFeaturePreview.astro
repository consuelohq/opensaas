---
import FeatureArtwork from './FeatureArtwork.astro';
import { homeFeaturePreviewItems } from '../../data/home-content';

type Props = {
  sectionId?: string;
};

const { sectionId = 'features' } = Astro.props as Props;
---

<section
  class="feature-preview"
  id={sectionId}
  data-section="features"
  data-feature-preview
  aria-labelledby="feature-preview-heading"
>
  <div class="feature-preview__shell">
    <div class="feature-preview__panel">
      <a class="feature-preview__badge" data-feature-badge href="/" aria-label="Consuelo home">
        <img src="/logo.svg" alt="" width="48" height="48" decoding="async" />
      </a>

      <header class="feature-preview__header">
        <div class="feature-preview__tabs" aria-hidden="true">
          <span class="feature-preview__tab">FEATURE</span>
          <span class="feature-preview__tab feature-preview__tab--active">PREVIEW</span>
        </div>
        <h2 id="feature-preview-heading" class="visually-hidden">Consuelo OS features</h2>
      </header>

      <div class="feature-preview__grid">
        {
          homeFeaturePreviewItems.map((feature) => (
            <article class="feature-preview__item">
              <p class="feature-preview__label">
                #{feature.number} {feature.label}
              </p>
              <h3
                class="feature-preview__title"
                data-pretext-title={feature.title}
                data-pretext-lines="2"
                aria-label={feature.title.replace('\n', ' ')}
              >
                {
                  feature.title.split('\n').map((line) => (
                    <span class="feature-preview__title-line" aria-hidden="true">
                      {line}
                    </span>
                  ))
                }
              </h3>
              <FeatureArtwork motif={feature.motif} alt={feature.imageAlt} />
              <p class="feature-preview__body">{feature.body}</p>
            </article>
          ))
        }
      </div>

      <div class="feature-preview__wordmark-wrap" data-feature-wordmark>
        <p class="feature-preview__wordmark" aria-hidden="true">CONSUELO</p>
      </div>
    </div>
  </div>
</section>

<script>
  import { prepare, layout } from '@chenglou/pretext';
  import type { PreparedText } from '@chenglou/pretext';

  const titles = Array.from(document.querySelectorAll<HTMLElement>('[data-pretext-title]'));

  titles.forEach((title) => {
    let prepared: PreparedText | undefined;
    let preparedFont = '';

    const measureTitle = () => {
      const style = window.getComputedStyle(title);
      const font = `${style.fontStyle} ${style.fontWeight} ${style.fontSize} ${style.fontFamily}`;
      const text = title.dataset.pretextTitle ?? title.textContent ?? '';

      if (!prepared || preparedFont !== font) {
        prepared = prepare(text, font, { whiteSpace: 'pre-wrap' });
        preparedFont = font;
      }

      const lineHeight = Number.parseFloat(style.lineHeight) || Number.parseFloat(style.fontSize);
      const result = layout(prepared, title.clientWidth, lineHeight);

      title.dataset.pretextLines = String(result.lineCount);
      title.style.setProperty('--feature-title-height', `${result.height}px`);
    };

    const scheduleMeasure = () => window.requestAnimationFrame(measureTitle);

    window.addEventListener('resize', scheduleMeasure, { passive: true });
    document.fonts?.ready.then(scheduleMeasure).catch(() => measureTitle());
    scheduleMeasure();
  });
</script>

<style>
  .feature-preview {
    --feature-frame: clamp(0.85rem, 1.8vw, 1.35rem);
    --feature-art-bg: #f0e9df;
    --feature-art-stone: #e4dbd0;
    --feature-art-ink: #1a1410;
    --feature-art-brown: #3d2e24;
    --feature-art-amber: #c47a2e;
    --feature-panel-bg: #faf6ef;

    background: var(--site-color-paper);
    color: var(--feature-art-ink);
    padding: var(--feature-frame) clamp(1.35rem, 4.8vw, 3.75rem) clamp(1.5rem, 3vw, 2.5rem);
  }

  .feature-preview__shell {
    max-width: 92rem;
    margin-inline: auto;
  }

  .feature-preview__panel {
    position: relative;
    container-type: inline-size;
    background: var(--feature-panel-bg);
    padding: clamp(1.1rem, 2.2vw, 1.65rem) clamp(1.15rem, 2.6vw, 2rem)
      clamp(1.75rem, 3.5vw, 2.75rem);
  }

  .feature-preview__badge {
    position: sticky;
    top: calc(var(--feature-frame) + 0.5rem);
    z-index: 3;
    display: block;
    width: fit-content;
    margin: 0 0 clamp(0.85rem, 1.6vw, 1.15rem);
    padding: 0.3rem;
    border: 1px solid rgba(26, 20, 16, 0.12);
    background: var(--feature-panel-bg);
    line-height: 0;
  }

  .feature-preview__badge img {
    display: block;
    width: clamp(2.15rem, 3.8vw, 2.65rem);
    height: clamp(2.15rem, 3.8vw, 2.65rem);
  }

  .feature-preview__header {
    display: flex;
    justify-content: flex-end;
    margin: 0 0 clamp(1.15rem, 2.2vw, 1.65rem);
  }

  .feature-preview__tabs {
    display: flex;
    gap: 0.4rem;
  }

  .feature-preview__tab {
    border: 1px solid rgba(26, 20, 16, 0.2);
    border-radius: 2px;
    color: rgba(26, 20, 16, 0.5);
    font: 500 0.52rem / 1 var(--site-font-mono);
    letter-spacing: 0.1em;
    padding: 0.34rem 0.58rem;
    text-transform: uppercase;
  }

  .feature-preview__tab--active {
    border-color: var(--feature-art-ink);
    color: var(--feature-art-ink);
  }

  .feature-preview__grid {
    display: grid;
    gap: clamp(2.25rem, 4vw, 3.25rem);
    width: 100%;
  }

  .feature-preview__item {
    display: grid;
    gap: clamp(0.45rem, 0.9vw, 0.62rem);
    align-content: start;
    min-width: 0;
  }

  .feature-preview__label {
    margin: 0;
    color: rgba(61, 46, 36, 0.58);
    font: 500 0.5rem / 1.15 var(--site-font-mono);
    letter-spacing: 0.13em;
    text-align: center;
    text-transform: uppercase;
  }

  .feature-preview__title {
    margin: 0;
    min-height: var(--feature-title-height, auto);
    color: var(--feature-art-ink);
    font-family: var(--site-font-display);
    font-size: clamp(1.65rem, 2.8vw, 2.35rem);
    font-weight: 300;
    letter-spacing: 0.01em;
    line-height: 0.88;
    text-align: center;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .feature-preview__title-line {
    display: block;
    white-space: nowrap;
  }

  .feature-preview__body {
    margin: 0;
    color: rgba(26, 20, 16, 0.9);
    font: 650 0.66rem / 1.45 var(--site-font-mono);
    letter-spacing: 0.045em;
    text-transform: uppercase;
  }

  .feature-preview__wordmark-wrap {
    margin-top: clamp(3.5rem, 7vw, 6.5rem);
    overflow: hidden;
  }

  .feature-preview__wordmark {
    margin: 0;
    width: 100%;
    color: var(--feature-art-ink);
    font-family: var(--site-font-display);
    font-size: clamp(4.8rem, 19cqi, 12.5rem);
    font-weight: 300;
    letter-spacing: -0.045em;
    line-height: 0.78;
    text-transform: uppercase;
    translate: 0 10%;
    user-select: none;
    white-space: nowrap;
  }

  .visually-hidden {
    border: 0;
    clip: rect(0 0 0 0);
    height: 1px;
    margin: -1px;
    overflow: hidden;
    padding: 0;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }

  @media (min-width: 900px) {
    .feature-preview__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: clamp(0.55rem, 1vw, 0.85rem);
      row-gap: clamp(2rem, 3.2vw, 2.75rem);
    }

    .feature-preview__label,
    .feature-preview__title {
      text-align: left;
    }
  }

  @media (max-width: 560px) {
    .feature-preview {
      padding-inline: clamp(1rem, 4.5vw, 1.35rem);
    }

    .feature-preview__title {
      font-size: clamp(1.55rem, 8.5vw, 2.05rem);
    }

    .feature-preview__title-line {
      white-space: normal;
    }

    .feature-preview__body {
      font-size: clamp(0.6rem, 2.6vw, 0.66rem);
    }
  }
</style>