---
import { homeFeaturePreviewItems } from '../../data/home-content';
import FeatureArtwork from './FeatureArtwork.astro';

type Props = {
  sectionId?: string;
};

const { sectionId = 'features' } = Astro.props as Props;
---

<section
  id={sectionId}
  class="feature-preview"
  aria-labelledby="feature-preview-heading"
  data-testid="home-feature-preview"
>
  <div class="feature-preview__panel">
    <div class="feature-preview__sticky-cap" aria-hidden="true">
      <div class="feature-preview__sticky-fill"></div>
      <div class="feature-preview__sticky-badge">
        <div class="feature-preview__badge">
          <span class="feature-preview__badge-mark">C</span>
        </div>
      </div>
    </div>

    <div class="feature-preview__inner">
      <div class="feature-preview__pin-gutter" aria-hidden="true"></div>

      <div class="feature-preview__content">
        <header class="feature-preview__header">
          <p class="feature-preview__tabs" aria-hidden="true">
            <span class="feature-preview__tab feature-preview__tab--active">FEATURE</span>
            <span class="feature-preview__tab">PREVIEW</span>
          </p>
          <h2 id="feature-preview-heading" class="sr-only">Consuelo OS feature preview</h2>
        </header>

        <div class="feature-preview__grid">
          {
            homeFeaturePreviewItems.map((item) => (
              <article class="feature-preview__item">
                <p class="feature-preview__index">
                  #{item.number} {item.label}
                </p>
                <h3 class="feature-preview__title">
                  {item.title.split('\n').map((line, lineIndex) => (
                    <>
                      {lineIndex > 0 ? <br /> : null}
                      {line}
                    </>
                  ))}
                </h3>
                <div class="feature-preview__artwork">
                  <FeatureArtwork
                    motif={item.motif}
                    alt={item.imageAlt}
                    assetSrc={item.assetSrc}
                  />
                </div>
                <p class="feature-preview__description">{item.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>

    <div class="feature-preview__wordmark-wrap" aria-hidden="true">
      <p class="feature-preview__wordmark">CONSUELO</p>
    </div>
  </div>
</section>

<style>
  .feature-preview {
    padding: var(--site-frame-inset);
    background: var(--site-color-paper);
    color: var(--site-color-ink);
  }

  .feature-preview__panel {
    --feature-pin-col: clamp(3.65rem, 5.25vw, 4.65rem);
    --feature-pin-body-h: clamp(3.35rem, 4.8vw, 3.85rem);
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--site-color-surface);
    overflow: visible;
  }

  /* Sticky cap: blue sliver left only, white fill spans full panel width */
  .feature-preview__sticky-cap {
    position: sticky;
    top: 0;
    z-index: 10;
    height: 0;
    overflow: visible;
    pointer-events: none;
  }

  .feature-preview__sticky-fill {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: calc(var(--site-sticky-sliver) + var(--feature-pin-body-h));
    background: var(--site-color-surface);
  }

  .feature-preview__sticky-fill::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: var(--feature-pin-col);
    height: var(--site-sticky-sliver);
    background: var(--site-color-paper);
  }

  .feature-preview__sticky-badge {
    position: absolute;
    top: var(--site-sticky-sliver);
    left: 0;
    width: var(--feature-pin-col);
    display: flex;
    justify-content: center;
    align-items: center;
    height: calc(var(--feature-pin-body-h) - var(--site-sticky-sliver));
    padding-bottom: 0.35rem;
    pointer-events: auto;
  }

  .feature-preview__badge {
    display: grid;
    place-items: center;
    width: clamp(2.85rem, 4.2vw, 3.35rem);
    height: clamp(2.85rem, 4.2vw, 3.35rem);
    border: 1.5px solid var(--site-color-ink);
    background: var(--site-color-surface);
  }

  .feature-preview__badge-mark {
    font-family: var(--site-font-display);
    font-size: clamp(1.35rem, 2vw, 1.65rem);
    font-weight: 500;
    line-height: 1;
    color: var(--site-color-ink);
  }

  .feature-preview__inner {
    display: grid;
    grid-template-columns: var(--feature-pin-col) minmax(0, 1fr);
    align-items: start;
  }

  /* Alignment gutter only — stops at header height, not full panel */
  .feature-preview__pin-gutter {
    height: calc(var(--feature-pin-body-h) + var(--site-panel-pad) * 0.15);
  }

  .feature-preview__content {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding:
      var(--site-panel-pad)
      var(--site-panel-pad)
      0
      0;
  }

  .feature-preview__header {
    display: flex;
    justify-content: flex-end;
    align-items: flex-start;
    margin: 0 0 clamp(1.25rem, 2.5vw, 2rem);
    padding-top: 0.1rem;
  }

  .feature-preview__tabs {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    font-family: var(--site-font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--site-color-muted);
  }

  .feature-preview__tab--active {
    color: var(--site-color-ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .feature-preview__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: clamp(0.85rem, 1.8vw, 1.5rem);
    row-gap: clamp(2rem, 4vw, 3.25rem);
    padding-bottom: clamp(1.25rem, 2.5vw, 2rem);
  }

  .feature-preview__item {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    min-width: 0;
  }

  .feature-preview__index {
    margin: 0;
    font-family: var(--site-font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--site-color-muted);
  }

  .feature-preview__title {
    margin: 0;
    font-family: var(--site-font-display);
    font-size: clamp(1.35rem, 2.1vw, 1.85rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.01em;
    color: var(--site-color-ink);
    min-height: 2.2em;
  }

  .feature-preview__artwork {
    width: 100%;
  }

  .feature-preview__description {
    margin: 0;
    max-width: 34ch;
    font-family: var(--site-font-mono);
    font-size: clamp(0.7rem, 0.82vw, 0.78rem);
    font-weight: 600;
    line-height: 1.62;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--site-color-ink);
  }

  .feature-preview__wordmark-wrap {
    margin-top: auto;
    padding:
      clamp(0.1rem, 0.5vw, 0.35rem)
      var(--site-panel-pad)
      0;
    overflow: visible;
  }

  .feature-preview__wordmark {
    margin: 0;
    padding: 0;
    font-family: var(--site-font-display);
    font-size: clamp(5.5rem, 20.5vw, 18rem);
    font-weight: 400;
    line-height: 0.66;
    letter-spacing: -0.07em;
    text-transform: uppercase;
    color: var(--site-color-ink);
    white-space: nowrap;
    width: calc(100% + 2 * var(--site-panel-pad));
    margin-inline: calc(-1 * var(--site-panel-pad));
    overflow: visible;
    display: block;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 960px) {
    .feature-preview__inner {
      grid-template-columns: 1fr;
    }

    .feature-preview__pin-gutter,
    .feature-preview__sticky-cap {
      display: none;
    }

    .feature-preview__content {
      padding-left: var(--site-panel-pad);
    }

    .feature-preview__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .feature-preview__description {
      max-width: none;
    }
  }

  @media (max-width: 640px) {
    .feature-preview__grid {
      grid-template-columns: 1fr;
    }

    .feature-preview__wordmark {
      font-size: clamp(3.25rem, 22vw, 6rem);
      white-space: normal;
    }
  }
</style>