---
import type { HomeFeatureEvidence } from '../../data/home-content';

type Props = {
  imageSrc: string;
  imageAlt: string;
  evidence: HomeFeatureEvidence;
};

const { imageSrc, imageAlt, evidence } = Astro.props as Props;
const posterSrc = evidence.posterSrc ?? imageSrc;
---

<figure class="feature-evidence" data-evidence-figure={evidence.figureNumber}>
  <div class="feature-evidence__stage">
    <img
      class="feature-evidence__poster"
      src={posterSrc}
      alt={imageAlt}
      width="2032"
      height="1192"
      loading="lazy"
      decoding="async"
    />
    {
      evidence.videoSrc && (
        <video
          autoplay
          muted
          loop
          playsinline
          class="feature-evidence__video"
          preload="metadata"
          poster={posterSrc}
        >
          <source src={evidence.videoSrc} />
        </video>
      )
    }
  </div>

  <figcaption class="feature-evidence__caption">
    <div class="feature-evidence__meta">
      <span>FIG. {evidence.figureNumber}</span>
      <span>{evidence.meta}</span>
    </div>

    <ol class="feature-evidence__sequence" aria-label="Agent sequence">
      {
        evidence.sequence.map((agent, index) => (
          <li data-agent={agent.label}>
            <span class="feature-evidence__sequence-number">{String(index + 1).padStart(2, '0')}</span>
            <span>{agent.label}</span>
          </li>
        ))
      }
    </ol>

    <p>{evidence.caption}</p>
  </figcaption>
</figure>

<style>
  .feature-evidence {
    margin: 0;
    border-block: 1px solid var(--site-color-brand);
    color: var(--site-color-brand);
  }

  .feature-evidence__stage {
    position: relative;
    width: 100%;
    aspect-ratio: 2032 / 1192;
    overflow: hidden;
    background: white;
  }

  .feature-evidence__poster,
  .feature-evidence__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .feature-evidence__video {
    position: absolute;
    inset: 0;
  }

  .feature-evidence__caption {
    display: grid;
    gap: 0.8rem;
    padding: 0.72rem 0 0.8rem;
  }

  .feature-evidence__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    font: 650 0.54rem/1.2 var(--site-font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .feature-evidence__meta span:last-child {
    color: var(--site-color-art-muted);
    text-align: right;
  }

  .feature-evidence__sequence {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    border-block: 1px solid currentColor;
    list-style: none;
  }

  .feature-evidence__sequence li {
    position: relative;
    display: grid;
    gap: 0.2rem;
    min-width: 0;
    padding: 0.55rem 0.38rem 0.52rem 0;
    font: 650 clamp(0.48rem, 0.7vw, 0.58rem)/1 var(--site-font-mono);
    letter-spacing: 0.035em;
  }

  .feature-evidence__sequence li:not(:last-child)::after {
    position: absolute;
    top: 50%;
    right: 0.25rem;
    content: '→';
    font-size: 0.62rem;
    line-height: 1;
    transform: translateY(-50%);
  }

  .feature-evidence__sequence-number {
    color: var(--site-color-art-muted);
    font-size: 0.48rem;
    letter-spacing: 0.08em;
  }

  .feature-evidence__caption > p {
    margin: 0;
    font: 620 0.55rem/1.45 var(--site-font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 580px) {
    .feature-evidence__meta {
      font-size: 0.5rem;
    }

    .feature-evidence__sequence li {
      font-size: 0.52rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-evidence__video {
      display: none;
    }
  }
</style>
