---
type Props = {
  imageSrc: string;
  imageAlt: string;
  videoSrc?: string;
  posterSrc?: string;
};

const { imageSrc, imageAlt, videoSrc, posterSrc } = Astro.props as Props;
---

<div class="feature-media">
  {
    videoSrc ? (
      <>
        <img
          class="feature-media__poster"
          src={posterSrc ?? imageSrc}
          alt={imageAlt}
          width="1200"
          height="900"
          loading="lazy"
          decoding="async"
        />
        <video autoplay muted loop playsinline class="feature-media__video" preload="metadata" poster={posterSrc ?? imageSrc}>
          <source src={videoSrc} />
        </video>
      </>
    ) : (
      <img src={imageSrc} alt={imageAlt} width="1200" height="900" loading="lazy" decoding="async" />
    )
  }
</div>

<style>
  .feature-media {
    position: relative;
    width: 100%;
    aspect-ratio: 475 / 178;
    overflow: hidden;
    background: var(--site-color-brand);
  }

  .feature-media img,
  .feature-media video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .feature-media__poster,
  .feature-media__video {
    position: absolute;
    inset: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-media__video {
      display: none;
    }
  }
</style>
