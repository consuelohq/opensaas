---
import { homeTabs } from '../../data/home-content'

type Props = {
	sectionId?: string
}

const { sectionId } = Astro.props as Props
const osPortalHref = 'https://os.consuelohq.com'
const heroTitleText = 'YOUR WORKSPACE,\nCONNECTED TO\nEVERY AGENT.'
---

<section class="home-hero site-section" id={sectionId} data-section="hero">
	<div class="home-hero__inner site-container">
		<div class="home-hero__content">
			<p class="home-hero__eyebrow site-eyebrow" aria-label="Open source and MIT licensed">
				<span>OPEN SOURCE</span>
				<span class="home-hero__eyebrow-dot" aria-hidden="true">•</span>
				<span>MIT LICENSE</span>
			</p>

			<h1
				class="home-hero__title"
				data-pretext-title={heroTitleText}
				aria-label="YOUR WORKSPACE, CONNECTED TO EVERY AGENT."
			></h1>

			<div class="home-hero__actions" aria-label="Consuelo OS Cloud">
				<p class="home-hero__action-label site-eyebrow">consuelo os cloud</p>
				<a class="home-hero__portal site-button site-button--secondary" href={osPortalHref}>
					<span>deploy now</span>
					<svg class="home-hero__portal-arrow" viewBox="0 0 24 24" aria-hidden="true">
						<path d="M5 12h14M13 6l6 6-6 6" />
					</svg>
				</a>
			</div>

			<div class="home-hero__install-wrap" id="install">
				<p class="home-hero__install-label site-eyebrow">INSTALL VIA TERMINAL</p>
				<div class="home-hero__install site-card" data-hero-install>
					<div
						class="home-hero__tabs"
						role="tablist"
						aria-label="Consuelo install and workspace surfaces"
					>
						{
							homeTabs.map((tab, index) => (
								<button
									class:list={['home-hero__tab', { 'is-active': index === 0 }]}
									type="button"
									role="tab"
									aria-selected={index === 0 ? 'true' : 'false'}
									data-tab-button={tab.id}
								>
									{tab.label}
								</button>
							))
						}
					</div>

					<div class="home-hero__panels">
						{
							homeTabs.map((tab, index) =>
								tab.kind === 'link' && tab.href ? (
									<a
										href={tab.href}
										class:list={['home-hero__panel', { 'is-active': index === 0 }]}
										data-tab-panel={tab.id}
									>
										<span class="home-hero__value">{tab.value}</span>
										<span class="home-hero__panel-action" aria-hidden="true">
											→
										</span>
									</a>
								) : (
									<button
										type="button"
										class:list={['home-hero__panel', { 'is-active': index === 0 }]}
										data-tab-panel={tab.id}
										data-copy-button={tab.id}
									>
										<code class="home-hero__value">{tab.value}</code>
										<span class="home-hero__panel-action" aria-hidden="true">
											<svg class="home-hero__copy-icon" viewBox="0 0 24 24" aria-hidden="true">
												<rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
												<path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
											</svg>
											<svg class="home-hero__check-icon" viewBox="0 0 24 24" aria-hidden="true">
												<polyline points="20 6 9 17 4 12" />
											</svg>
										</span>
									</button>
								)
							)
						}
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<script define:vars={{ homeTabs }}>
	const root = document.querySelector('[data-hero-install]')

	if (root instanceof HTMLElement) {
		const buttons = Array.from(root.querySelectorAll('[data-tab-button]'))
		const panels = Array.from(root.querySelectorAll('[data-tab-panel]'))
		const copyButtons = Array.from(root.querySelectorAll('[data-copy-button]'))

		const sync = (nextIndex) => {
			buttons.forEach((button, index) => {
				const isActive = index === nextIndex
				button.classList.toggle('is-active', isActive)
				button.setAttribute('aria-selected', isActive ? 'true' : 'false')
			})
			panels.forEach((panel, index) => panel.classList.toggle('is-active', index === nextIndex))
		}

		buttons.forEach((button, index) => {
			button.addEventListener('click', () => sync(index))
		})

		copyButtons.forEach((button) => {
			button.addEventListener('click', async () => {
				const tabId = button.getAttribute('data-copy-button')
				const entry = homeTabs.find((tab) => tab.id === tabId)

				if (!entry || !navigator.clipboard) {
					return
				}

				await navigator.clipboard.writeText(entry.value)
				button.classList.add('is-copied')
				window.setTimeout(() => button.classList.remove('is-copied'), 1400)
			})
		})

		sync(0)
	}
</script>

<script>
	import { layoutWithLines, prepareWithSegments } from '@chenglou/pretext'

	const title = document.querySelector('[data-pretext-title]')

	if (title instanceof HTMLElement) {
		const renderTitle = () => {
			const style = window.getComputedStyle(title)
			const font = `${style.fontStyle} ${style.fontWeight} ${style.fontSize} ${style.fontFamily}`
			const text = title.dataset.pretextTitle ?? ''
			const logicalLines = text.split('\n').filter((line) => line.length > 0)
			const lineHeight = Number.parseFloat(style.lineHeight) || Number.parseFloat(style.fontSize)
			const lineWidth = title.clientWidth

			title.replaceChildren()

			let totalHeight = 0
			for (const lineText of logicalLines) {
				const prepared = prepareWithSegments(lineText, font)
				const result = layoutWithLines(prepared, lineWidth, lineHeight)
				const lineElement = document.createElement('span')
				lineElement.className = 'home-hero__title-line'
				lineElement.setAttribute('aria-hidden', 'true')
				lineElement.textContent = result.lines[0]?.text ?? lineText
				title.append(lineElement)
				totalHeight += result.height
			}

			title.dataset.pretextLines = String(logicalLines.length)
			title.style.setProperty('--home-hero-title-height', `${totalHeight}px`)
		}

		const scheduleRender = () => window.requestAnimationFrame(renderTitle)

		window.addEventListener('resize', scheduleRender, { passive: true })
		document.fonts?.ready.then(scheduleRender).catch(() => renderTitle())
		scheduleRender()
	}
</script>

<style>
	.home-hero {
		min-height: calc(100svh - var(--site-space-8));
		display: grid;
		align-items: center;
		justify-items: center;
		background: var(--site-color-paper);
		color: var(--site-color-on-brand);
		font-family: var(--site-font-body);
		--home-hero-control-bg: var(--site-color-surface);
		--home-hero-control-line: var(--site-color-line);
		--home-hero-control-shadow: var(--site-shadow-control);
		padding-block: clamp(4.5rem, 7.2vw, 6.6rem) var(--site-space-7);
		overflow: clip;
		text-align: center;
	}

	.home-hero__inner {
		display: grid;
		width: 100%;
		justify-items: center;
	}

	.home-hero__content {
		display: grid;
		gap: clamp(1.35rem, 1.35vw, 2rem);
		width: min(100%, 46rem);
		justify-items: center;
		text-align: center;
	}

	.home-hero__eyebrow {
		color: var(--site-color-on-brand);
		display: flex;
		justify-content: center;
		gap: clamp(var(--site-space-2), 1.25vw, var(--site-space-3));
		align-items: center;
		font-size: clamp(0.62rem, 0.9vw, 0.76rem);
		font-weight: 600;
		letter-spacing: 0.2em;
		white-space: nowrap;
	}

	.home-hero__eyebrow-dot {
		color: currentColor;
		opacity: 0.72;
	}

	.home-hero__title {
		margin: 0;
		width: min(100%, 13.5em);
		color: var(--site-color-on-brand);
		font-family: var(--site-font-display);
		font-size: clamp(3rem, 5.1vw, 5.35rem);
		font-weight: 300;
		letter-spacing: 0;
		line-height: 0.9;
		text-transform: uppercase;
	}

	.home-hero__title-line {
		display: block;
		white-space: nowrap;
	}

	.home-hero__actions {
		display: grid;
		gap: 0.58rem;
		width: fit-content;
		justify-items: center;
	}

	.home-hero__action-label,
	.home-hero__install-label {
		color: var(--site-color-on-brand);
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: lowercase;
	}

	.home-hero__portal {
		width: fit-content;
		min-height: 2.65rem;
		justify-content: center;
		gap: var(--site-space-2);
		border: 1px solid var(--home-hero-control-line);
		border-radius: calc(var(--site-radius-sm) * 0.25);
		background: var(--home-hero-control-bg);
		color: var(--site-color-secondary);
		box-shadow: var(--home-hero-control-shadow);
		font-family: var(--site-font-mono);
		font-size: clamp(0.82rem, 0.95vw, 0.92rem);
		font-weight: 700;
		letter-spacing: 0.04em;
		line-height: 1;
		padding: 0.78rem 1.28rem;
		text-transform: lowercase;
	}

	.home-hero__portal-arrow {
		width: var(--site-space-4);
		height: var(--site-space-4);
		fill: none;
		stroke: currentColor;
		stroke-width: 1.75;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.home-hero__install-wrap {
		display: grid;
		gap: 0.62rem;
		width: min(100%, 34rem);
		justify-items: center;
	}

	.home-hero__install {
		width: 100%;
		overflow: hidden;
		padding: 0;
		border: 1px solid var(--home-hero-control-line);
		border-radius: calc(var(--site-radius-sm) * 0.25);
		background: var(--home-hero-control-bg);
		box-shadow: var(--home-hero-control-shadow);
	}

	.home-hero__tabs {
		display: flex;
		justify-content: center;
		gap: clamp(1.35rem, 2.2vw, 2rem);
		overflow-x: auto;
		overflow-y: hidden;
		border-bottom: 1px solid var(--home-hero-control-line);
		padding: 0.72rem var(--site-space-4) 0;
		scrollbar-width: none;
	}

	.home-hero__tabs::-webkit-scrollbar {
		display: none;
	}

	.home-hero__tab {
		border: 0;
		border-bottom: 1px solid transparent;
		background: transparent;
		color: var(--site-color-muted);
		font: 600 clamp(0.78rem, 0.95vw, 0.88rem) / 1 var(--site-font-mono);
		letter-spacing: 0;
		padding: 0 0 0.72rem;
		white-space: nowrap;
	}

	.home-hero__tab:hover,
	.home-hero__tab:focus-visible {
		color: var(--site-color-ink);
		outline: none;
	}

	.home-hero__tab.is-active {
		border-bottom-color: transparent;
		color: var(--site-color-ink);
	}

	.home-hero__panels {
		background: var(--home-hero-control-bg);
	}

	.home-hero__panel {
		display: none;
		width: 100%;
		align-items: center;
		justify-content: space-between;
		gap: var(--site-space-3);
		border: 0;
		background: transparent;
		color: var(--site-color-ink);
		cursor: pointer;
		padding: 0.86rem var(--site-space-4);
		text-align: left;
		text-decoration: none;
		transition:
			background var(--site-motion-fast) var(--site-ease-standard),
			color var(--site-motion-fast) var(--site-ease-standard);
	}

	.home-hero__panel.is-active {
		display: flex;
	}

	.home-hero__panel:hover,
	.home-hero__panel:focus-visible {
		background: transparent;
		outline: none;
	}

	.home-hero__value {
		min-width: 0;
		color: var(--site-color-ink);
		font: 600 var(--home-hero-value-size, 0.82rem) / 1.28 var(--site-font-mono);
		overflow: visible;
		overflow-wrap: anywhere;
		text-overflow: clip;
		white-space: normal;
	}

	.home-hero__panel-action {
		width: var(--site-space-5);
		height: var(--site-space-5);
		border-radius: calc(var(--site-radius-sm) * 0.75);
		color: var(--site-color-muted);
		display: inline-flex;
		flex: 0 0 auto;
		align-items: center;
		justify-content: center;
		font-family: var(--site-font-mono);
	}

	.home-hero__panel:hover .home-hero__panel-action,
	.home-hero__panel:focus-visible .home-hero__panel-action {
		color: var(--site-color-ink);
		background: transparent;
	}

	.home-hero__panel-action svg {
		width: var(--site-space-4);
		height: var(--site-space-4);
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.5;
	}

	.home-hero__check-icon {
		display: none;
	}

	.home-hero__panel.is-copied .home-hero__panel-action {
		color: var(--site-color-secondary);
	}

	.home-hero__panel.is-copied .home-hero__copy-icon {
		display: none;
	}

	.home-hero__panel.is-copied .home-hero__check-icon {
		display: block;
	}

	@media (max-width: 1180px) {
		.home-hero {
			min-height: auto;
			padding-block: clamp(5.5rem, 10vw, 7.5rem) var(--site-space-7);
		}

		.home-hero__title {
			font-size: clamp(2.85rem, 7vw, 4.85rem);
			width: min(100%, 12.5em);
		}
	}

	@media (max-width: 860px) {
		.home-hero__inner,
		.home-hero__content {
			gap: var(--site-space-4);
		}

		.home-hero__actions {
			gap: var(--site-space-2);
		}

		.home-hero__install-wrap {
			gap: var(--site-space-2);
		}

		.home-hero__title {
			font-size: clamp(2.65rem, 9vw, 4.2rem);
			width: min(100%, 11.5em);
		}

		.home-hero__install-wrap {
			width: 100%;
		}
	}

	@media (max-width: 560px) {
		.home-hero {
			padding-block: clamp(5.75rem, 20vw, 7.4rem) var(--site-space-7);
		}

		.home-hero__eyebrow {
			align-items: center;
			flex-direction: row;
			gap: clamp(0.45rem, 2vw, var(--site-space-3));
			font-size: clamp(0.62rem, 2.4vw, 0.72rem);
			letter-spacing: 0.18em;
		}

		.home-hero__eyebrow-dot {
			display: inline;
		}

		.home-hero__inner,
		.home-hero__content {
			gap: clamp(1.3rem, 5.2vw, 1.95rem);
		}

		.home-hero__actions,
		.home-hero__install-wrap {
			gap: clamp(0.55rem, 2.4vw, 0.72rem);
		}

		.home-hero__title {
			font-size: clamp(2.45rem, 11.5vw, 3.55rem);
			width: min(100%, 10.5em);
		}

		.home-hero__tabs {
			gap: clamp(1.55rem, 8.6vw, 2.05rem);
			padding: 0.82rem clamp(1rem, 4.2vw, 1.18rem) 0;
		}

		.home-hero__tab {
			font-size: clamp(0.64rem, 2.6vw, 0.72rem);
			padding: 0 0 0.82rem;
		}

		.home-hero__value {
			--home-hero-value-size: clamp(0.72rem, 3.2vw, 0.9rem);
			letter-spacing: 0;
		}

		.home-hero__portal {
			width: fit-content;
			min-height: 2.58rem;
			gap: 0.7rem;
			padding: 0.78rem 1.22rem;
			font-size: clamp(0.82rem, 3vw, 0.92rem);
		}

		.home-hero__portal-arrow {
			width: 0.95rem;
			height: 0.95rem;
		}

		.home-hero__panel {
			gap: var(--site-space-2);
			padding: 0.92rem clamp(1rem, 4.2vw, 1.18rem);
		}

		.home-hero__panel-action {
			width: var(--site-space-4);
			height: var(--site-space-4);
		}
	}
</style>