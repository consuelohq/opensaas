---
type Props = {
  sectionId?: string;
};

const { sectionId = 'intro' } = Astro.props as Props;
const installCommand = 'curl -fsSL https://install.consuelohq.com/os | bash';
---

<section class="os-hero" id={sectionId} data-section="hero">
  <img
    class="os-hero__art"
    src="/images/home/connect-transparent.svg"
    alt=""
    width="1200"
    height="900"
    aria-hidden="true"
  />

  <div class="os-hero__content">
    <p class="os-hero__eyebrow">OPEN SOURCE <span aria-hidden="true">•</span> MIT LICENSE</p>
    <h1>YOUR WORKSPACE, CONNECTED TO EVERY AGENT.</h1>
    <p class="os-hero__subtitle">
      Build it once. Use it from ChatGPT, Codex, Claude, and whatever comes next.
    </p>

    <div class="os-hero__actions">
      <a class="os-hero__button" href="https://os.consuelohq.com">SIGN IN</a>
      <button class="os-hero__button os-hero__button--quiet" type="button" data-copy-install>
        DOWNLOAD LOCALLY
      </button>
    </div>

    <button class="os-hero__command" type="button" data-copy-install aria-label="Copy install command">
      <code>{installCommand}</code>
      <span data-copy-label>COPY</span>
    </button>
  </div>
</section>

<script define:vars={{ installCommand }}>
  document.querySelectorAll('[data-copy-install]').forEach((button) => {
    button.addEventListener('click', async () => {
      await navigator.clipboard?.writeText(installCommand);
      document.querySelectorAll('[data-copy-label]').forEach((label) => {
        label.textContent = 'COPIED';
      });
      window.setTimeout(() => {
        document.querySelectorAll('[data-copy-label]').forEach((label) => {
          label.textContent = 'COPY';
        });
      }, 1500);
    });
  });
</script>

<style>
  .os-hero {
    position: relative;
    display: grid;
    min-height: calc(100svh - clamp(4.5rem, 8vw, 6.5rem));
    place-items: center;
    overflow: hidden;
    background: var(--site-color-brand);
    color: white;
    padding: clamp(7rem, 12vw, 10rem) 1rem clamp(4rem, 8vw, 6rem);
    text-align: center;
  }

  .os-hero__content {
    position: relative;
    z-index: 2;
    display: grid;
    width: min(100%, 58rem);
    justify-items: center;
    gap: clamp(1rem, 1.7vw, 1.5rem);
  }

  .os-hero__eyebrow {
    margin: 0;
    font: 650 0.66rem/1 var(--site-font-mono);
    letter-spacing: 0.2em;
  }

  .os-hero h1 {
    max-width: 12.5em;
    margin: 0;
    color: white;
    font-family: var(--site-font-display);
    font-size: clamp(3.25rem, 6.3vw, 6.6rem);
    font-weight: 430;
    letter-spacing: 0;
    line-height: 0.9;
    text-wrap: balance;
  }

  .os-hero__subtitle {
    max-width: 42rem;
    margin: 0;
    color: rgba(255, 255, 255, 0.86);
    font-size: clamp(0.9rem, 1.25vw, 1.05rem);
    line-height: 1.55;
    text-wrap: balance;
  }

  .os-hero__actions {
    display: grid;
    width: min(100%, 17rem);
    gap: 0.55rem;
    margin-top: 0.35rem;
  }

  .os-hero__button,
  .os-hero__command {
    border: 1px solid white;
    border-radius: 0;
    font-family: var(--site-font-mono);
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.08em;
  }

  .os-hero__button {
    display: grid;
    min-height: 2.75rem;
    place-items: center;
    background: white;
    color: var(--site-color-brand);
    text-decoration: none;
    transition: background var(--site-motion-fast), color var(--site-motion-fast);
  }

  .os-hero__button--quiet {
    background: transparent;
    color: white;
  }

  .os-hero__button:hover,
  .os-hero__button:focus-visible {
    background: var(--site-color-soft-white);
  }

  .os-hero__button--quiet:hover,
  .os-hero__button--quiet:focus-visible {
    background: white;
    color: var(--site-color-brand);
  }

  .os-hero__command {
    display: flex;
    width: min(100%, 31rem);
    min-height: 2.8rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    overflow: hidden;
    background: rgba(0, 0, 242, 0.76);
    color: white;
    padding: 0.7rem 0.9rem;
    text-align: left;
  }

  .os-hero__command code {
    min-width: 0;
    overflow: hidden;
    font: inherit;
    letter-spacing: 0;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .os-hero__command span {
    flex: 0 0 auto;
    font-size: 0.62rem;
  }

  .os-hero__art {
    position: absolute;
    z-index: 1;
    bottom: -30%;
    left: 50%;
    width: min(92vw, 75rem);
    max-width: none;
    opacity: 0.12;
    filter: brightness(0) invert(1);
    transform: translateX(-50%);
    pointer-events: none;
  }

  @media (max-width: 720px) {
    .os-hero {
      min-height: calc(100svh - 4.5rem);
      padding: 6.25rem 1rem 3.5rem;
    }

    .os-hero h1 {
      font-size: clamp(2.9rem, 13vw, 4.5rem);
      line-height: 0.92;
    }

    .os-hero__subtitle {
      max-width: 22rem;
    }

    .os-hero__command {
      font-size: 0.62rem;
    }

    .os-hero__art {
      bottom: -8%;
      width: 150vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .os-hero__button {
      transition: none;
    }
  }
</style>
