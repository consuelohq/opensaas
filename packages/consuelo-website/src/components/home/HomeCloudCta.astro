---
import { homeWorkspaceClose } from '../../data/home-content';
---

<section
  class="cloud-cta"
  aria-labelledby="cloud-cta-title"
  data-section="cloud"
  data-cloud-reveal
  inert
>
  <div class="cloud-cta__copy">
    <p class="cloud-cta__eyebrow">{homeWorkspaceClose.eyebrow}</p>
    <h2 id="cloud-cta-title">
      {homeWorkspaceClose.title.split('\n').map((line) => <span data-cloud-title-line>{line}</span>)}
    </h2>
    <p class="cloud-cta__description">{homeWorkspaceClose.description}</p>
    <div class="cloud-cta__actions">
      <a class="cloud-cta__primary" href={homeWorkspaceClose.primaryHref}>{homeWorkspaceClose.primaryLabel}</a>
      <a class="cloud-cta__secondary" href={homeWorkspaceClose.secondaryHref}>{homeWorkspaceClose.secondaryLabel}</a>
    </div>
  </div>

  <p class="cloud-cta__version">CONSUELO OS <span>V0.10.3</span></p>
  <div class="cloud-cta__signature" aria-label="Consuelo OS, MIT License, 2026">
    <span>CONSUELO</span>
    <span>MIT LICENSE <span aria-hidden="true">•</span> 2026</span>
  </div>
</section>

<style>
  .cloud-cta {
    --cloud-gutter: clamp(4.75rem, 8.5vw, 8rem);
    --cloud-reveal-opacity: 0;
    --cloud-reveal-pointer-events: none;
    position: fixed;
    z-index: 1;
    inset: 0;
    display: grid;
    width: 100%;
    height: 100svh;
    height: 100dvh;
    place-items: center;
    overflow: hidden;
    background: var(--site-color-brand);
    color: var(--site-color-on-brand);
    opacity: var(--cloud-reveal-opacity);
    padding: var(--site-space-7) var(--cloud-gutter);
    pointer-events: var(--cloud-reveal-pointer-events);
    text-align: center;
    transition: opacity var(--site-motion-fast) linear;
  }

  .cloud-cta__copy {
    position: relative;
    z-index: 4;
    display: grid;
    width: min(100%, var(--site-container-max));
    justify-items: center;
    gap: var(--site-space-5);
  }

  .cloud-cta__eyebrow,
  .cloud-cta__version,
  .cloud-cta__signature {
    font-family: var(--site-font-mono);
    font-size: 0.62rem;
    line-height: 1.45;
    letter-spacing: 0.14em;
  }

  .cloud-cta__eyebrow {
    margin: 0;
    font-weight: 650;
  }

  .cloud-cta h2 {
    width: 100%;
    min-width: 0;
    margin: 0;
    color: var(--site-color-on-brand);
    font-family: var(--site-font-display);
    font-size: var(--site-footer-title-size);
    font-weight: 430;
    line-height: var(--site-leading-tight);
  }

  .cloud-cta h2 [data-cloud-title-line] {
    display: block;
  }

  .cloud-cta__description {
    max-width: 36rem;
    margin: 0;
    color: var(--site-color-muted-on-brand);
    font: 400 var(--site-text-md)/var(--site-leading-body) var(--site-font-body);
    text-wrap: balance;
  }

  .cloud-cta__actions {
    display: grid;
    justify-items: center;
    gap: var(--site-space-5);
    margin-top: var(--site-space-4);
  }

  .cloud-cta__primary {
    display: grid;
    width: 12.5rem;
    min-height: 2.35rem;
    place-items: center;
    border: 1px solid var(--site-color-on-brand);
    background: var(--site-color-on-brand);
    color: var(--site-color-brand);
    font: 600 0.68rem/1 var(--site-font-mono);
    letter-spacing: 0.11em;
    text-decoration: none;
    transition: background var(--site-motion-fast), color var(--site-motion-fast);
  }

  .cloud-cta__primary:hover,
  .cloud-cta__primary:focus-visible {
    background: transparent;
    color: var(--site-color-on-brand);
  }

  .cloud-cta__secondary {
    color: var(--site-color-on-brand);
    font: 600 var(--site-text-xs)/1.4 var(--site-font-mono);
    text-underline-offset: var(--site-space-1);
  }

  .cloud-cta__version,
  .cloud-cta__signature {
    position: absolute;
    z-index: 5;
    bottom: clamp(2rem, 7dvh, 4rem);
    margin: 0;
    font-weight: 500;
  }

  .cloud-cta__version {
    left: var(--cloud-gutter);
    display: flex;
    align-items: baseline;
    gap: 0.65em;
    text-align: left;
    white-space: nowrap;
  }

  .cloud-cta__version span {
    opacity: 0.78;
  }

  .cloud-cta__signature {
    right: var(--cloud-gutter);
    display: grid;
    justify-items: end;
    gap: 0.18rem;
    text-align: right;
  }

  @media (min-width: 601px) and (max-width: 900px) {
    .cloud-cta {
      --cloud-gutter: clamp(5rem, 13vw, 6.5rem);
    }
  }

  @media (max-width: 600px) {
    .cloud-cta {
      --cloud-gutter: 0.75rem;
    }

    .cloud-cta__copy {
      gap: var(--site-space-4);
    }

    .cloud-cta__eyebrow {
      font-size: var(--site-text-xs);
    }

    .cloud-cta h2 {
      font-size: var(--site-footer-title-size-mobile);
    }

    .cloud-cta__description {
      max-width: 21rem;
    }

    .cloud-cta__primary {
      width: 12rem;
      min-height: 2.2rem;
      font-size: 0.62rem;
    }

    .cloud-cta__version,
    .cloud-cta__signature {
      font-size: 0.48rem;
      letter-spacing: 0.13em;
    }

    .cloud-cta__version {
      bottom: 0.75rem;
      left: var(--cloud-gutter);
    }

    .cloud-cta__signature {
      right: auto;
      bottom: 2.35rem;
      left: var(--cloud-gutter);
      justify-items: start;
      text-align: left;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cloud-cta {
      --cloud-reveal-opacity: 1;
      transition: none;
    }
  }
</style>

<script>
  const footer = document.querySelector<HTMLElement>('[data-cloud-reveal]');

  if (footer) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let animationFrame = 0;

    const updateReveal = () => {
      animationFrame = 0;
      const scrollLimit = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
      const remaining = Math.max(0, scrollLimit - window.scrollY);
      const revealDistance = Math.max(720, Math.min(1400, window.innerHeight * 1.4));
      const progress = reducedMotion.matches
        ? 1
        : Math.max(0, Math.min(1, 1 - remaining / revealDistance));
      const opacity = reducedMotion.matches ? 1 : Math.pow(progress, 1.15);
      const interactive = progress >= 0.98;

      footer.style.setProperty('--cloud-reveal-opacity', opacity.toFixed(3));
      footer.style.setProperty('--cloud-reveal-pointer-events', interactive ? 'auto' : 'none');
      footer.toggleAttribute('inert', !interactive);
    };

    const scheduleReveal = () => {
      if (animationFrame !== 0) {
        return;
      }
      animationFrame = window.requestAnimationFrame(updateReveal);
    };

    window.addEventListener('scroll', scheduleReveal, { passive: true });
    window.addEventListener('resize', scheduleReveal);
    reducedMotion.addEventListener('change', scheduleReveal);
    scheduleReveal();
  }
</script>
