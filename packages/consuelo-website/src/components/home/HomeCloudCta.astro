---
---

<section
  class="cloud-cta"
  aria-labelledby="cloud-cta-title"
  data-section="cloud"
  data-cloud-reveal
  inert
>
  <div class="cloud-cta__copy">
    <p class="cloud-cta__eyebrow">FREE <span aria-hidden="true">•</span> PLUS <span aria-hidden="true">•</span> SUPER <span aria-hidden="true">•</span> ULTRA</p>
    <h2 id="cloud-cta-title">
      <span data-cloud-title-line>CONSUELO</span>
      <span data-cloud-title-line>CLOUD</span>
    </h2>
    <p class="cloud-cta__description">
      <span>KEEP THE SAME WORKSPACE AND LET CONSUELO</span>
      <span>RUN THE HOME NODE FOR YOU</span>
    </p>
    <a href="/pricing">VIEW ALL OUR PLANS</a>
  </div>

  <p class="cloud-cta__wordmark" aria-hidden="true">
    <span data-cloud-word-line>CONSUELO</span>
    <span data-cloud-word-line>CLOUD</span>
  </p>
  <img
    class="cloud-cta__art"
    src="/images/home/holding-world-editorial.png"
    alt="Consuelo holding a connected world"
    width="1832"
    height="2064"
    loading="eager"
    decoding="async"
  />

  <p class="cloud-cta__version">CONSUELO OS <span>V0.10.3</span></p>
  <div class="cloud-cta__signature" aria-label="Consuelo OS, MIT License, 2026">
    <span class="cloud-cta__badge" aria-hidden="true">
      <img src="/images/home/consuelo-footer-badge.png" alt="" width="242" height="346" />
    </span>
    <span>CONSUELO</span>
    <span>MIT LICENSE <span aria-hidden="true">•</span> 2026</span>
  </div>
</section>

<style>
  .cloud-cta {
    --cloud-gutter: clamp(4.75rem, 8.5vw, 8rem);
    --cloud-reveal-opacity: 0;
    --cloud-reveal-pointer-events: none;
    position: fixed;
    z-index: 1;
    inset: 0;
    display: grid;
    width: 100%;
    height: 100svh;
    height: 100dvh;
    place-items: start center;
    overflow: hidden;
    background: var(--site-color-brand);
    color: white;
    opacity: var(--cloud-reveal-opacity);
    padding: 7dvh var(--cloud-gutter) 0;
    pointer-events: var(--cloud-reveal-pointer-events);
    text-align: center;
    transition: opacity 120ms linear;
  }

  .cloud-cta__copy {
    position: relative;
    z-index: 4;
    display: grid;
    width: min(46vw, 42rem);
    justify-items: center;
    gap: clamp(0.55rem, 1.25vh, 0.8rem);
  }

  .cloud-cta__eyebrow,
  .cloud-cta__version,
  .cloud-cta__signature {
    font-family: var(--site-font-mono);
    font-size: 0.62rem;
    line-height: 1.45;
    letter-spacing: 0.14em;
  }

  .cloud-cta__eyebrow {
    margin: 0;
    font-weight: 650;
    letter-spacing: 0.16em;
  }

  .cloud-cta h2 {
    width: 100%;
    min-width: 0;
    margin: 0;
    color: white;
    font-family: var(--site-font-display);
    font-size: clamp(2.9rem, 4.58vw, 4.15rem);
    font-weight: 430;
    letter-spacing: 0.01em;
    line-height: 0.88;
    white-space: nowrap;
  }

  .cloud-cta h2 [data-cloud-title-line]:first-child::after {
    content: ' ';
  }

  .cloud-cta__description {
    display: grid;
    max-width: 34rem;
    margin: 0;
    color: rgba(255, 255, 255, 0.84);
    font-family: var(--site-font-mono);
    font-size: clamp(0.64rem, 0.9vw, 0.76rem);
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0.11em;
    text-wrap: balance;
  }

  .cloud-cta__description span {
    display: block;
  }

  .cloud-cta a {
    display: grid;
    width: 12.5rem;
    min-height: 2.35rem;
    place-items: center;
    border: 1px solid white;
    background: white;
    color: var(--site-color-brand);
    font: 600 0.68rem/1 var(--site-font-mono);
    letter-spacing: 0.11em;
    text-decoration: none;
    transition: background var(--site-motion-fast), color var(--site-motion-fast);
  }

  .cloud-cta a:hover,
  .cloud-cta a:focus-visible {
    background: transparent;
    color: white;
  }

  .cloud-cta__wordmark {
    position: absolute;
    z-index: 1;
    top: 34dvh;
    left: 50%;
    margin: 0;
    color: rgba(255, 255, 255, 0.16);
    font-family: var(--site-font-display);
    font-size: clamp(7rem, 10.2vw, 9.5rem);
    line-height: 0.72;
    transform: translateX(-50%);
    white-space: nowrap;
  }

  .cloud-cta__wordmark [data-cloud-word-line] {
    display: block;
  }

  .cloud-cta__wordmark [data-cloud-word-line]:last-child {
    margin-top: 0.13em;
    font-size: 0.68em;
  }

  .cloud-cta__art {
    position: absolute;
    z-index: 2;
    bottom: 0;
    left: 50%;
    width: auto;
    height: min(69dvh, 43rem);
    max-width: 65vw;
    object-fit: contain;
    object-position: center bottom;
    transform: translateX(-50%);
  }

  .cloud-cta__version,
  .cloud-cta__signature {
    position: absolute;
    z-index: 5;
    bottom: clamp(2rem, 7dvh, 4rem);
    margin: 0;
    font-weight: 500;
  }

  .cloud-cta__version {
    left: var(--cloud-gutter);
    display: flex;
    align-items: baseline;
    gap: 0.65em;
    text-align: left;
    white-space: nowrap;
  }

  .cloud-cta__version span {
    opacity: 0.78;
  }

  .cloud-cta__signature {
    right: var(--cloud-gutter);
    display: grid;
    justify-items: end;
    gap: 0.18rem;
    text-align: right;
  }

  .cloud-cta__badge {
    position: relative;
    display: block;
    width: 3.2rem;
    aspect-ratio: 121 / 173;
    overflow: hidden;
    margin-bottom: 0.25rem;
  }

  .cloud-cta__badge img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 601px) and (max-width: 900px) {
    .cloud-cta {
      --cloud-gutter: clamp(5rem, 13vw, 6.5rem);
    }

    .cloud-cta__copy {
      width: min(74vw, 36rem);
    }

    .cloud-cta h2 {
      font-size: clamp(3.2rem, 7.36vw, 4rem);
    }

    .cloud-cta__art {
      height: min(65dvh, 36.5rem);
      max-width: none;
    }
  }

  @media (max-width: 600px) {
    .cloud-cta {
      --cloud-gutter: 0.75rem;
      padding: 3.5rem var(--cloud-gutter) 0;
    }

    .cloud-cta__copy {
      width: min(100%, 22rem);
      gap: 0.55rem;
    }

    .cloud-cta h2 {
      font-size: clamp(3.25rem, 15.2vw, 4rem);
      line-height: 0.82;
      white-space: normal;
    }

    .cloud-cta h2 [data-cloud-title-line] {
      display: block;
      white-space: nowrap;
    }

    .cloud-cta h2 [data-cloud-title-line]:first-child::after {
      content: none;
    }

    .cloud-cta__description {
      max-width: 21rem;
      font-size: 0.58rem;
      line-height: 1.5;
      letter-spacing: 0.09em;
    }

    .cloud-cta a {
      width: 12rem;
      min-height: 2.2rem;
      font-size: 0.62rem;
    }

    .cloud-cta__wordmark {
      display: none;
    }

    .cloud-cta__art {
      width: auto;
      height: min(50dvh, 27rem);
      max-width: 110vw;
    }

    .cloud-cta__version,
    .cloud-cta__signature {
      font-size: 0.48rem;
      letter-spacing: 0.13em;
    }

    .cloud-cta__version {
      bottom: 0.75rem;
      left: var(--cloud-gutter);
    }

    .cloud-cta__signature {
      right: auto;
      bottom: 2.35rem;
      left: var(--cloud-gutter);
      justify-items: start;
      text-align: left;
    }

    .cloud-cta__badge {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cloud-cta {
      --cloud-reveal-opacity: 1;
      transition: none;
    }
  }
</style>

<script>
  const footer = document.querySelector<HTMLElement>('[data-cloud-reveal]');

  if (footer) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let animationFrame = 0;

    const updateReveal = () => {
      animationFrame = 0;
      const scrollLimit = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
      const remaining = Math.max(0, scrollLimit - window.scrollY);
      const revealDistance = Math.max(720, Math.min(1400, window.innerHeight * 1.4));
      const progress = reducedMotion.matches
        ? 1
        : Math.max(0, Math.min(1, 1 - remaining / revealDistance));
      const opacity = reducedMotion.matches ? 1 : Math.pow(progress, 1.15);
      const interactive = progress >= 0.98;

      footer.style.setProperty('--cloud-reveal-opacity', opacity.toFixed(3));
      footer.style.setProperty('--cloud-reveal-pointer-events', interactive ? 'auto' : 'none');
      footer.toggleAttribute('inert', !interactive);
    };

    const scheduleReveal = () => {
      if (animationFrame !== 0) {
        return;
      }
      animationFrame = window.requestAnimationFrame(updateReveal);
    };

    window.addEventListener('scroll', scheduleReveal, { passive: true });
    window.addEventListener('resize', scheduleReveal);
    reducedMotion.addEventListener('change', scheduleReveal);
    scheduleReveal();
  }
</script>
