---
---

<section
  class="cloud-cta"
  aria-labelledby="cloud-cta-title"
  data-section="cloud"
  data-cloud-reveal
  inert
>
  <div class="cloud-cta__copy">
    <p class="cloud-cta__eyebrow">FREE <span aria-hidden="true">•</span> PLUS <span aria-hidden="true">•</span> SUPER <span aria-hidden="true">•</span> ULTRA</p>
    <h2 id="cloud-cta-title">
      <span data-cloud-title-line>CONSUELO</span>
      <span data-cloud-title-line>CLOUD</span>
    </h2>
    <p class="cloud-cta__description">
      Keep the same workspace and let Consuelo run the home node for you.
    </p>
    <a href="/pricing">VIEW ALL PLANS</a>
  </div>

  <p class="cloud-cta__wordmark" aria-hidden="true">CONSUELO</p>
  <img
    class="cloud-cta__art"
    src="/images/home/holding-world.svg"
    alt="Consuelo holding a connected world"
    width="1200"
    height="1200"
    loading="lazy"
  />

  <p class="cloud-cta__version">CONSUELO OS</p>
  <div class="cloud-cta__signature" aria-label="Consuelo OS, MIT License, 2026">
    <span class="cloud-cta__badge" aria-hidden="true">
      <img src="/images/home/consuelo-mark.svg" alt="" width="52" height="52" />
      <strong>OS</strong>
    </span>
    <span>CONSUELO</span>
    <span>MIT LICENSE <span aria-hidden="true">•</span> 2026</span>
  </div>
</section>

<style>
  .cloud-cta {
    --cloud-reveal-opacity: 0;
    --cloud-reveal-pointer-events: none;
    position: fixed;
    z-index: 1;
    inset: 0;
    display: grid;
    width: 100%;
    height: 100svh;
    height: 100dvh;
    place-items: start center;
    overflow: hidden;
    background: var(--site-color-brand);
    color: white;
    opacity: var(--cloud-reveal-opacity);
    padding: clamp(3.5rem, 7vh, 6rem) 1rem 1rem;
    pointer-events: var(--cloud-reveal-pointer-events);
    text-align: center;
    transition: opacity 120ms linear;
  }

  .cloud-cta__copy {
    position: relative;
    z-index: 3;
    display: grid;
    justify-items: center;
    gap: clamp(0.65rem, 1.6vh, 1rem);
  }

  .cloud-cta__eyebrow,
  .cloud-cta__version,
  .cloud-cta__signature {
    font: 650 0.62rem/1.45 var(--site-font-mono);
    letter-spacing: 0.16em;
  }

  .cloud-cta__eyebrow {
    margin: 0;
  }

  .cloud-cta h2 {
    margin: 0;
    color: white;
    font-family: var(--site-font-display);
    font-size: clamp(3.4rem, 7vw, 7.5rem);
    font-weight: 430;
    letter-spacing: 0;
    line-height: 0.88;
  }

  .cloud-cta h2 [data-cloud-title-line]:first-child::after {
    content: ' ';
  }

  .cloud-cta__description {
    max-width: 34rem;
    margin: 0;
    color: rgba(255, 255, 255, 0.82);
    font-size: clamp(0.82rem, 1.2vw, 1rem);
    text-wrap: balance;
  }

  .cloud-cta a {
    border: 1px solid white;
    background: white;
    color: var(--site-color-brand);
    padding: 0.75rem 1.2rem;
    font: 650 0.68rem/1 var(--site-font-mono);
    letter-spacing: 0.1em;
    text-decoration: none;
    transition: background var(--site-motion-fast), color var(--site-motion-fast);
  }

  .cloud-cta a:hover,
  .cloud-cta a:focus-visible {
    background: transparent;
    color: white;
  }

  .cloud-cta__wordmark {
    position: absolute;
    z-index: 1;
    top: 54%;
    left: 50%;
    margin: 0;
    color: rgba(255, 255, 255, 0.13);
    font-family: var(--site-font-display);
    font-size: clamp(7rem, 22vw, 22rem);
    line-height: 0.7;
    transform: translate(-50%, -50%);
    white-space: nowrap;
  }

  .cloud-cta__art {
    position: absolute;
    z-index: 2;
    bottom: 0;
    left: 50%;
    width: min(47rem, 66vw);
    max-width: 100vw;
    max-height: 67dvh;
    object-fit: contain;
    object-position: center bottom;
    filter: brightness(0) invert(1);
    transform: translateX(-50%);
  }

  .cloud-cta__version,
  .cloud-cta__signature {
    position: absolute;
    z-index: 4;
    bottom: clamp(0.85rem, 2vw, 1.5rem);
    margin: 0;
  }

  .cloud-cta__version {
    left: clamp(1rem, 4vw, 4rem);
  }

  .cloud-cta__signature {
    right: clamp(1rem, 4vw, 4rem);
    display: grid;
    justify-items: center;
    gap: 0.18rem;
  }

  .cloud-cta__badge {
    position: relative;
    display: grid;
    width: 3.15rem;
    aspect-ratio: 1;
    place-items: center;
    overflow: hidden;
    border: 1px solid white;
    background: white;
    margin-bottom: 0.25rem;
  }

  .cloud-cta__badge img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cloud-cta__badge strong {
    position: absolute;
    right: 0.18rem;
    bottom: 0.08rem;
    color: var(--site-color-brand);
    font: 700 0.5rem/1 var(--site-font-mono);
  }

  @media (max-width: 600px) {
    .cloud-cta {
      padding: 3.5rem 0.8rem 0.8rem;
    }

    .cloud-cta__copy {
      gap: 0.65rem;
    }

    .cloud-cta h2 {
      font-size: clamp(3.1rem, 17vw, 4.5rem);
    }

    .cloud-cta h2 [data-cloud-title-line] {
      display: block;
    }

    .cloud-cta h2 [data-cloud-title-line]:first-child::after {
      content: none;
    }

    .cloud-cta__description {
      max-width: 20rem;
      font-size: 0.78rem;
    }

    .cloud-cta__wordmark {
      top: 58%;
      font-size: 31vw;
    }

    .cloud-cta__art {
      width: min(39rem, 115vw);
      max-width: 115vw;
      max-height: 50dvh;
    }

    .cloud-cta__version {
      bottom: 0.75rem;
      left: 0.75rem;
      max-width: 4.5rem;
      text-align: left;
    }

    .cloud-cta__signature {
      right: 0.75rem;
      bottom: 0.65rem;
      font-size: 0.48rem;
    }

    .cloud-cta__badge {
      width: 2.6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cloud-cta {
      --cloud-reveal-opacity: 1;
      transition: none;
    }
  }
</style>

<script>
  const footer = document.querySelector<HTMLElement>('[data-cloud-reveal]');

  if (footer) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let animationFrame = 0;

    const updateReveal = () => {
      animationFrame = 0;
      const scrollLimit = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
      const remaining = Math.max(0, scrollLimit - window.scrollY);
      const revealDistance = Math.max(320, Math.min(640, window.innerHeight * 0.75));
      const progress = reducedMotion.matches
        ? 1
        : Math.max(0, Math.min(1, 1 - remaining / revealDistance));
      const opacity = reducedMotion.matches ? 1 : progress * progress;
      const interactive = progress >= 0.98;

      footer.style.setProperty('--cloud-reveal-opacity', opacity.toFixed(3));
      footer.style.setProperty('--cloud-reveal-pointer-events', interactive ? 'auto' : 'none');
      footer.toggleAttribute('inert', !interactive);
    };

    const scheduleReveal = () => {
      if (animationFrame !== 0) {
        return;
      }
      animationFrame = window.requestAnimationFrame(updateReveal);
    };

    window.addEventListener('scroll', scheduleReveal, { passive: true });
    window.addEventListener('resize', scheduleReveal);
    reducedMotion.addEventListener('change', scheduleReveal);
    scheduleReveal();
  }
</script>
