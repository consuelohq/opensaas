---
import { Icon } from 'astro-icon/components';
import { siteLinks } from '../../data/site-links';

const cloudHref = 'https://os.consuelohq.com';
---

<header class="os-header" data-os-header>
  <nav class="os-header__desktop" aria-label="Primary">
    <a class="os-header__desktop-link" href="/blog">CONSUELO</a>
    <a class="os-header__desktop-link" href={siteLinks.docs}>DOCS</a>

    <div class="os-header__identity">
      <a class="os-header__wordmark" href="/" aria-label="Consuelo OS home">
        <span>CONSUELO</span>
        <span>OS</span>
      </a>
      <div class="os-header__socials" aria-label="Community links">
        <a href={siteLinks.discord} target="_blank" rel="noreferrer" aria-label="Discord">
          <Icon name="tabler:brand-discord-filled" />
        </a>
        <a href={siteLinks.github} target="_blank" rel="noreferrer" aria-label="GitHub">
          <Icon name="tabler:brand-github" />
        </a>
      </div>
    </div>

    <a class="os-header__desktop-link" href="/pricing">PRICING</a>
    <a class="os-header__desktop-link" href={cloudHref}>CLOUD</a>
  </nav>

  <nav class="os-header__mobile" aria-label="Mobile primary">
    <a class="os-header__side-link" href={siteLinks.docs}>DOCS</a>
    <div class="os-header__mobile-identity">
      <a class="os-header__mobile-wordmark" href="/" aria-label="Consuelo OS home">
        <span>CONSUELO</span>
        <span>OS</span>
      </a>
      <div class="os-header__socials os-header__mobile-socials" aria-label="Community links">
        <a href={siteLinks.discord} target="_blank" rel="noreferrer" aria-label="Discord">
          <Icon name="tabler:brand-discord-filled" />
        </a>
        <a href={siteLinks.github} target="_blank" rel="noreferrer" aria-label="GitHub">
          <Icon name="tabler:brand-github" />
        </a>
      </div>
    </div>
    <a class="os-header__side-link" href={cloudHref}>CLOUD</a>
  </nav>
</header>

<style>
  .os-header {
    position: absolute;
    inset: 0 0 auto;
    z-index: var(--site-z-header);
    color: white;
  }

  .os-header a {
    color: inherit;
    text-decoration: none;
  }

  .os-header__desktop {
    display: grid;
    grid-template-columns: 1fr 1fr 1.25fr 1fr 1fr;
    align-items: start;
    gap: 1rem;
    width: min(100%, 90rem);
    margin: 0 auto;
    padding: clamp(1.8rem, 4vw, 3.5rem) clamp(1.5rem, 4.8vw, 4rem);
    text-align: center;
  }

  .os-header__desktop-link {
    padding-block: 0.1rem;
    font-family: var(--site-font-mono);
    font-size: clamp(0.72rem, 0.95vw, 0.86rem);
    font-weight: 650;
    letter-spacing: 0.08em;
    line-height: 1;
  }

  .os-header__side-link {
    padding-block: 0.1rem;
    font-family: var(--site-font-display);
    font-size: clamp(1rem, 1.5vw, 1.35rem);
    font-weight: 600;
    letter-spacing: 0.025em;
    line-height: 1;
  }

  .os-header__identity {
    display: grid;
    justify-items: center;
    gap: 0.82rem;
    margin-top: -0.15rem;
  }

  .os-header__wordmark {
    display: grid;
    justify-items: center;
    font-family: var(--site-font-display);
    row-gap: 0.14rem;
    font-size: clamp(2rem, 2.8vw, 2.5rem);
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 0.78;
  }

  .os-header__wordmark span:last-child,
  .os-header__mobile-wordmark span:last-child {
    justify-self: center;
    text-align: center;
  }

  .os-header__socials {
    display: flex;
    gap: 0.5rem;
  }

  .os-header__socials a {
    display: grid;
    width: 1.25rem;
    height: 1.25rem;
    place-items: center;
    opacity: 0.72;
    transition: opacity var(--site-motion-fast);
  }

  .os-header__socials a:hover,
  .os-header__socials a:focus-visible {
    opacity: 1;
  }

  .os-header__mobile {
    display: none;
  }

  @media (max-width: 720px) {
    .os-header__desktop {
      display: none;
    }

    .os-header__mobile {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: start;
      padding: 1.55rem 1.3rem;
    }

    .os-header__mobile > :last-child {
      justify-self: end;
    }

    .os-header__side-link {
      font-size: clamp(1rem, 4.4vw, 1.2rem);
      font-weight: 600;
      letter-spacing: 0.025em;
    }

    .os-header__mobile-wordmark {
      display: grid;
      justify-items: center;
      font-family: var(--site-font-display);
      row-gap: 0.12rem;
      font-size: clamp(1.7rem, 7.4vw, 2rem);
      font-weight: 600;
      letter-spacing: 0.01em;
      line-height: 0.76;
    }

    .os-header__mobile-identity {
      display: grid;
      justify-items: center;
      gap: 0.68rem;
    }

    .os-header__mobile-socials {
      gap: 0.52rem;
    }

    .os-header__mobile-socials a {
      width: 1.3rem;
      height: 1.3rem;
    }

    .os-header__mobile-socials :global(svg) {
      width: 1.3rem;
      height: 1.3rem;
    }
  }
</style>
