---
import { Icon } from 'astro-icon/components';
import { siteLinks } from '../../data/site-links';

type Props = {
  pageSections?: Array<{ id: string; label: string }>;
};

const { pageSections = [] } = Astro.props as Props;
const cloudHref = 'https://os.consuelohq.com';
---

<header class="os-header" data-os-header>
  <nav class="os-header__desktop" aria-label="Primary">
    <a href="/blog">CONSUELO</a>
    <a href={siteLinks.docs}>DOCS</a>

    <div class="os-header__identity">
      <a class="os-header__wordmark" href="/" aria-label="Consuelo OS home">
        <span>CONSUELO</span>
        <span>OS</span>
      </a>
      <div class="os-header__socials" aria-label="Community links">
        <a href={siteLinks.discord} target="_blank" rel="noreferrer" aria-label="Discord">
          <Icon name="tabler:brand-discord-filled" />
        </a>
        <a href={siteLinks.github} target="_blank" rel="noreferrer" aria-label="GitHub">
          <Icon name="tabler:brand-github" />
        </a>
      </div>
    </div>

    <a href="/pricing">PRICING</a>
    <a href={cloudHref}>CLOUD</a>
  </nav>

  <nav class="os-header__mobile" aria-label="Mobile primary">
    <a href={cloudHref}>CLOUD</a>
    <div class="os-header__mobile-identity">
      <a class="os-header__mobile-wordmark" href="/" aria-label="Consuelo OS home">
        <span>CONSUELO</span>
        <span>OS</span>
      </a>
      <div class="os-header__socials os-header__mobile-socials" aria-label="Community links">
        <a href={siteLinks.discord} target="_blank" rel="noreferrer" aria-label="Discord">
          <Icon name="tabler:brand-discord-filled" />
        </a>
        <a href={siteLinks.github} target="_blank" rel="noreferrer" aria-label="GitHub">
          <Icon name="tabler:brand-github" />
        </a>
      </div>
    </div>
    <button type="button" aria-expanded="false" aria-controls="os-mobile-menu" data-mobile-menu-toggle>
      MENU
    </button>
  </nav>

  <div class="os-header__mobile-menu" id="os-mobile-menu" hidden data-mobile-menu>
    <a href={siteLinks.docs}>DOCS</a>
    <a href="/pricing">PRICING</a>
    {
      pageSections.map((section) => (
        <a href={'#' + section.id}>{section.label}</a>
      ))
    }
  </div>
</header>

<script>
  const toggle = document.querySelector('[data-mobile-menu-toggle]');
  const menu = document.querySelector('[data-mobile-menu]');

  if (toggle instanceof HTMLButtonElement && menu instanceof HTMLElement) {
    const closeMenu = () => {
      toggle.setAttribute('aria-expanded', 'false');
      menu.hidden = true;
    };

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';

      if (isOpen) {
        closeMenu();
        return;
      }

      toggle.setAttribute('aria-expanded', 'true');
      menu.hidden = false;
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });
  }
</script>

<style>
  .os-header {
    position: absolute;
    inset: 0 0 auto;
    z-index: var(--site-z-header);
    color: white;
    font-family: var(--site-font-mono);
    font-size: 0.74rem;
    font-weight: 650;
    letter-spacing: 0.08em;
  }

  .os-header a,
  .os-header button {
    color: inherit;
    text-decoration: none;
  }

  .os-header__desktop {
    display: grid;
    grid-template-columns: 1fr 1fr 1.25fr 1fr 1fr;
    align-items: start;
    gap: 1rem;
    width: min(100%, 90rem);
    margin: 0 auto;
    padding: clamp(1.8rem, 4vw, 3.5rem) clamp(1.5rem, 4.8vw, 4rem);
    text-align: center;
  }

  .os-header__identity {
    display: grid;
    justify-items: center;
    gap: 0.65rem;
    margin-top: -0.15rem;
  }

  .os-header__wordmark {
    display: grid;
    justify-items: center;
    font-family: var(--site-font-display);
    font-size: 1.65rem;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 0.82;
  }

  .os-header__wordmark span:last-child,
  .os-header__mobile-wordmark span:last-child {
    justify-self: center;
    text-align: center;
  }

  .os-header__socials {
    display: flex;
    gap: 0.45rem;
  }

  .os-header__socials a {
    display: grid;
    width: 1rem;
    height: 1rem;
    place-items: center;
    opacity: 0.72;
    transition: opacity var(--site-motion-fast);
  }

  .os-header__socials a:hover,
  .os-header__socials a:focus-visible {
    opacity: 1;
  }

  .os-header__mobile,
  .os-header__mobile-menu {
    display: none;
  }

  @media (max-width: 720px) {
    .os-header__desktop {
      display: none;
    }

    .os-header__mobile {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: start;
      padding: 1.35rem 1.15rem;
      font-size: 0.78rem;
      letter-spacing: 0.11em;
    }

    .os-header__mobile > :last-child {
      justify-self: end;
    }

    .os-header__mobile button {
      border: 0;
      background: transparent;
      padding: 0;
      font: inherit;
      letter-spacing: inherit;
    }

    .os-header__mobile-wordmark {
      display: grid;
      justify-items: center;
      font-family: var(--site-font-display);
      font-size: 1.28rem;
      font-weight: 600;
      letter-spacing: 0;
      line-height: 0.79;
    }

    .os-header__mobile-identity {
      display: grid;
      justify-items: center;
      gap: 0.48rem;
    }

    .os-header__mobile-socials {
      gap: 0.5rem;
    }

    .os-header__mobile-socials a {
      width: 1.08rem;
      height: 1.08rem;
    }

    .os-header__mobile-socials :global(svg) {
      width: 1.08rem;
      height: 1.08rem;
    }

    .os-header__mobile-menu {
      position: absolute;
      top: 3.6rem;
      right: 0.75rem;
      display: grid;
      min-width: 9rem;
      border: 1px solid rgba(255, 255, 255, 0.5);
      background: var(--site-color-brand);
      padding: 0.6rem 0.8rem;
    }

    .os-header__mobile-menu[hidden] {
      display: none;
    }

    .os-header__mobile-menu a {
      padding: 0.45rem 0;
    }
  }
</style>
