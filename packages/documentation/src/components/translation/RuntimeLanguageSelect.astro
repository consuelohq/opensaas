---
---

<span data-docs-runtime-translation-root hidden></span>

<script>
  import { resolvePreferredTranslationLanguage, sourceLanguage } from '../../lib/translation/languages';

  const translationEndpoint = '/api/docs/translate';
  let translationRequestId = 0;

  const escapeHtml = (value: string) => value
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;')
    .replaceAll("'", '&#39;');

  const setTranslationState = (state: string, language = sourceLanguage) => {
    const root = document.documentElement;
    root.dataset.docsTranslationState = state;
    root.dataset.docsTranslationLanguage = language;
  };

  const removePanel = () => {
    document.querySelector('[data-docs-runtime-translation-panel]')?.remove();
  };

  const renderPanel = (payload: { title: string; segments: string[]; targetLanguage: string }) => {
    const main = document.querySelector('main');
    if (!main) return;
    removePanel();
    const section = document.createElement('section');
    section.dataset.docsRuntimeTranslationPanel = '';
    section.dataset.translationLanguage = payload.targetLanguage;
    section.setAttribute('aria-live', 'polite');
    const paragraphs = payload.segments
      .map((segment) => `<p>${escapeHtml(segment)}</p>`)
      .join('');
    section.innerHTML = [
      '<div class="translation-panel-heading">',
      '<p class="translation-eyebrow">Machine translation</p>',
      `<h2>${escapeHtml(payload.title)}</h2>`,
      '</div>',
      `<div class="translation-panel-body">${paragraphs}</div>`,
    ].join('');
    main.prepend(section);
  };

  const browserLanguages = (): string[] => {
    if (Array.isArray(navigator.languages) && navigator.languages.length > 0) return [...navigator.languages];
    return navigator.language ? [navigator.language] : [];
  };

  const translateForBrowserLanguage = async () => {
    const languages = browserLanguages();
    const requestKey = `${window.location.pathname}|${languages.join(',')}`;
    if (document.documentElement.dataset.docsTranslationRequestKey === requestKey) return;
    document.documentElement.dataset.docsTranslationRequestKey = requestKey;
    const requestId = ++translationRequestId;
    const targetLanguage = resolvePreferredTranslationLanguage(languages);

    if (!targetLanguage) {
      removePanel();
      document.documentElement.lang = sourceLanguage;
      setTranslationState('source', sourceLanguage);
      return;
    }

    setTranslationState('loading', targetLanguage);
    const params = new URLSearchParams({ path: window.location.pathname, lang: targetLanguage });

    try {
      const response = await fetch(`${translationEndpoint}?${params.toString()}`, {
        headers: { accept: 'application/json' },
      });
      const payload = await response.json();
      if (requestId !== translationRequestId) return;
      if (!response.ok || !payload?.ok) {
        removePanel();
        document.documentElement.lang = sourceLanguage;
        setTranslationState('unavailable', targetLanguage);
        return;
      }

      renderPanel(payload);
      document.documentElement.lang = targetLanguage;
      setTranslationState(payload.cached ? 'ready-cached' : 'ready', targetLanguage);
    } catch {
      if (requestId !== translationRequestId) return;
      removePanel();
      document.documentElement.lang = sourceLanguage;
      setTranslationState('unavailable', targetLanguage);
    }
  };

  void translateForBrowserLanguage();
  document.addEventListener('astro:page-load', () => void translateForBrowserLanguage());
  document.addEventListener('astro:after-swap', () => void translateForBrowserLanguage());
</script>

<style>
  :global([data-docs-runtime-translation-panel]) {
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    margin-bottom: 1.5rem;
    padding: 1rem;
  }

  :global(.translation-panel-heading) {
    display: grid;
    gap: 0.2rem;
  }

  :global(.translation-panel-heading h2) {
    font-size: var(--sl-text-h4);
    margin: 0;
  }

  :global(.translation-eyebrow) {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    margin: 0;
    text-transform: uppercase;
  }

  :global(.translation-panel-body) {
    margin-top: 1rem;
  }

  :global(.translation-panel-body p) {
    margin: 0.75rem 0;
  }
</style>
