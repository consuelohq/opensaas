---
const image = (import.meta.env.PUBLIC_OS_WEBSITE_URL ?? 'https://consuelohq.com').replace(/\/$/, '') + '/consuelo-docs-og-20260929-clouds-v2.png';
import DefaultHead from '@astrojs/starlight/components/Head.astro';
---

<DefaultHead />
{import.meta.env.PUBLIC_DOCS_PREVIEW === '1' && <meta name="robots" content="noindex,nofollow" />}
<meta property="og:image" content={image} />
<meta property="og:image:alt" content="Consuelo OS Docs — build your workspace, connect agents." />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content="Consuelo OS Docs — build your workspace, connect agents." />

<script is:inline>
  (() => {
    const root = document.documentElement;
    root.dataset.docsInputModality = 'pointer';

    window.addEventListener(
      'pointerdown',
      () => {
        root.dataset.docsInputModality = 'pointer';
      },
      { capture: true },
    );

    window.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'Tab') root.dataset.docsInputModality = 'keyboard';
      },
      { capture: true },
    );
  })();
</script>
