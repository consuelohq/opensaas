---
import DefaultHead from '@astrojs/starlight/components/Head.astro';
---

<DefaultHead />
<meta property="og:image" content="https://consuelohq.com/consuelo-docs-og-20260929-clouds.png" />
<meta property="og:image:alt" content="Consuelo OS Docs — build your workspace, connect agents." />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:image" content="https://consuelohq.com/consuelo-docs-og-20260929-clouds.png" />
<meta name="twitter:image:alt" content="Consuelo OS Docs — build your workspace, connect agents." />

<script is:inline>
  (() => {
    const root = document.documentElement;
    root.dataset.docsInputModality = 'pointer';

    window.addEventListener(
      'pointerdown',
      () => {
        root.dataset.docsInputModality = 'pointer';
      },
      { capture: true },
    );

    window.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'Tab') root.dataset.docsInputModality = 'keyboard';
      },
      { capture: true },
    );
  })();
</script>
