---
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a class="consuelo-site-title" href={siteTitleHref}>
  <img aria-hidden="true" alt="" height="28" src="/favicon.svg" width="28" />
  <span translate="no">Consuelo OS</span>
</a>

<style>
  @layer starlight.core {
    .consuelo-site-title {
      align-items: center;
      color: var(--sl-color-white);
      display: inline-flex;
      font-size: var(--sl-text-h4);
      font-weight: 650;
      gap: 0.6rem;
      min-width: 0;
      text-decoration: none;
      white-space: nowrap;
    }

    .consuelo-site-title:hover {
      color: var(--sl-color-white);
      opacity: 0.82;
    }

    .consuelo-site-title img {
      border-radius: 0.38rem;
      display: block;
      flex: 0 0 auto;
      height: 1.75rem;
      width: 1.75rem;
    }
  }
</style>
