---
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';
import {
  expandCurrentSidebarPath,
  globalSectionLinks,
  selectSectionSidebar,
} from '../lib/docs-navigation';

const routeSidebar = Astro.locals.starlightRoute.sidebar;
const navigation = selectSectionSidebar(routeSidebar, Astro.url.pathname);
const mobileNavigation = expandCurrentSidebarPath(routeSidebar);
---

<docs-sidebar-search>
  <button class="docs-sidebar-search" type="button" data-docs-sidebar-search-trigger aria-label="Search Docs">
    <svg aria-hidden="true" viewBox="0 0 24 24">
      <circle cx="11" cy="11" r="6.5" />
      <path d="m16 16 4 4" />
    </svg>
    <span>Search Docs</span>
  </button>
</docs-sidebar-search>

{
  navigation.mode === 'section' ? (
    <nav aria-label={`${navigation.sectionLabel} documentation`} class="section-sidebar">
      <a class="all-docs" href="/">← All documentation</a>
      <SidebarSublist sublist={navigation.entries} />
    </nav>
  ) : (
    <nav aria-label="Documentation sections" class="global-sidebar global-sidebar-desktop">
      <ul class="global-section-list">
        {globalSectionLinks.map((section) => (
          <li>
            <a class="global-section-link" href={section.href}>
              <span>{section.label}</span>
              <svg aria-hidden="true" viewBox="0 0 24 24">
                <path d="m9 18 6-6-6-6" />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<nav aria-label="Documentation sections" class="global-sidebar global-sidebar-mobile">
  <SidebarSublist sublist={mobileNavigation} />
</nav>

<div class="docs-sidebar-mobile-footer">
  <MobileMenuFooter />
</div>

<script>
  class DocsSidebarSearch extends HTMLElement {
    connectedCallback() {
      if (this.dataset.searchBound === 'true') return;
      this.dataset.searchBound = 'true';
      const trigger = this.querySelector('[data-docs-sidebar-search-trigger]');
      if (!(trigger instanceof HTMLButtonElement)) return;
      trigger.addEventListener('click', (event) => {
        event.stopPropagation();
        const searchButton = document.querySelector('[data-docs-header-search] button[data-open-modal]');
        if (searchButton instanceof HTMLButtonElement) searchButton.click();
      });
    }
  }

  if (!customElements.get('docs-sidebar-search')) customElements.define('docs-sidebar-search', DocsSidebarSearch);
</script>

<style>
  @layer starlight.core {
    docs-sidebar-search {
      display: block;
      width: 100%;
    }

    .docs-sidebar-search {
      align-items: center;
      background: transparent;
      border: 1px solid var(--docs-line-strong);
      border-radius: 0.375rem;
      color: var(--docs-muted);
      cursor: pointer;
      display: flex;
      font: inherit;
      font-size: 0.875rem;
      font-weight: 400;
      gap: 0.5rem;
      min-height: 2.25rem;
      padding: 0 0.625rem;
      text-align: left;
      transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease;
      width: 100%;
    }

    .docs-sidebar-search:hover,
    .docs-sidebar-search:focus-visible {
      background: var(--docs-panel);
      border-color: var(--docs-line-strong);
      color: var(--docs-ink);
    }

    .docs-sidebar-search svg {
      fill: none;
      height: 1.05rem;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-width: 1.7;
      width: 1.05rem;
    }

    .section-sidebar {
      display: grid;
      gap: 1rem;
    }

    .all-docs {
      color: var(--sl-color-gray-2);
      display: inline-flex;
      font-size: var(--sl-text-sm);
      padding-inline: 0.5rem;
      text-decoration: none;
    }

    .all-docs:hover,
    .all-docs:focus-visible {
      color: var(--sl-color-white);
    }

    .global-section-list {
      display: grid;
      gap: 0.0625rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .global-section-link {
      align-items: center;
      border-radius: 0.45rem;
      color: var(--sl-color-gray-2);
      display: flex;
      font-size: 0.875rem;
      font-weight: 400;
      justify-content: space-between;
      line-height: 1.3125rem;
      min-height: 2.25rem;
      padding: 0 0.625rem;
      text-decoration: none;
    }

    .global-section-link svg {
      fill: none;
      height: 1rem;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-width: 2;
      width: 1rem;
    }

    .global-section-link:hover {
      background: var(--docs-panel);
      color: var(--sl-color-white);
    }

    .global-section-link:focus:not(:focus-visible) {
      outline: none;
    }

    .global-section-link:focus-visible {
      outline: 2px solid color-mix(in srgb, var(--sl-color-white) 55%, transparent);
      outline-offset: 2px;
    }

    .global-sidebar-mobile {
      display: none;
    }

    .docs-sidebar-mobile-footer {
      display: block;
      margin-top: auto;
    }

    @media (max-width: 71.999rem) {
      .global-sidebar-desktop,
      .section-sidebar {
        display: none;
      }

      .global-sidebar-mobile {
        display: block;
      }

      .global-sidebar-mobile :global(summary),
      .global-sidebar-mobile :global(a) {
        border-radius: 0.375rem;
        box-sizing: border-box;
        font-weight: 400;
        min-height: 2.25rem;
        transition: background-color 150ms ease, color 150ms ease;
      }

      .global-sidebar-mobile :global(summary) {
        align-items: center;
        display: flex;
        font-size: 0.9375rem;
        line-height: 1.5rem;
        padding-block: 0.375rem;
      }

      .global-sidebar-mobile :global(a) {
        align-items: center;
        display: flex;
        font-size: 0.875rem;
        line-height: 1.5rem;
        padding-block: 0.375rem;
      }
    }

    @media (min-width: 72rem) {
      docs-sidebar-search,
      .docs-sidebar-mobile-footer {
        display: none;
      }
    }
  }
</style>
