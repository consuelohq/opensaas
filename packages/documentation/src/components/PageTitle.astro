---
import { getBreadcrumbs } from '../lib/docs-navigation';
import { pagePathToMarkdownHref } from '../lib/markdown-pages';

const title = Astro.locals.starlightRoute.entry.data.title;
const description = Astro.locals.starlightRoute.entry.data.description;
const markdownHref = pagePathToMarkdownHref(Astro.url.pathname);
const breadcrumbs = getBreadcrumbs(Astro.url.pathname);
const hasToc = Boolean(Astro.locals.starlightRoute.toc);
const isHome = Astro.url.pathname === '/';
---

{isHome && (
  <section class="docs-home-hero" aria-labelledby="_top">
    <h1 id="_top" aria-label={title}>
      <span class="docs-home-title-line">Digital workers</span>
      <span class="docs-home-title-line">built on Consuelo</span>
    </h1>
    {description && <p class="docs-home-description">{description}</p>}
    <div class="docs-home-actions" aria-label="Documentation shortcuts">
      <a class="docs-home-primary" href="/start/">Get started</a>
      <a href="/connect/">Connect an agent</a>
      <a href="/tools/">Browse tools</a>
    </div>
  </section>
)}

{
  !isHome && breadcrumbs.length > 0 && (
    <nav class="page-breadcrumbs" aria-label="Breadcrumb">
      <ol>
        {breadcrumbs.map((crumb, index) => (
          <li>
            {index > 0 && <span class="breadcrumb-separator" aria-hidden="true">/</span>}
            {crumb.current || !crumb.href ? (
              <span aria-current={crumb.current ? 'page' : undefined}>{crumb.label}</span>
            ) : (
              <a href={crumb.href}>{crumb.label}</a>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )
}

{!isHome && (<div class="page-title-row">
  <h1 id="_top">{title}</h1>
  <div class="page-title-controls">
    <div class="page-actions" data-markdown-href={markdownHref} data-copy-state="">
    <button type="button" class="copy-page" data-page-action="copy">
      <svg class="page-action-icon" aria-hidden="true" viewBox="0 0 24 24">
        <rect x="9" y="9" width="11" height="11" rx="2" />
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
      </svg>
      <span>Copy page</span>
    </button>
    <details>
      <summary aria-label="More page actions" title="More page actions">
        <svg class="page-action-chevron" aria-hidden="true" viewBox="0 0 24 24">
          <path d="m8 10 4 4 4-4" />
        </svg>
        <svg class="page-action-success-icon" aria-hidden="true" viewBox="0 0 24 24">
          <path d="m5 12 4 4L19 6" />
        </svg>
      </summary>
      <div class="page-actions-menu" aria-label="Page actions">
        <button type="button" class="page-action-item" data-page-action="copy">
          <svg class="page-action-icon" aria-hidden="true" viewBox="0 0 24 24">
            <rect x="9" y="9" width="11" height="11" rx="2" />
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
          </svg>
          <span class="page-action-copy">
            <strong>Copy page</strong>
            <small>Copy page as Markdown for LLMs</small>
          </span>
        </button>
        <a class="page-action-item" href={markdownHref}>
          <svg class="page-action-icon" aria-hidden="true" viewBox="0 0 24 24">
            <path d="M4 4h16v16H4z" />
            <path d="m7 15 2.5-3 2 2 2.5-4 3 5" />
          </svg>
          <span class="page-action-copy">
            <strong>View as Markdown</strong>
            <small>Open this page as plain text</small>
          </span>
        </a>
        <a
          class="page-action-item"
          href="https://chatgpt.com/"
          target="_blank"
          rel="noopener noreferrer"
          data-page-action="chatgpt"
        >
          <svg class="page-action-icon" aria-hidden="true" viewBox="0 0 24 24">
            <path d="M12 3a4 4 0 0 1 3.5 2 4 4 0 0 1 4 6.5 4 4 0 0 1-3.5 6 4 4 0 0 1-7 0 4 4 0 0 1-3.5-6A4 4 0 0 1 9.5 5 4 4 0 0 1 12 3Z" />
            <path d="m8.5 9 7 4M8.5 15l7-4M12 7v10" />
          </svg>
          <span class="page-action-copy">
            <strong>Open in ChatGPT</strong>
            <small>Copy this page and open ChatGPT</small>
          </span>
        </a>
        <a
          class="page-action-item"
          href="https://claude.ai/new"
          target="_blank"
          rel="noopener noreferrer"
          data-page-action="claude"
        >
          <svg class="page-action-icon" aria-hidden="true" viewBox="0 0 24 24">
            <path d="M12 3 9.8 8.2 4 7l3.5 4.8L4 17l5.8-1.2L12 21l2.2-5.2L20 17l-3.5-5.2L20 7l-5.8 1.2Z" />
          </svg>
          <span class="page-action-copy">
            <strong>Open in Claude</strong>
            <small>Copy this page and open Claude</small>
          </span>
        </a>
      </div>
    </details>
      <span class="action-status" aria-live="polite"></span>
    </div>
    {hasToc && (
      <button
        class="page-toc-trigger"
        type="button"
        aria-controls="docs-mobile-toc-sheet"
        aria-expanded="false"
        data-docs-toc-trigger
      >
        On this page
      </button>
    )}
  </div>
</div>)}

<script>
  async function copyText(text) {
    try {
      await navigator.clipboard.writeText(text);
      return;
    } catch {}
    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.setAttribute('readonly', '');
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.append(textarea);
    textarea.select();
    document.execCommand('copy');
    textarea.remove();
  }

  document.addEventListener('click', async (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const button = target.closest('[data-home-install-copy]');
    if (!(button instanceof HTMLButtonElement)) return;
    const container = button.closest('[data-home-install-command]');
    if (!(container instanceof HTMLElement)) return;
    const command = container.dataset.command || Array.from(container.childNodes)
      .filter((node) => node.nodeType === Node.TEXT_NODE)
      .map((node) => node.textContent?.trim() || '')
      .find(Boolean);
    if (!command) return;
    await copyText(command);
    button.dataset.copied = 'true';
    button.setAttribute('aria-label', 'Install command copied');
    window.setTimeout(() => {
      delete button.dataset.copied;
      button.setAttribute('aria-label', 'Copy install command');
    }, 1400);
  });

  document.querySelectorAll('.page-actions').forEach((actions) => {
    if (!(actions instanceof HTMLElement)) return;
    const markdownHref = actions.dataset.markdownHref;
    const details = actions.querySelector('details');
    const status = actions.querySelector('.action-status');

    let copySuccessTimer;
    const setStatus = (message) => {
      if (status) status.textContent = message;
      window.setTimeout(() => {
        if (status?.textContent === message) status.textContent = '';
      }, 3000);
    };

    const setCopySuccess = () => {
      actions.dataset.copyState = 'success';
      if (copySuccessTimer) window.clearTimeout(copySuccessTimer);
      copySuccessTimer = window.setTimeout(() => {
        if (actions.dataset.copyState === 'success') actions.dataset.copyState = '';
      }, 1600);
    };

    const copyPage = async () => {
      if (!markdownHref) throw new Error('Missing Markdown page URL');
      const response = await fetch(markdownHref);
      if (!response.ok) throw new Error(`Markdown request failed: ${response.status}`);
      const markdown = await response.text();
      await copyText(markdown);
    };

    actions.addEventListener('click', async (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const control = target.closest('[data-page-action]');
      if (!(control instanceof HTMLElement)) return;
      const action = control.dataset.pageAction;
      try {
        await copyPage();
        if (action === 'copy') {
          setCopySuccess();
          setStatus('Page copied');
        } else if (action === 'chatgpt' || action === 'claude') {
          setStatus(`Page copied — paste it into ${action === 'chatgpt' ? 'ChatGPT' : 'Claude'}`);
        }
        if (details instanceof HTMLDetailsElement) details.open = false;
      } catch {
        if (copySuccessTimer) window.clearTimeout(copySuccessTimer);
        actions.dataset.copyState = '';
        setStatus('Could not copy this page');
      }
    });

    document.addEventListener('click', (event) => {
      if (
        details instanceof HTMLDetailsElement &&
        event.target instanceof Node &&
        !actions.contains(event.target)
      ) {
        details.open = false;
      }
    });

    actions.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && details instanceof HTMLDetailsElement) {
        details.open = false;
        details.querySelector('summary')?.focus();
      }
    });
  });
</script>

<style>
  @layer starlight.core {
    .page-breadcrumbs {
      color: var(--sl-color-gray-3);
      font-size: var(--sl-text-xs);
      margin-top: 0.25rem;
    }

    .page-breadcrumbs ol {
      align-items: center;
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .page-breadcrumbs li {
      align-items: center;
      display: inline-flex;
      gap: 0.45rem;
    }

    .page-breadcrumbs a {
      color: inherit;
      text-decoration: none;
    }

    .page-breadcrumbs a:hover,
    .page-breadcrumbs a:focus-visible,
    .page-breadcrumbs [aria-current='page'] {
      color: var(--sl-color-white);
    }

    .breadcrumb-separator {
      color: var(--sl-color-gray-5);
    }

    .docs-home-hero {
      display: grid;
      gap: 1.25rem;
      padding: clamp(2rem, 7vw, 5.5rem) 0 clamp(1rem, 3vw, 2rem);
    }

    .docs-home-hero h1 {
      font-size: clamp(2.8rem, 8vw, 5.25rem);
      letter-spacing: -0.045em;
      line-height: 0.98;
      margin: 0;
      max-width: none;
    }

    .docs-home-title-line {
      display: block;
      white-space: nowrap;
    }

    .docs-home-description {
      color: var(--docs-muted);
      font-size: clamp(1.05rem, 2.4vw, 1.35rem);
      line-height: 1.55;
      margin: 0;
      max-width: 42rem;
    }

    .docs-home-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.7rem;
      margin-top: 0.35rem;
    }

    .docs-home-actions a {
      align-items: center;
      border: 1px solid var(--docs-line-strong);
      border-radius: 0.55rem;
      color: var(--docs-ink);
      display: inline-flex;
      font-size: var(--sl-text-sm);
      font-weight: 600;
      justify-content: center;
      min-height: 2.8rem;
      padding: 0 1rem;
      text-decoration: none;
    }

    .docs-home-actions a:hover,
    .docs-home-actions a:focus-visible {
      border-color: var(--docs-accent);
      color: var(--docs-accent);
    }

    .docs-home-actions .docs-home-primary {
      background: var(--docs-ink);
      border-color: var(--docs-ink);
      color: var(--docs-paper);
    }

    .docs-home-actions .docs-home-primary:hover,
    .docs-home-actions .docs-home-primary:focus-visible {
      background: var(--docs-accent);
      border-color: var(--docs-accent);
      color: var(--docs-paper);
    }

    .page-title-row {
      align-items: flex-start;
      display: flex;
      gap: 1.5rem;
      justify-content: space-between;
    }

    .page-title-controls {
      align-items: center;
      display: flex;
      flex: 0 0 auto;
      gap: 0.65rem;
      margin-top: 1rem;
    }

    h1 {
      color: var(--sl-color-white);
      font-size: var(--sl-text-h1);
      font-weight: 600;
      line-height: 1.12;
      margin-top: 1rem;
      max-width: 26ch;
    }

    .page-actions {
      align-items: stretch;
      background: var(--sl-color-bg-nav);
      border: 1px solid var(--sl-color-hairline-light);
      border-radius: 0.5rem;
      box-sizing: border-box;
      display: flex;
      flex: 0 0 auto;
      min-height: 2.5rem;
      position: relative;
    }

    .copy-page,
    summary {
      align-items: center;
      background: transparent;
      border: 0;
      box-sizing: border-box;
      color: var(--sl-color-white);
      display: inline-flex;
      height: 2.5rem;
      min-height: 2.5rem;
    }

    .copy-page {
      border-radius: 0.45rem 0 0 0.45rem;
      cursor: pointer;
      font: inherit;
      font-size: var(--sl-text-sm);
      font-weight: 600;
      gap: 0.45rem;
      padding: 0 0.75rem;
    }

    details {
      display: flex;
      margin: 0;
      position: relative;
    }

    summary {
      border-inline-start: 1px solid var(--sl-color-hairline-light);
      border-radius: 0 0.45rem 0.45rem 0;
      cursor: pointer;
      justify-content: center;
      list-style: none;
      min-width: 2.5rem;
      padding: 0 0.55rem;
    }

    summary::-webkit-details-marker {
      display: none;
    }

    summary > svg,
    .page-action-icon {
      fill: none;
      flex: 0 0 auto;
      height: 1rem;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-width: 1.75;
      width: 1rem;
    }

    .page-action-success-icon {
      display: none;
    }

    .page-actions[data-copy-state='success'] {
      background: #16a34a;
      border-color: #16a34a;
      color: #fff;
    }

    .page-actions[data-copy-state='success'] .copy-page,
    .page-actions[data-copy-state='success'] summary {
      color: #fff;
    }

    .page-actions[data-copy-state='success'] .page-action-chevron {
      display: none;
    }

    .page-actions[data-copy-state='success'] .page-action-success-icon {
      display: block;
    }

    .copy-page:hover,
    .copy-page:focus-visible,
    summary:hover,
    summary:focus-visible {
      background: var(--docs-panel);
    }

    .copy-page:focus:not(:focus-visible),
    summary:focus:not(:focus-visible),
    .page-action-item:focus:not(:focus-visible) {
      outline: none;
    }

    details:not([open]) .page-actions-menu {
      display: none;
    }

    details[open] .page-actions-menu {
      display: grid;
    }

    .page-actions-menu {
      background: var(--sl-color-bg-nav);
      border: 1px solid var(--sl-color-hairline-light);
      border-radius: 0.65rem;
      box-shadow: var(--sl-shadow-md);
      min-width: 18.5rem;
      padding: 0.35rem;
      position: absolute;
      right: 0;
      top: calc(100% + 0.45rem);
      z-index: 20;
    }

    .page-action-item {
      align-items: flex-start;
      background: transparent;
      border: 0;
      border-radius: 0.4rem;
      color: var(--sl-color-white);
      cursor: pointer;
      display: grid;
      font: inherit;
      gap: 0.65rem;
      grid-template-columns: 1rem 1fr;
      padding: 0.6rem 0.65rem;
      text-align: left;
      text-decoration: none;
      width: 100%;
    }

    .page-action-item:hover,
    .page-action-item:focus-visible {
      background: var(--sl-color-gray-6);
    }

    .page-action-item .page-action-icon {
      color: var(--sl-color-gray-2);
      margin-top: 0.15rem;
    }

    .page-action-copy {
      display: grid;
      gap: 0.1rem;
      line-height: 1.25;
    }

    .page-action-copy strong {
      font-size: var(--sl-text-sm);
      font-weight: 500;
    }

    .page-action-copy small {
      color: var(--sl-color-gray-3);
      font-size: var(--sl-text-xs);
      font-weight: 400;
    }

    .action-status {
      height: 1px;
      overflow: hidden;
      position: absolute;
      width: 1px;
    }

    .page-toc-trigger {
      align-items: center;
      background: transparent;
      border: 1px solid var(--sl-color-hairline-light);
      border-radius: 0.5rem;
      color: var(--sl-color-white);
      cursor: pointer;
      display: inline-flex;
      font: inherit;
      font-size: var(--sl-text-sm);
      font-weight: 500;
      justify-content: center;
      min-height: 2.5rem;
      padding: 0 0.8rem;
      white-space: nowrap;
    }

    .page-toc-trigger:hover,
    .page-toc-trigger:focus-visible {
      border-color: var(--docs-line-strong);
      color: var(--docs-accent);
    }

    @media (max-width: 71.999rem) {
      .page-title-row {
        display: grid;
        gap: 0.7rem;
      }

      .page-title-controls {
        align-items: center;
        justify-content: space-between;
        margin-top: 0.35rem;
        order: -1;
        width: 100%;
      }

      h1 {
        margin-top: 0.8rem;
      }

      .docs-home-hero {
        padding-top: 2.5rem;
      }
    }

    @media (min-width: 72rem) {
      .page-toc-trigger {
        display: none;
      }
    }

    @media (max-width: 35rem) {
      h1 {
        max-width: none;
      }

      .page-actions-menu {
        left: 0;
        min-width: min(18.5rem, calc(100vw - 2.5rem));
        right: auto;
      }

    }
  }
</style>
