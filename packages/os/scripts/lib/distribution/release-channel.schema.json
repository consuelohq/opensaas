{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consuelohq.com/schemas/consuelo-os-release-channel-v1.json",
  "title": "Consuelo OS signed release channel manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payload",
    "signature"
  ],
  "properties": {
    "payload": {
      "$ref": "#/$defs/payload"
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reference"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "archiveDigest",
        "bundleId",
        "cloudflareObjectKey",
        "githubAssetName",
        "platform"
      ],
      "properties": {
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "archiveDigest": {
          "$ref": "#/$defs/sha256"
        },
        "bundleId": {
          "$ref": "#/$defs/sha256"
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "caddy-worker-pool",
              "canonical-watchdog",
              "public-connector-readiness",
              "stateless-mcp-2026",
              "supervised-worker-pool"
            ]
          }
        },
        "cloudflareObjectKey": {
          "type": "string",
          "minLength": 1
        },
        "githubAssetName": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundleId",
        "channel",
        "evidence",
        "kind",
        "platforms",
        "promotedAt",
        "releaseFingerprint",
        "revision",
        "schemaVersion",
        "sourceChannel",
        "sourceCommit",
        "version"
      ],
      "properties": {
        "bundleId": {
          "$ref": "#/$defs/sha256"
        },
        "channel": {
          "enum": [
            "dev",
            "canary",
            "beta",
            "stable"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "kind": {
          "const": "consuelo-os-channel-manifest"
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/platform"
          }
        },
        "promotedAt": {
          "type": "string",
          "format": "date-time"
        },
        "releaseFingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "schemaVersion": {
          "const": 1
        },
        "sourceChannel": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "dev",
                "canary",
                "beta",
                "stable"
              ]
            }
          ]
        },
        "sourceCommit": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/$defs/semver"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "keyId",
        "signature",
        "signedAt"
      ],
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "keyId": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "string",
          "minLength": 1
        },
        "signedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
