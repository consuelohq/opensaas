{
  "name": "@consuelo/lead-connector",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "tags": ["scope:backend", "scope:frontend"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "packages/lead-connector",
        "commands": ["bun run build"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "packages/lead-connector",
        "commands": ["bun run typecheck"]
      }
    }
  }
}
