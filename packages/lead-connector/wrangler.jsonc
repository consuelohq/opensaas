{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "consuelo-lead-connector-embed",
  "compatibility_date": "2026-07-24",
  "main": "./src/embed/cloudflare-worker.ts",
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "calls.consuelohq.com",
      "custom_domain": true,
    },
    {
      "pattern": "calls.consuelohq.com/*",
      "zone_name": "consuelohq.com",
    },
  ],
  "assets": {
    "directory": "./dist/embed-app",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
}
