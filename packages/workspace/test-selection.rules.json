{
  "version": 1,
  "rules": [
    {
      "id": "workspace-facade",
      "critical": true,
      "source": [
        "packages/workspace/scripts/lib/facade/**",
        "packages/workspace/tooling/tool-manifest.json",
        "packages/workspace/src/generated/workspace.d.ts"
      ],
      "tests": [
        {
          "name": "workspace facade input contracts",
          "command": [
            "bun",
            "test",
            "packages/workspace/tests/facade/facade.test.ts",
            "--test-name-pattern",
            "validates input"
          ]
        }
      ],
      "reason": "Workspace facade and manifest changes must prove typed tool input contracts."
    },
    {
      "id": "workspace-publish-gate",
      "critical": true,
      "source": [
        "packages/workspace/scripts/verify.js",
        "packages/workspace/scripts/review.js",
        "packages/workspace/scripts/task-push.js",
        "packages/workspace/scripts/lib/verification.js"
      ],
      "tests": [
        {
          "name": "workspace verification stamp tests",
          "command": [
            "bun",
            "x",
            "vitest",
            "run",
            "packages/workspace/tests/verification.test.js"
          ]
        }
      ],
      "reason": "Review, verify, and task push changes must prove publish-gate behavior."
    },
    {
      "id": "workspace-task-session",
      "critical": true,
      "source": [
        "packages/workspace/scripts/task-start.js",
        "packages/workspace/scripts/task-pr.js",
        "packages/workspace/scripts/task-finish.js",
        "packages/workspace/scripts/task-init.js",
        "packages/workspace/scripts/lib/task-selection*.js",
        "packages/workspace/scripts/lib/task-metadata*.js"
      ],
      "tests": [
        {
          "name": "workspace task session tests",
          "command": [
            "bun",
            "test",
            "packages/workspace/tests/task-session.test.js",
            "packages/workspace/tests/task-meta.test.ts"
          ]
        }
      ],
      "reason": "Task routing and metadata changes must prove task-session behavior."
    },
    {
      "id": "workspace-test-selection",
      "critical": true,
      "source": [
        "packages/workspace/scripts/test-selection.js",
        "packages/workspace/test-selection.rules.json",
        "packages/workspace/test-selection.registry.json",
        "packages/workspace/tests/test-selection.test.js"
      ],
      "tests": [
        {
          "name": "workspace test selection tests",
          "command": [
            "bun",
            "x",
            "vitest",
            "run",
            "packages/workspace/tests/test-selection.test.js"
          ]
        }
      ],
      "reason": "Test-selection logic must prove discovery, mapping, and zero-suite policy."
    },
    {
      "id": "trace-watch",
      "critical": true,
      "source": [
        "packages/os/scripts/trace-watch.ts"
      ],
      "tests": [
        {
          "name": "OS trace watcher behavior",
          "command": [
            "bun",
            "--cwd",
            "packages/os",
            "test",
            "tests/trace-watch.test.ts"
          ]
        }
      ],
      "reason": "OS trace watcher changes must preserve terminal rendering, canonical sidecar resolution, and real SQLite CLI behavior."
    },
    {
      "id": "workspace-audit-docs",
      "critical": false,
      "source": [
        "packages/workspace/SCRIPTS.md",
        "packages/workspace/TOOLS.md",
        "packages/workspace/scripts/audit.js",
        "packages/workspace/tests/audit/**"
      ],
      "tests": [
        {
          "name": "workspace audit tests",
          "command": [
            "bun",
            "x",
            "vitest",
            "run",
            "packages/workspace/tests/audit/audit.test.ts"
          ]
        }
      ],
      "reason": "Workspace script/docs changes should keep audit behavior covered."
    },
    {
      "id": "consuelo-ci-immutable-base",
      "critical": true,
      "source": [
        ".github/workflows/consuelo-ci.yaml",
        "packages/os/tests/local-os-server-review-findings.test.ts"
      ],
      "tests": [
        {
          "name": "Consuelo CI immutable base and local server review contracts",
          "command": [
            "bun",
            "--cwd",
            "packages/os",
            "test",
            "tests/local-os-server-review-findings.test.ts"
          ]
        }
      ],
      "reason": "Consuelo pull-request verification must use an immutable base commit and preserve the focused local OS server review contracts without selecting the broad OS package suite."
    },
    {
      "id": "trace-site-pagination",
      "critical": true,
      "source": [
        "packages/os/assets/vendor/observability-traces-v38/inspector.js",
        "packages/os/package.json",
        "packages/os/scripts/lib/observability-traces-site.ts",
        "packages/os/scripts/lib/trace-site-inspector/**",
        "packages/os/scripts/lib/trace-sites-gateway-*.ts",
        "packages/os/scripts/lib/trace-sites-local-read-backend.ts",
        "packages/os/scripts/lib/trace-persistence.ts",
        "packages/os/scripts/lib/redaction.ts",
        "packages/os/scripts/server/services/trace-gateway.ts",
        "packages/os/tests/observability-traces-site.test.ts",
        "packages/os/tests/redaction.test.ts",
        "packages/os/tests/trace-history-redaction.test.ts",
        "packages/os/tests/trace-site-inspector-os-owned.test.ts",
        "packages/os/tests/trace-sites-gateway-read-layer.test.ts",
        "packages/os/tests/trace-sites-history-endpoint-contract.test.ts",
        "packages/os/tests/trace-sites-runtime-boundary.test.ts",
        "packages/os/assets/vendor/observability-traces-v38/**",
        "packages/os/tests/fixtures/trace-persistence-runtime.ts",
        "packages/os/scripts/lib/distribution/runtime-bundle.ts",
        "packages/os/tests/runtime-bundle-managed-site-assets.test.ts",
        "packages/os/tests/trace-site-inspector-interactions.test.ts"
      ],
      "tests": [
        {
          "name": "OS trace gateway and Trace Burn contracts",
          "command": [
            "bun",
            "node_modules/vitest/vitest.mjs",
            "run",
            "--root",
            "packages/os",
            "tests/trace-sites-history-endpoint-contract.test.ts",
            "tests/trace-sites-gateway-read-layer.test.ts",
            "tests/trace-history-redaction.test.ts",
            "tests/trace-site-inspector-os-owned.test.ts",
            "tests/observability-traces-site.test.ts",
            "tests/redaction.test.ts",
            "tests/runtime-bundle-managed-site-assets.test.ts"
          ]
        },
        {
          "name": "OS canonical TraceStore runtime boundary",
          "command": [
            "bun",
            "--cwd",
            "packages/os",
            "test",
            "tests/trace-sites-runtime-boundary.test.ts"
          ]
        }
      ],
      "reason": "Current OS Trace gateway and Trace Burn changes must prove authenticated history paging, canonical TraceStore resolution, safe redaction, and OS-owned virtual-list/browser behavior."
    },
    {
      "id": "os-workspace-edge-rollout",
      "critical": true,
      "source": [
        "packages/os/scripts/lib/install-edge-site-publisher.ts",
        "packages/os/scripts/lib/workspace-edge-route-seed.ts",
        "packages/os/tests/install-edge-site-publisher.test.ts",
        "packages/os/tests/workspace-edge-route-seed-contract.test.ts",
        "packages/os/tests/workspace-edge-sites-gateway-integration.test.ts"
      ],
      "tests": [
        {
          "name": "OS workspace edge snapshot publisher contracts",
          "command": [
            "env",
            "CONSUELO_RUN_WORKSPACE_GATEWAY_CONTRACTS=1",
            "bun",
            "--cwd",
            "packages/os",
            "../../node_modules/vitest/vitest.mjs",
            "run",
            "tests/install-edge-site-publisher.test.ts"
          ]
        },
        {
          "name": "OS workspace edge route preservation contracts",
          "command": [
            "env",
            "CONSUELO_RUN_WORKSPACE_GATEWAY_CONTRACTS=1",
            "bun",
            "--cwd",
            "packages/os",
            "../../node_modules/vitest/vitest.mjs",
            "run",
            "tests/workspace-edge-route-seed-contract.test.ts",
            "tests/workspace-edge-sites-gateway-integration.test.ts"
          ]
        }
      ],
      "reason": "Workspace edge rollout changes must preserve immutable snapshots and live node/connector route state without relying on a broad package test."
    },
    {
      "id": "os-lifecycle-legacy-mcp-scrub",
      "critical": true,
      "source": [
        "packages/os/scripts/consuelo-reload.js",
        "packages/os/tests/finish-line-lifecycle-contract.test.ts",
        "packages/os/scripts/start-consuelo-daemon.sh",
        "packages/os/tests/daemon-bun-path.test.ts"
      ],
      "tests": [
        {
          "name": "OS lifecycle legacy MCP environment scrub contract",
          "command": [
            "bun",
            "--cwd",
            "packages/os",
            "../../node_modules/vitest/vitest.mjs",
            "run",
            "tests/finish-line-lifecycle-contract.test.ts",
            "tests/daemon-bun-path.test.ts"
          ]
        }
      ],
      "reason": "Lifecycle daemon/reload changes must prove inherited-secret scrub, activated-runtime managed Sites refresh, Bun path resolution, and fail-open startup without selecting the broad OS package suite."
    },
    {
      "id": "frontend-lint-config-contract",
      "critical": true,
      "exclusive": true,
      "source": [
        ".github/workflows/ci-front.yaml",
        "eslint.config.mjs",
        "packages/eslint-rules/eslint.config.react.mjs",
        "packages/twenty-front/eslint.config.mjs",
        "packages/twenty-shared/eslint.config.mjs",
        "packages/twenty-ui/eslint.config.mjs",
        "packages/workspace/scripts/ci/lint-changed-frontend-files.mjs",
        "packages/workspace/tests/lint-changed-frontend-files.test.mjs",
        "packages/workspace/scripts/ci/run-changed-frontend-task.mjs",
        "packages/workspace/tests/run-changed-frontend-task.test.mjs",
        ".github/workflows/ci-shared.yaml"
      ],
      "tests": [
        {
          "name": "changed frontend lint helper tests",
          "command": [
            "node",
            "--test",
            "packages/workspace/tests/lint-changed-frontend-files.test.mjs",
            "packages/workspace/tests/run-changed-frontend-task.test.mjs"
          ]
        },
        {
          "name": "GitHub workflow policy tests",
          "command": [
            "bun",
            "test",
            "packages/workspace/tests/github-workflow-policy.test.js"
          ]
        },
        {
          "name": "changed GitHub workflow security checks",
          "command": [
            "node",
            "packages/workspace/scripts/ci/check-github-workflows.cjs"
          ]
        },
        {
          "name": "changed frontend files lint",
          "command": [
            "node",
            "packages/workspace/scripts/ci/lint-changed-frontend-files.mjs"
          ]
        }
      ],
      "reason": "Frontend lint configuration and workflow-only changes must validate their exact configs, workflow policy, and changed-file lint lane without selecting unrelated full application test targets."
    },
    {
      "id": "obsolete-metering-artifact-contract",
      "critical": true,
      "exclusive": true,
      "source": [
        "packages/os/scripts/artifacts-design.ts",
        "packages/os/tests/artifacts-legacy-contract.test.ts"
      ],
      "tests": [
        {
          "name": "OS artifact manifest contract",
          "command": [
            "bun",
            "x",
            "vitest",
            "run",
            "packages/os/tests/artifacts-legacy-contract.test.ts"
          ]
        }
      ],
      "reason": "Removal of the obsolete metering package from the deployed artifact manifest must retain the canonical Artifacts boundary without selecting unrelated OS suites."
    },
    {
      "id": "native-os-workflow-contract",
      "critical": true,
      "exclusive": true,
      "source": [
        ".github/workflows/consuelo-os-distribution-environments.yaml",
        "packages/workspace/scripts/ci/run-changed-os-native-tests.mjs",
        "packages/workspace/tests/run-changed-os-native-tests.test.mjs",
        "packages/workspace/tests/github-workflow-policy.test.js",
        "packages/os/tests/windows-platform.test.ts"
      ],
      "tests": [
        {
          "name": "native OS selector tests",
          "command": [
            "node",
            "--test",
            "packages/workspace/tests/run-changed-os-native-tests.test.mjs"
          ]
        },
        {
          "name": "native Windows workflow contracts",
          "command": [
            "bun",
            "x",
            "vitest",
            "run",
            "packages/os/tests/windows-platform.test.ts",
            "packages/os/tests/windows-bootstrap-source.test.ts"
          ]
        },
        {
          "name": "GitHub workflow policy tests",
          "command": [
            "bun",
            "test",
            "packages/workspace/tests/github-workflow-policy.test.js"
          ]
        },
        {
          "name": "changed GitHub workflow security checks",
          "command": [
            "node",
            "packages/workspace/scripts/ci/check-github-workflows.cjs"
          ]
        }
      ],
      "reason": "Native OS distribution workflow and selector changes must run their exact cross-platform contracts without selecting unrelated full OS package tests."
    },
    {
      "id": "dialer-package",
      "critical": true,
      "source": [
        "packages/dialer/**"
      ],
      "tests": [
        {
          "name": "dialer specs",
          "command": [
            "bun",
            "test",
            "packages/dialer/src"
          ]
        }
      ],
      "reason": "Dialer changes are call-path critical and must run package specs."
    },
    {
      "id": "dialer-server-package",
      "critical": true,
      "source": [
        "packages/dialer-server/**"
      ],
      "tests": [
        {
          "name": "dialer-server Hono contracts",
          "command": [
            "bun",
            "test",
            "packages/dialer-server/src"
          ]
        }
      ],
      "reason": "Dialer server changes must prove Hono transport, Twilio boundary, and standalone lifecycle contracts."
    },
    {
      "id": "lead-connector-package",
      "critical": true,
      "source": [
        "packages/lead-connector/**"
      ],
      "tests": [
        {
          "name": "LeadConnector provider contracts",
          "command": [
            "bun",
            "test",
            "packages/lead-connector/src"
          ]
        }
      ],
      "reason": "LeadConnector provider changes must prove OAuth, token, resource, webhook, architecture, and branding contracts."
    },
    {
      "id": "coaching-package-contract",
      "critical": true,
      "source": [
        "packages/coaching/**"
      ],
      "tests": [
        {
          "name": "coaching package declaration contract",
          "command": [
            "bun",
            "test",
            "packages/coaching/package-contract.test.ts"
          ]
        }
      ],
      "reason": "Coaching package changes must emit the declaration artifact advertised by package.json so clean consumers can typecheck."
    },
    {
      "id": "server-ci-task-contract",
      "critical": true,
      "source": [
        ".github/workflows/ci-server.yaml",
        "packages/workspace/scripts/ci/run-changed-server-task.mjs",
        "packages/workspace/tests/run-changed-server-task.test.mjs",
        "packages/workspace/tests/typeorm-cli-contract.test.mjs",
        "packages/workspace/tests/github-workflow-policy.test.js",
        "packages/twenty-server/project.json",
        "packages/workspace/test-selection.rules.json",
        "packages/workspace/test-selection.registry.json"
      ],
      "tests": [
        {
          "name": "changed server task selector tests",
          "command": [
            "node",
            "--test",
            "packages/workspace/tests/run-changed-server-task.test.mjs"
          ]
        },
        {
          "name": "GitHub workflow policy tests",
          "command": [
            "bun",
            "test",
            "packages/workspace/tests/github-workflow-policy.test.js"
          ]
        },
        {
          "name": "TypeORM CLI compatibility contract",
          "command": [
            "node",
            "--test",
            "packages/workspace/tests/typeorm-cli-contract.test.mjs"
          ]
        }
      ],
      "reason": "Server CI changes must scope lint and typecheck to directly changed Twenty server runtime files while retaining dependency propagation."
    },
    {
      "id": "api-package",
      "critical": true,
      "source": [
        "packages/api/**"
      ],
      "tests": [
        {
          "name": "api specs",
          "command": [
            "bunx",
            "jest",
            "--config",
            "packages/api/jest.config.mjs",
            "--runInBand"
          ]
        }
      ],
      "reason": "API changes must run API route and service specs."
    },
    {
      "id": "twenty-server-project",
      "critical": true,
      "source": [
        "packages/twenty-server/**",
        "packages/twenty-server/src/engine/**/*.resolver.ts",
        "packages/twenty-server/src/**/migrations/**"
      ],
      "tests": [
        {
          "name": "twenty-server affected test target",
          "command": [
            "npx",
            "nx",
            "test",
            "twenty-server"
          ]
        }
      ],
      "reason": "Server changes have the broadest backend impact and should run the project test target."
    },
    {
      "id": "twenty-front-project",
      "critical": false,
      "source": [
        "packages/twenty-front/**"
      ],
      "tests": [
        {
          "name": "twenty-front test target",
          "command": [
            "npx",
            "nx",
            "test",
            "twenty-front",
            "--coverage=false"
          ]
        }
      ],
      "reason": "Frontend package changes should run the project test target."
    }
  ]
}
