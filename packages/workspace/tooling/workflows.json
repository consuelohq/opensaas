{
  "version": 1,
  "workflows": [
    {
      "id": "task",
      "aliases": [
        "repo",
        "code"
      ],
      "roles": [
        "stream.context",
        "task.start",
        "workpad.write",
        "decision.research",
        "test.run",
        "diff.inspect",
        "validation.review",
        "validation.verify",
        "task.push",
        "task.pr",
        "task.finish",
        "tool.search"
      ],
      "subscriptions": [
        {
          "event": "workflow.intent.task.detected",
          "workflow": "task"
        },
        {
          "event": "tool.preInvoke",
          "workflow": "task",
          "tool": "stream.context"
        },
        {
          "event": "tool.postInvoke",
          "workflow": "task",
          "tool": "stream.context"
        },
        {
          "event": "tool.preInvoke",
          "workflow": "task",
          "tool": "task.start"
        },
        {
          "event": "tool.postInvoke",
          "workflow": "task",
          "tool": "task.start"
        },
        {
          "event": "workflow.stage.ready",
          "workflow": "task",
          "stage": "validation"
        },
        {
          "event": "tool.preInvoke",
          "workflow": "task",
          "tool": "task.push"
        },
        {
          "event": "tool.postInvoke",
          "workflow": "task",
          "tool": "task.push"
        },
        {
          "event": "tool.postInvoke",
          "workflow": "task",
          "tool": "task.pr"
        },
        {
          "event": "workflow.stage.ready",
          "workflow": "task",
          "stage": "task-finish"
        }
      ]
    }
  ]
}
