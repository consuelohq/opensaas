{
  "name": "@consuelo/dialer",
  "version": "0.0.1",
  "description": "Twilio-powered dialer with local presence and caller ID",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@consuelo/logger": "workspace:*",
    "effect": "^3.21.3"
  },
  "peerDependencies": {
    "ioredis": "^5.0.0",
    "twilio": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    },
    "twilio": {
      "optional": true
    }
  },
  "devDependencies": {
    "twilio": "^5.12.1",
    "typescript": "5.9.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
