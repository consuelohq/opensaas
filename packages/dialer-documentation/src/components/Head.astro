---
import DefaultHead from '@astrojs/starlight/components/Head.astro';
---

<DefaultHead />
{import.meta.env.PUBLIC_DOCS_PREVIEW === '1' && <meta name="robots" content="noindex,nofollow" />}
<meta property="og:image" content={new URL("/dialer-docs-social.png", Astro.site ?? Astro.url).href} />
<meta property="og:image:alt" content="Consuelo Dialer Docs — set up calling and keep your team connected." />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:image" content={new URL("/dialer-docs-social.png", Astro.site ?? Astro.url).href} />
<meta name="twitter:image:alt" content="Consuelo Dialer Docs — set up calling and keep your team connected." />

<script is:inline>
  (() => {
    const root = document.documentElement;
    root.dataset.docsInputModality = 'pointer';

    window.addEventListener(
      'pointerdown',
      () => {
        root.dataset.docsInputModality = 'pointer';
      },
      { capture: true },
    );

    window.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'Tab') root.dataset.docsInputModality = 'keyboard';
      },
      { capture: true },
    );
  })();
</script>
