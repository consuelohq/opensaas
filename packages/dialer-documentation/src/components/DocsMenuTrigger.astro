<docs-menu-trigger class="print:hidden" data-docs-menu-toggle aria-expanded="false">
  <button
    type="button"
    aria-expanded="false"
    aria-label="Open docs menu"
    aria-controls="starlight__sidebar"
  >
    <span class="docs-menu-dots" aria-hidden="true"><i></i><i></i><i></i></span>
  </button>
</docs-menu-trigger>

<script>
  import { gsap } from 'gsap';

  class DocsMenuTrigger extends HTMLElement {
    button: HTMLButtonElement | null = null;
    pane: HTMLElement | null = null;
    reducedMotion: MediaQueryList | null = null;
    desktopQuery: MediaQueryList | null = null;
    closing = false;

    connectedCallback() {
      if (this.dataset.bound === 'true') return;
      this.dataset.bound = 'true';
      this.button = this.querySelector('button');
      this.pane = document.querySelector('#starlight__sidebar') as HTMLElement | null;
      this.reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      this.desktopQuery = window.matchMedia('(min-width: 72rem)');
      this.button?.addEventListener('click', () => this.toggle());
      window.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && this.expanded) this.close(true);
      });
      this.pane?.addEventListener('click', (event) => {
        const target = event.target;
        if (target instanceof HTMLAnchorElement) this.close();
      });
      this.desktopQuery.addEventListener('change', () => this.syncViewport());
      this.syncViewport();
    }

    get expanded() {
      return this.getAttribute('aria-expanded') === 'true';
    }

    setExpanded(expanded: boolean) {
      this.setAttribute('aria-expanded', String(expanded));
      this.button?.setAttribute('aria-expanded', String(expanded));
      this.button?.setAttribute('aria-label', expanded ? 'Close docs menu' : 'Open docs menu');
      document.body.toggleAttribute('data-mobile-menu-expanded', expanded);
    }

    syncViewport() {
      if (!this.pane) return;
      if (this.desktopQuery?.matches) {
        this.setExpanded(false);
        this.pane.style.visibility = '';
        this.pane.style.pointerEvents = '';
        gsap.set(this.pane, { clearProps: 'transform' });
        return;
      }
      if (!this.expanded) {
        this.pane.style.visibility = 'hidden';
        this.pane.style.pointerEvents = 'none';
        gsap.set(this.pane, { xPercent: -100 });
      }
    }

    open() {
      if (!this.pane || this.desktopQuery?.matches) return;
      this.closing = false;
      this.pane.style.visibility = 'visible';
      this.pane.style.pointerEvents = 'auto';
      this.setExpanded(true);
      if (this.reducedMotion?.matches) {
        gsap.set(this.pane, { xPercent: 0 });
      } else {
        gsap.fromTo(this.pane, { xPercent: -100 }, { xPercent: 0, duration: 0.22, ease: 'power2.out' });
      }
    }

    close(restoreFocus = false) {
      if (!this.pane || !this.expanded || this.closing) return;
      this.closing = true;
      const finish = () => {
        this.setExpanded(false);
        this.pane!.style.visibility = 'hidden';
        this.pane!.style.pointerEvents = 'none';
        gsap.set(this.pane, { xPercent: -100 });
        this.closing = false;
        if (restoreFocus) this.button?.focus();
      };
      if (this.reducedMotion?.matches) {
        finish();
      } else {
        gsap.to(this.pane, { xPercent: -100, duration: 0.2, ease: 'power2.in', onComplete: finish });
      }
    }

    toggle() {
      this.expanded ? this.close() : this.open();
    }
  }

  if (!customElements.get('docs-menu-trigger')) customElements.define('docs-menu-trigger', DocsMenuTrigger);
</script>

<style>
  @layer starlight.core {
    docs-menu-trigger {
      display: inline-flex;
      flex: 0 0 auto;
    }

    button {
      align-items: center;
      background: transparent;
      border: 0;
      border-radius: 0.35rem;
      color: var(--sl-color-white);
      cursor: pointer;
      display: inline-flex;
      height: 2rem;
      justify-content: center;
      padding: 0 0.3rem;
      transition: background-color 150ms ease, color 150ms ease;
      width: 2.15rem;
    }

    button:hover,
    button:focus-visible {
      background: var(--docs-panel);
      color: var(--sl-color-white);
    }

    .docs-menu-dots {
      align-items: center;
      display: inline-flex;
      gap: 0.28rem;
    }

    .docs-menu-dots i {
      background: currentColor;
      border-radius: 999px;
      display: block;
      height: 0.24rem;
      width: 0.24rem;
    }

    @media (min-width: 72rem) {
      docs-menu-trigger {
        display: none;
      }
    }
  }
</style>
