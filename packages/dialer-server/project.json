{
  "name": "@consuelo/dialer-server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": [
    "scope:backend"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "cwd": "packages/dialer-server",
        "commands": [
          "bun run build"
        ]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "packages/dialer-server",
        "commands": [
          "bun run typecheck"
        ]
      }
    }
  }
}
