{
  "name": "@consuelo/dialer-server",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "test": "bun test src",
    "typecheck": "tsc --noEmit",
    "build": "mkdir -p ./dist && bun build ./src/main.ts --compile --outfile ./dist/dialer-server",
    "start": "./dist/dialer-server",
    "validate:local-runtime": "bun ./scripts/validate-local-runtime.ts",
    "validate:provider-test": "bun ./scripts/validate-provider-test.ts",
    "validate:groq-transcription": "bun ./scripts/validate-groq-transcription.ts"
  },
  "dependencies": {
    "@consuelo/dialer": "workspace:*",
    "@consuelo/lead-connector": "workspace:*",
    "effect": "^3.21.3",
    "hono": "^4.11.9",
    "ioredis": "5.6.0",
    "pg": "8.12.0",
    "twilio": "^5.12.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.11.10",
    "typescript": "5.9.2"
  }
}
