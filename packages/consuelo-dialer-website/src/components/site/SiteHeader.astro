---
import { dialerSiteHeaderLinks } from '../../data/site-navigation';

const [consueloLink, docsLink, pricingLink, featuresLink] = dialerSiteHeaderLinks.desktop;
const [mobileDocsLink, mobilePricingLink] = dialerSiteHeaderLinks.mobile;
---

<header class="dialer-header" data-dialer-header>
  <nav class="dialer-header__desktop" aria-label={dialerSiteHeaderLinks.primaryAriaLabel}>
    <a class="dialer-header__desktop-link" href={consueloLink.href}>{consueloLink.label}</a>
    <a class="dialer-header__desktop-link" href={docsLink.href}>{docsLink.label}</a>

    <div class="dialer-header__identity">
      <a class="dialer-header__wordmark" href="/" aria-label={dialerSiteHeaderLinks.wordmarkAriaLabel}>
        <span>CONSUELO</span>
        <span>DIALER</span>
      </a>
      <img class="dialer-header__mark" src="/favicon.svg" alt="" width="24" height="24" />
    </div>

    <a class="dialer-header__desktop-link" href={pricingLink.href}>{pricingLink.label}</a>
    <a class="dialer-header__desktop-link" href={featuresLink.href}>{featuresLink.label}</a>
  </nav>

  <nav class="dialer-header__mobile" aria-label={dialerSiteHeaderLinks.mobilePrimaryAriaLabel}>
    <a class="dialer-header__side-link" href={mobileDocsLink.href}>{mobileDocsLink.label}</a>
    <div class="dialer-header__mobile-identity">
      <a class="dialer-header__mobile-wordmark" href="/" aria-label={dialerSiteHeaderLinks.wordmarkAriaLabel}>
        <span>CONSUELO</span>
        <span>DIALER</span>
      </a>
      <img class="dialer-header__mark" src="/favicon.svg" alt="" width="24" height="24" />
    </div>
    <a class="dialer-header__side-link" href={mobilePricingLink.href}>{mobilePricingLink.label}</a>
  </nav>
</header>

<style>
  .dialer-header {
    position: absolute;
    inset: 0 0 auto;
    z-index: var(--site-z-header);
    color: white;
  }

  .dialer-header a {
    color: inherit;
    text-decoration: none;
  }

  .dialer-header__desktop {
    display: grid;
    grid-template-columns: 1fr 1fr 1.25fr 1fr 1fr;
    align-items: start;
    gap: 1rem;
    width: min(100%, 90rem);
    margin: 0 auto;
    padding: clamp(1.8rem, 4vw, 3.5rem) clamp(1.5rem, 4.8vw, 4rem);
    text-align: center;
  }

  .dialer-header__desktop-link {
    padding-block: 0.1rem;
    font-family: var(--site-font-mono);
    font-size: clamp(0.72rem, 0.95vw, 0.86rem);
    font-weight: 650;
    letter-spacing: 0.08em;
    line-height: 1;
  }

  .dialer-header__identity {
    display: grid;
    justify-items: center;
    gap: 0.62rem;
    margin-top: -0.15rem;
  }

  .dialer-header__wordmark,
  .dialer-header__mobile-wordmark {
    display: grid;
    justify-items: center;
    font-family: var(--site-font-display);
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .dialer-header__wordmark {
    row-gap: 0.14rem;
    font-size: clamp(2rem, 2.8vw, 2.5rem);
    line-height: 0.78;
  }

  .dialer-header__wordmark span:last-child,
  .dialer-header__mobile-wordmark span:last-child {
    justify-self: center;
    font-size: 0.7em;
    text-align: center;
  }

  .dialer-header__mark {
    width: 1.45rem;
    height: 1.45rem;
    border-radius: 0.28rem;
    object-fit: cover;
  }

  .dialer-header__desktop-link {
    transition: opacity var(--site-motion-fast);
  }

  .dialer-header__desktop-link:hover,
  .dialer-header__desktop-link:focus-visible {
    opacity: 0.68;
  }

  .dialer-header__mobile {
    display: none;
  }

  @media (max-width: 720px) {
    .dialer-header__desktop {
      display: none;
    }

    .dialer-header__mobile {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: start;
      padding: 1.55rem 1.1rem;
    }

    .dialer-header__mobile > :last-child {
      justify-self: end;
    }

    .dialer-header__side-link {
      padding-block: 0.1rem;
      font-family: var(--site-font-display);
      font-size: clamp(0.92rem, 4vw, 1.12rem);
      font-weight: 600;
      letter-spacing: 0.025em;
      line-height: 1;
    }

    .dialer-header__mobile-wordmark {
      row-gap: 0.12rem;
      font-size: clamp(1.7rem, 7.4vw, 2rem);
      line-height: 0.76;
    }

    .dialer-header__mobile-identity {
      display: grid;
      justify-items: center;
      gap: 0.5rem;
      margin-top: -0.1rem;
    }
  }
</style>
