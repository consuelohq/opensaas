---
type Props = {
  title: string;
  meta: string;
  rows: readonly string[];
  index: number;
};

const { title, meta, rows, index } = Astro.props;
---

<figure class="dialer-placeholder" aria-label={`${title} product demo placeholder`}>
  <figcaption>
    <span>FIG. {String(index).padStart(2, '0')}</span>
    <span>{meta}</span>
  </figcaption>

  <div class="dialer-placeholder__surface">
    <header>
      <div>
        <span class="dialer-placeholder__dot"></span>
        <span class="dialer-placeholder__dot"></span>
        <span class="dialer-placeholder__dot"></span>
      </div>
      <strong>{title}</strong>
      <span>LIVE DEMO PLACEHOLDER</span>
    </header>

    <div class="dialer-placeholder__body">
      <aside>
        <span>CRM</span>
        <span>QUEUE</span>
        <span>CALLS</span>
        <span>HISTORY</span>
      </aside>
      <div class="dialer-placeholder__rows">
        {rows.map((row, rowIndex) => (
          <div class:list={['dialer-placeholder__row', { 'is-active': rowIndex === index % rows.length }]}>
            <span>{String(rowIndex + 1).padStart(2, '0')}</span>
            <strong>{row}</strong>
            <i aria-hidden="true"></i>
          </div>
        ))}
      </div>
    </div>

    <p>REPLACE WITH PRODUCT FOOTAGE BEFORE PUBLIC LAUNCH</p>
  </div>
</figure>

<style>
  .dialer-placeholder {
    display: grid;
    width: 100%;
    min-width: 0;
    margin: 0;
    gap: 0.65rem;
  }

  .dialer-placeholder figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--site-color-brand);
    font: 620 0.58rem/1.3 var(--site-font-mono);
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .dialer-placeholder__surface {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--site-color-brand);
    background: color-mix(in srgb, var(--site-color-brand) 4%, white);
  }

  .dialer-placeholder__surface > header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    min-width: 0;
    border-bottom: 1px solid var(--site-color-brand);
    padding: 0.85rem;
    font: 650 0.56rem/1 var(--site-font-mono);
    letter-spacing: 0.08em;
  }

  .dialer-placeholder__surface > header > div {
    display: flex;
    gap: 0.3rem;
  }

  .dialer-placeholder__surface > header > span:last-child {
    justify-self: end;
    color: var(--site-color-muted);
    text-align: right;
  }

  .dialer-placeholder__dot {
    width: 0.42rem;
    height: 0.42rem;
    border: 1px solid var(--site-color-brand);
    border-radius: 50%;
  }

  .dialer-placeholder__body {
    display: grid;
    grid-template-columns: minmax(6.5rem, 0.24fr) minmax(0, 1fr);
    min-height: clamp(19rem, 36vw, 34rem);
  }

  .dialer-placeholder__body aside {
    display: grid;
    align-content: start;
    gap: 0.8rem;
    border-right: 1px solid var(--site-color-brand);
    padding: 1.2rem 0.8rem;
    font: 650 0.52rem/1 var(--site-font-mono);
    letter-spacing: 0.1em;
  }

  .dialer-placeholder__body aside span:first-child {
    color: var(--site-color-brand);
  }

  .dialer-placeholder__rows {
    display: grid;
    align-content: center;
    gap: 0.55rem;
    min-width: 0;
    padding: clamp(1rem, 3vw, 2.5rem);
  }

  .dialer-placeholder__row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) minmax(3rem, 0.25fr);
    align-items: center;
    gap: 0.8rem;
    min-width: 0;
    border: 1px solid var(--site-color-line-strong);
    background: white;
    padding: clamp(0.75rem, 1.5vw, 1.1rem);
    color: var(--site-color-ink);
    font-family: var(--site-font-mono);
  }

  .dialer-placeholder__row > span {
    color: var(--site-color-muted);
    font-size: 0.56rem;
  }

  .dialer-placeholder__row strong {
    min-width: 0;
    overflow-wrap: anywhere;
    font-size: clamp(0.62rem, 0.85vw, 0.78rem);
    letter-spacing: 0.06em;
  }

  .dialer-placeholder__row i {
    height: 0.32rem;
    background: var(--site-color-line);
  }

  .dialer-placeholder__row.is-active {
    background: var(--site-color-brand);
    color: white;
  }

  .dialer-placeholder__row.is-active > span {
    color: rgba(255, 255, 255, 0.7);
  }

  .dialer-placeholder__row.is-active i {
    background: white;
  }

  .dialer-placeholder__surface > p {
    margin: 0;
    border-top: 1px solid var(--site-color-brand);
    padding: 0.7rem 0.85rem;
    color: var(--site-color-muted);
    font: 600 0.5rem/1.3 var(--site-font-mono);
    letter-spacing: 0.1em;
    text-align: center;
  }

  @media (max-width: 600px) {
    .dialer-placeholder figcaption {
      display: grid;
    }

    .dialer-placeholder__surface > header {
      grid-template-columns: auto 1fr;
    }

    .dialer-placeholder__surface > header > span:last-child {
      display: none;
    }

    .dialer-placeholder__body {
      grid-template-columns: 1fr;
      min-height: 20rem;
    }

    .dialer-placeholder__body aside {
      display: flex;
      overflow: hidden;
      border-right: 0;
      border-bottom: 1px solid var(--site-color-brand);
      padding: 0.7rem;
    }

    .dialer-placeholder__rows {
      padding: 0.8rem;
    }
  }
</style>
