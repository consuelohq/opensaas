---
import { dialerAgency } from '../../data/home-content';
---

<section class="agency-section" id="founding-agency" data-section="founding-agency">
  <div class="agency-section__intro">
    <p>{dialerAgency.eyebrow}</p>
    <h2>{dialerAgency.title}</h2>
    <div class="agency-section__body">
      <p>{dialerAgency.body}</p>
      <a href={dialerAgency.primaryHref}>{dialerAgency.primaryLabel} →</a>
    </div>
  </div>

  <div class="agency-section__grid">
    {dialerAgency.points.map((point, index) => (
      <article>
        <span>{String(index + 1).padStart(2, '0')}</span>
        <p>{point}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .agency-section {
    background: var(--site-color-brand);
    color: white;
    padding: clamp(5rem, 9vw, 9rem) clamp(1.25rem, 5vw, 5rem);
  }

  .agency-section__intro {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
    gap: clamp(2.5rem, 6vw, 7rem);
    align-items: end;
  }

  .agency-section__intro > p {
    grid-column: 1 / -1;
    margin: 0 0 -1rem;
    font: 680 0.62rem/1 var(--site-font-mono);
    letter-spacing: 0.14em;
  }

  .agency-section h2 {
    max-width: 56rem;
    margin: 0;
    font-family: var(--site-font-display);
    font-size: clamp(4rem, 7.7vw, 8.3rem);
    font-weight: 430;
    letter-spacing: -0.045em;
    line-height: 0.82;
    text-wrap: balance;
  }

  .agency-section__body {
    display: grid;
    gap: 1.5rem;
    align-self: end;
  }

  .agency-section__body p {
    margin: 0;
    color: rgba(255, 255, 255, 0.84);
    font-size: clamp(0.96rem, 1.15vw, 1.08rem);
    line-height: 1.62;
  }

  .agency-section__body a {
    display: grid;
    width: min(100%, 20rem);
    min-height: 3.15rem;
    place-items: center;
    border: 1px solid white;
    background: white;
    color: var(--site-color-brand);
    font: 680 0.7rem/1 var(--site-font-mono);
    letter-spacing: 0.1em;
  }

  .agency-section__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: clamp(4rem, 7vw, 7rem);
    border-top: 1px solid rgba(255, 255, 255, 0.64);
    border-left: 1px solid rgba(255, 255, 255, 0.64);
  }

  .agency-section__grid article {
    min-width: 0;
    min-height: 13rem;
    border-right: 1px solid rgba(255, 255, 255, 0.64);
    border-bottom: 1px solid rgba(255, 255, 255, 0.64);
    padding: clamp(1.25rem, 2.5vw, 2.3rem);
  }

  .agency-section__grid span {
    font: 650 0.6rem/1 var(--site-font-mono);
    letter-spacing: 0.1em;
    opacity: 0.66;
  }

  .agency-section__grid p {
    max-width: 22rem;
    margin: 3.2rem 0 0;
    font-family: var(--site-font-display);
    font-size: clamp(1.45rem, 2.4vw, 2.35rem);
    line-height: 0.98;
  }

  @media (max-width: 760px) {
    .agency-section__intro {
      grid-template-columns: 1fr;
    }

    .agency-section__intro > p {
      grid-column: auto;
      margin-bottom: 0;
    }

    .agency-section h2 {
      font-size: clamp(3.7rem, 16vw, 6rem);
    }

    .agency-section__grid {
      grid-template-columns: 1fr;
    }

    .agency-section__grid article {
      min-height: 10rem;
    }

    .agency-section__grid p {
      margin-top: 2rem;
    }
  }
</style>
