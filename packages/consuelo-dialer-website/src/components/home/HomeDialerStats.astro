---
import { dialerStats } from '../../data/home-content';
---

<section class="dialer-stats" aria-labelledby="dialer-stats-title" data-section="proof">
  <div class="dialer-stats__heading">
    <p>PRODUCT FACTS</p>
    <h2 id="dialer-stats-title">THE MATH BEHIND LESS RINGING.</h2>
    <span>Technical product facts — not customer outcome claims.</span>
  </div>

  <div class="dialer-stats__grid">
    {dialerStats.map((stat) => (
      <article class="dialer-stat">
        <p class="dialer-stat__value">{stat.value}</p>
        <p class="dialer-stat__label">{stat.label}</p>
        <p class="dialer-stat__caption">{stat.caption}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .dialer-stats {
    display: grid;
    grid-template-columns: minmax(15rem, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(2.5rem, 5vw, 6rem);
    background: white;
    color: var(--site-color-brand);
    padding: clamp(4.5rem, 8vw, 7.5rem) clamp(1.25rem, 5vw, 5rem);
  }

  .dialer-stats__heading {
    align-self: start;
    display: grid;
    gap: 1rem;
    max-width: 32rem;
  }

  .dialer-stats__heading > p,
  .dialer-stats__heading > span,
  .dialer-stat__label,
  .dialer-stat__caption {
    font-family: var(--site-font-mono);
    text-transform: uppercase;
  }

  .dialer-stats__heading > p {
    margin: 0;
    font-size: 0.64rem;
    font-weight: 680;
    letter-spacing: 0.14em;
  }

  .dialer-stats__heading h2 {
    margin: 0;
    font-family: var(--site-font-display);
    font-size: clamp(3rem, 5.1vw, 5.3rem);
    font-weight: 430;
    line-height: 0.88;
    text-wrap: balance;
  }

  .dialer-stats__heading > span {
    max-width: 24rem;
    color: var(--site-color-muted);
    font-size: 0.56rem;
    line-height: 1.5;
    letter-spacing: 0.09em;
  }

  .dialer-stats__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--site-color-brand);
    border-left: 1px solid var(--site-color-brand);
  }

  .dialer-stat {
    min-width: 0;
    min-height: clamp(13rem, 20vw, 19rem);
    border-right: 1px solid var(--site-color-brand);
    border-bottom: 1px solid var(--site-color-brand);
    padding: clamp(1.3rem, 2.6vw, 2.4rem);
  }

  .dialer-stat__value {
    margin: 0;
    font-family: var(--site-font-display);
    font-size: clamp(4.6rem, 8vw, 8.5rem);
    font-weight: 430;
    letter-spacing: -0.045em;
    line-height: 0.8;
  }

  .dialer-stat__label {
    margin: 1.6rem 0 0;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.13em;
  }

  .dialer-stat__caption {
    max-width: 21rem;
    margin: 0.55rem 0 0;
    color: var(--site-color-muted);
    font-size: 0.58rem;
    font-weight: 550;
    line-height: 1.55;
    letter-spacing: 0.07em;
  }

  @media (max-width: 800px) {
    .dialer-stats {
      grid-template-columns: 1fr;
      gap: 2.4rem;
      padding-inline: 1.25rem;
    }
  }

  @media (max-width: 520px) {
    .dialer-stats__grid {
      grid-template-columns: 1fr;
    }

    .dialer-stat {
      min-height: 11.5rem;
    }

    .dialer-stat__value {
      font-size: clamp(4.4rem, 22vw, 6rem);
    }
  }
</style>
