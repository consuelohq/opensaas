{
  "name": "@consuelo/conversation",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/conversation/src",
  "tags": ["scope:shared"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/conversation",
        "command": "bun test tests"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/conversation",
        "command": "bun run typecheck"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "packages/conversation",
        "command": "bun run build"
      }
    }
  }
}
