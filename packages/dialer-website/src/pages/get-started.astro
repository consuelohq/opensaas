---
import SiteHeader from '../components/site/SiteHeader.astro';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import PricingIcon from '../components/pricing/PricingIcon.astro';
import {
  pricingPlans,
  minutePacks,
  numberPacks,
} from '../data/pricing-content';
import { siteLinks } from '../data/site-links';
const checkoutEnabled =
  import.meta.env.PUBLIC_DIALER_CHECKOUT_ENABLED === 'true';
---

<MarketingLayout
  title="Get started"
  description="Choose your seats, check out with Stripe, then connect GoHighLevel."
  canonicalPath="/get-started"
>
  <SiteHeader pageSections={[]} />
  <main class="checkout-page">
    <div class="checkout-intro">
      <p class="checkout-eyebrow">YOUR NEXT CALLING DAY</p><h1>
        Make room<br />for more conversations.
      </h1>
      <p>
        Choose your seats. Pay securely with Stripe.<br />Connect GoHighLevel
        afterward.
      </p>
      <ol class="checkout-steps">
        <li><span>01</span>Choose your plan</li><li>
          <span>02</span>Checkout with Stripe
        </li><li><span>03</span>Connect your team</li>
      </ol>
      <p class="checkout-existing">
        Already a customer? <a href="https://app.gohighlevel.com/"
          >Open your dialer</a
        > to manage billing.
      </p>
    </div>
    <section
      class="checkout-panel"
      data-purchase-panel
      hidden
      aria-labelledby="purchase-heading"
    >
      <h2 id="purchase-heading">Connect your team</h2>
      <p data-purchase-status role="status">
        Confirming your purchase with Stripe…
      </p>
      <div data-purchase-ready hidden>
        <p>
          Your payment is confirmed. Connect GoHighLevel, open Consuelo Dialer
          settings, and enter this setup code.
        </p>
        <label class="setup-code-label"
          >Your private setup code<input
            data-purchase-code
            type="password"
            readonly
            autocomplete="off"
          /></label
        >
        <button type="button" class="checkout-button" data-copy-purchase
          >Copy setup code <PricingIcon /></button
        >
        <a
          class="checkout-button"
          data-connect-ghl
          href="https://app.gohighlevel.com/"
          target="_blank"
          rel="noopener noreferrer">Connect GoHighLevel <PricingIcon /></a
        >
      </div>
      <button type="button" class="checkout-button" data-retry-purchase
        >Check payment again <PricingIcon /></button
      >
      <p>
        Keep this confirmation tab until your team is connected. <a
          href="/support">Get setup help</a>
      </p>
    </section>
    <section
      class="checkout-panel"
      data-checkout-panel
      aria-labelledby="checkout-heading"
    >
      <h2 id="checkout-heading">Your calling plan</h2>
      <p data-selected-plan>
        Professional — $99 per rep / month (billed monthly)
      </p>
      <form
        data-checkout-form
        data-checkout-enabled={String(checkoutEnabled)}
        data-checkout-endpoint="https://calls.consuelohq.com/v1/public/billing/checkout"
      >
        <div class="checkout-fields">
          <label
            >Plan<select name="plan" data-checkout-plan
              >{
                pricingPlans.map((plan) => (
                  <option
                    value={plan.code}
                    selected={plan.code === 'professional'}
                  >
                    {plan.name}
                  </option>
                ))
              }</select
            ></label
          >
          <label
            >Billing<select name="billing" data-checkout-billing
              ><option value="monthly">Monthly</option><option value="annual"
                >Annual</option
              ></select
            ></label
          >
          <label
            >Rep seats<input
              name="seats"
              data-checkout-seats
              type="number"
              min="1"
              max="1000"
              step="1"
              value="1"
              inputmode="numeric"
              required
            /></label
          >
        </div>
        <div class="checkout-extras" data-checkout-extras>
          <label class="checkout-mercury"
            ><input type="checkbox" data-checkout-mercury /><span
              ><strong>Add Mercury coaching</strong><small
                >$25 per rep / month · all selected seats</small
              ></span
            ><PricingIcon name="mercury" /></label
          >
          <div class="checkout-fields checkout-fields--extras">
            <label
              >Extra minutes<select data-checkout-minutes
                ><option value="0">No extra minutes</option>{
                  minutePacks.map((pack) => (
                    <option value={pack.minutes}>
                      {pack.minutes.toLocaleString('en-US')} minutes ·{' '}
                      {'$' + pack.priceCents / 100} once
                    </option>
                  ))
                }</select
              ></label
            >
            <label
              >Extra numbers<select data-checkout-numbers
                ><option value="0">No extra numbers</option>{
                  numberPacks.map((pack) => (
                    <option value={pack.numbers}>
                      {pack.numbers} {pack.numbers === 1 ? 'number' : 'numbers'}{' '}
                      · {'$' + pack.priceCents / 100}/month
                    </option>
                  ))
                }</select
              ></label
            >
          </div>
        </div>
        <div class="checkout-total">
          <span
            >Due at checkout<small>USD · before any applicable tax</small></span
          ><output data-checkout-total aria-live="polite">$99</output>
        </div>
        <p class="checkout-renewal" data-checkout-renewal>
          $99 renews monthly. Connected-minute allowances renew each month.
        </p>
        <button
          class="checkout-button"
          type="submit"
          data-checkout-submit
          disabled>Continue to Stripe <PricingIcon /></button
        >
        <a
          class="checkout-button"
          data-starter-continue
          href="https://app.gohighlevel.com/"
          hidden>Continue with Starter <PricingIcon /></a
        >
        <p role="status" class="checkout-status" data-checkout-status>
          {
            checkoutEnabled
              ? ''
              : 'Checkout is being connected to the new plans. Payments are not enabled in this preview.'
          }
        </p>
        <p class="checkout-terms">
          By continuing, you agree to our <a href="/terms">terms</a> and <a
            href="/privacy">privacy policy</a
          >. Your card details stay with Stripe.
        </p>
      </form>
      <noscript
        ><p>
          Enable JavaScript to choose seats and continue to Checkout. You can
          also <a href="https://app.gohighlevel.com/"
            >open your existing dialer</a
          >.
        </p></noscript
      >
    </section>
    <p class="checkout-help">
      Need help connecting? <a href={siteLinks.docs + 'start/'}
        >Read the setup guide <PricingIcon /></a>
    </p>
  </main>
</MarketingLayout>
<script>
  import { pricingPlans } from '../data/pricing-content';
  import {
    selectionFromQuery,
    validateSelection,
    quoteCheckout,
    checkoutPayload,
    stripeCheckoutUrl,
    type CheckoutSelection,
  } from '../lib/checkout-selection';
  const form = document.querySelector<HTMLFormElement>('[data-checkout-form]');
  if (form) {
    const plan = form.querySelector<HTMLSelectElement>('[data-checkout-plan]')!;
    const billing = form.querySelector<HTMLSelectElement>(
      '[data-checkout-billing]',
    )!;
    const seats = form.querySelector<HTMLInputElement>(
      '[data-checkout-seats]',
    )!;
    const mercury = form.querySelector<HTMLInputElement>(
      '[data-checkout-mercury]',
    )!;
    const minutes = form.querySelector<HTMLSelectElement>(
      '[data-checkout-minutes]',
    )!;
    const numbers = form.querySelector<HTMLSelectElement>(
      '[data-checkout-numbers]',
    )!;
    const submit = form.querySelector<HTMLButtonElement>(
      '[data-checkout-submit]',
    )!;
    const starter = form.querySelector<HTMLAnchorElement>(
      '[data-starter-continue]',
    )!;
    const status = form.querySelector<HTMLElement>('[data-checkout-status]')!;
    const money = (cents: number) =>
      new Intl.NumberFormat('en-US', {
        style: 'currency',
        currency: 'USD',
        maximumFractionDigits: 0,
      }).format(cents / 100);
    let busy = false;
    type RequestRecord = { key: string; id: string; claimToken: string };
    let request: RequestRecord | undefined;
    const savedRequest = (id: string): RequestRecord | undefined => {
      try {
        const value = JSON.parse(
          sessionStorage.getItem('consuelo-checkout:' + id) ?? 'null',
        );
        return value &&
          value.id === id &&
          typeof value.key === 'string' &&
          /^[A-Za-z0-9_-]{43}$/.test(value.claimToken)
          ? value
          : undefined;
      } catch {
        return undefined;
      }
    };
    const query = new URLSearchParams(location.search);
    const purchaseId = query.get('purchase');
    const resumed = purchaseId ? savedRequest(purchaseId) : undefined;
    if (resumed) request = resumed;
    else {
      try {
        const id = sessionStorage.getItem('consuelo-checkout-current');
        if (id) request = savedRequest(id);
      } catch {}
    }
    const readSelection = (): CheckoutSelection =>
      validateSelection({
        plan: plan.value as CheckoutSelection['plan'],
        billing: billing.value as CheckoutSelection['billing'],
        seats: seats.valueAsNumber,
        mercurySeats: mercury.checked ? seats.valueAsNumber : 0,
        minutePack: Number(minutes.value),
        numberPack: Number(numbers.value),
      });
    try {
      const initial = selectionFromQuery(new URLSearchParams(location.search));
      plan.value = initial.plan;
      billing.value = initial.billing;
      seats.value = String(initial.seats);
      mercury.checked = initial.mercurySeats > 0;
      minutes.value = String(initial.minutePack);
      numbers.value = String(initial.numberPack);
    } catch {
      status.textContent =
        'Check your seat count and add-ons before continuing.';
    }
    const update = () => {
      const free = plan.value === 'starter';
      if (free) {
        seats.value = '1';
        mercury.checked = false;
        minutes.value = '0';
        numbers.value = '0';
      }
      seats.disabled = free;
      billing.disabled = free;
      form.querySelector<HTMLElement>('[data-checkout-extras]')!.hidden = free;
      starter.hidden = !free;
      submit.hidden = free;
      try {
        const selected = readSelection(),
          quote = quoteCheckout(selected);
        const offer = pricingPlans.find((p) => p.code === selected.plan)!;
        document.querySelector('[data-selected-plan]')!.textContent =
          offer.name +
          ' — ' +
          (free
            ? '100 total trial minutes'
            : offer.price +
              ' per rep / month (' +
              (selected.billing === 'annual'
                ? money(offer.monthlyCents * 12) + ' per rep billed annually'
                : 'billed monthly') +
              ')');
        form.querySelector('[data-checkout-total]')!.textContent = free
          ? 'Free'
          : money(quote.dueCents);
        form.querySelector('[data-checkout-renewal]')!.textContent = free
          ? '100 connected minutes to try. No subscription required.'
          : money(quote.recurringCents) +
            ' renews ' +
            (selected.billing === 'annual' ? 'annually' : 'monthly') +
            (quote.oneTimeCents
              ? '; ' + money(quote.oneTimeCents) + ' in one-time minutes.'
              : '.') +
            ' Connected-minute allowances renew each month.';
        seats.removeAttribute('aria-invalid');
        submit.disabled = busy || form.dataset.checkoutEnabled !== 'true';
      } catch {
        seats.setAttribute('aria-invalid', 'true');
        submit.disabled = true;
        status.textContent =
          'Enter a whole rep count from 1 to 1,000 and valid add-ons.';
      }
    };
    form.addEventListener('input', update);
    form.addEventListener('change', update);
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (busy || form.dataset.checkoutEnabled !== 'true') return;
      try {
        const selection = readSelection(),
          key = JSON.stringify(selection);
        if (!request || request.key !== key) {
          const bytes = crypto.getRandomValues(new Uint8Array(32));
          const claimToken = btoa(String.fromCharCode(...bytes))
            .replaceAll('+', '-')
            .replaceAll('/', '_')
            .replaceAll('=', '');
          request = { key, id: crypto.randomUUID(), claimToken };
          sessionStorage.setItem(
            'consuelo-checkout:' + request.id,
            JSON.stringify(request),
          );
          sessionStorage.setItem('consuelo-checkout-current', request.id);
        }
        busy = true;
        update();
        status.textContent = 'Opening secure Stripe Checkout…';
        const response = await fetch(form.dataset.checkoutEndpoint!, {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(
            checkoutPayload(selection, request.id, request.claimToken),
          ),
          signal: AbortSignal.timeout(20000),
        });
        if (!response.ok) {
          const error = await response.json().catch(() => null);
          if (error?.error?.code === 'CHECKOUT_SESSION_EXPIRED') {
            sessionStorage.removeItem('consuelo-checkout:' + request.id);
            sessionStorage.removeItem('consuelo-checkout-current');
            request = undefined;
          }
          throw new Error('Checkout unavailable');
        }
        const result: unknown = await response.json();
        if (!result || typeof result !== 'object' || !('url' in result))
          throw new Error('Invalid response');
        location.assign(stripeCheckoutUrl(result.url));
      } catch {
        status.textContent =
          'Checkout could not open. Please try again. No payment has been taken on this page.';
        busy = false;
        update();
      }
    });
    update();
    if (purchaseId && query.get('checkout') !== 'cancelled') {
      const panel = document.querySelector<HTMLElement>(
        '[data-purchase-panel]',
      )!;
      const message = panel.querySelector<HTMLElement>(
        '[data-purchase-status]',
      )!;
      document.querySelector<HTMLElement>('[data-checkout-panel]')!.hidden =
        true;
      panel.hidden = false;
      const verify = async () => {
        if (!resumed) {
          message.textContent =
            'Open this confirmation in the browser where you checked out, or contact support with your Stripe receipt.';
          return;
        }
        try {
          const response = await fetch(
            'https://calls.consuelohq.com/v1/public/billing/purchase/' +
              encodeURIComponent(purchaseId),
            {
              headers: { 'X-Purchase-Claim': resumed.claimToken },
              signal: AbortSignal.timeout(20000),
            },
          );
          if (!response.ok) throw new Error('Purchase unavailable');
          const result = await response.json();
          if (!result.paid) {
            message.textContent =
              result.status === 'expired'
                ? 'This Checkout session expired. Return to pricing to start again.'
                : 'Stripe has not confirmed payment yet. You can check again in a moment.';
            return;
          }
          if (result.claimed) {
            message.textContent =
              'Your purchase is connected to GoHighLevel. Open your dialer to manage the team.';
            sessionStorage.removeItem('consuelo-checkout:' + purchaseId);
            return;
          }
          const install = new URL(result.installUrl);
          if (
            install.protocol !== 'https:' ||
            ![
              'marketplace.leadconnectorhq.com',
              'marketplace.gohighlevel.com',
            ].includes(install.hostname)
          )
            throw new Error('Invalid installation link');
          message.textContent = 'Payment confirmed.';
          panel.querySelector<HTMLElement>('[data-purchase-ready]')!.hidden =
            false;
          panel.querySelector<HTMLInputElement>('[data-purchase-code]')!.value =
            purchaseId + '.' + resumed.claimToken;
          panel.querySelector<HTMLAnchorElement>('[data-connect-ghl]')!.href =
            install.href;
        } catch {
          message.textContent =
            'Payment confirmation is temporarily unavailable. Check again; do not submit another payment.';
        }
      };
      panel
        .querySelector('[data-copy-purchase]')!
        .addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(
              panel.querySelector<HTMLInputElement>('[data-purchase-code]')!
                .value,
            );
            message.textContent =
              'Setup code copied. Paste it in Consuelo Dialer settings.';
          } catch {
            message.textContent =
              'Copy is unavailable. Select the setup code and copy it manually.';
            panel.querySelector<HTMLInputElement>(
              '[data-purchase-code]',
            )!.type = 'text';
          }
        });
      panel
        .querySelector('[data-retry-purchase]')!
        .addEventListener('click', verify);
      void verify();
    } else if (resumed) {
      try {
        const selection = validateSelection(JSON.parse(resumed.key));
        plan.value = selection.plan;
        billing.value = selection.billing;
        seats.value = String(selection.seats);
        mercury.checked = selection.mercurySeats > 0;
        minutes.value = String(selection.minutePack);
        numbers.value = String(selection.numberPack);
        update();
      } catch {}
    }
  }
</script>
<style>
  .checkout-page {
    padding: 12rem max(1.25rem, calc((100vw - 78rem) / 2)) 5rem;
    color: var(--site-color-on-brand);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }
  .checkout-eyebrow {
    font: 600 0.72rem/1.5 var(--site-font-mono);
    letter-spacing: 0.08em;
  }
  .checkout-intro h1 {
    font: 430 clamp(2.6rem, 4.7vw, 4.7rem)/1.02 var(--site-font-display);
    margin: 2rem 0;
    letter-spacing: -0.035em;
  }
  .checkout-intro > p {
    font-size: 0.95rem;
    line-height: 1.75;
  }
  .checkout-steps {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1.2rem;
    margin: 3rem 0;
  }
  .checkout-steps span {
    font: 0.75rem var(--site-font-mono);
    margin-right: 1rem;
    opacity: 0.6;
  }
  .checkout-existing {
    opacity: 0.85;
    font-size: 0.8rem !important;
    max-width: 22rem;
  }
  .checkout-page a {
    color: inherit;
    text-underline-offset: 0.2em;
  }
  .checkout-panel {
    background: white;
    color: var(--site-color-brand);
    padding: 2rem;
    border-radius: 0.65rem;
  }
  .checkout-panel h2 {
    margin: 0 0 0.7rem;
    font-size: 1.5rem;
    font-weight: 500;
  }
  .checkout-panel [data-selected-plan] {
    font-size: 0.8rem;
    line-height: 1.6;
    margin: 0 0 2rem;
    color: var(--site-color-muted);
  }
  .checkout-fields {
    display: grid;
    grid-template-columns: 1.35fr 1fr 0.65fr;
    gap: 0.7rem;
  }
  .checkout-fields label {
    display: grid;
    gap: 0.55rem;
    font-size: 0.72rem;
  }
  .checkout-fields select,
  .checkout-fields input {
    min-width: 0;
    width: 100%;
    padding: 0.75rem 0.55rem;
    background: #fff;
    color: inherit;
    font: inherit;
    border: 1px solid var(--site-color-line-strong);
    border-radius: 0.3rem;
  }
  .checkout-extras {
    margin: 1.7rem 0;
  }
  .checkout-mercury {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 1rem;
    background: var(--site-color-panel);
    border-radius: 0.35rem;
    cursor: pointer;
  }
  .checkout-mercury span {
    flex: 1;
  }
  .checkout-mercury strong {
    font-size: 0.85rem;
    font-weight: 500;
  }
  .checkout-mercury small {
    display: block;
    font-size: 0.7rem;
    margin-top: 0.4rem;
    color: var(--site-color-muted);
  }
  .checkout-mercury svg {
    width: 1.5rem;
    height: 1.5rem;
  }
  .checkout-fields--extras {
    grid-template-columns: 1fr 1fr;
    margin-top: 1.25rem;
  }
  .checkout-total {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    margin-top: 2rem;
    font-size: 0.85rem;
  }
  .checkout-total small {
    display: block;
    font-size: 0.65rem;
    color: var(--site-color-muted);
    margin-top: 0.4rem;
  }
  .checkout-total output {
    font-size: 2rem;
    letter-spacing: -0.04em;
  }
  .checkout-renewal {
    font-size: 0.7rem;
    color: var(--site-color-muted);
    line-height: 1.7;
    margin: 1.25rem 0;
  }
  .checkout-button {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    width: 100%;
    padding: 1rem;
    border: 0;
    border-radius: 0.35rem;
    background: var(--site-color-brand);
    color: white !important;
    font: 500 0.85rem var(--site-font-body);
    text-decoration: none;
    cursor: pointer;
  }
  .checkout-button svg,
  .checkout-help svg {
    width: 1.25rem;
    height: 1.25rem;
  }
  .checkout-button:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }
  .checkout-status {
    font-size: 0.75rem;
    line-height: 1.6;
    min-height: 1.2em;
    margin: 1rem 0;
  }
  .checkout-terms {
    font-size: 0.65rem;
    line-height: 1.7;
    color: var(--site-color-muted);
  }
  .setup-code-label {
    display: grid;
    gap: 0.5rem;
    font-size: 0.8rem;
    margin: 1.5rem 0;
  }
  .setup-code-label input {
    min-width: 0;
    width: 100%;
    padding: 0.7rem;
    font: inherit;
    border: 1px solid var(--site-color-line-strong);
    border-radius: 0.3rem;
  }
  .checkout-panel[data-purchase-panel] p {
    font-size: 0.8rem;
    line-height: 1.7;
  }
  .checkout-panel[data-purchase-panel] .checkout-button {
    margin-top: 1rem;
  }
  .checkout-help {
    grid-column: 1/-1;
    margin: 0;
    text-align: center;
    font-size: 0.8rem;
  }
  .checkout-help a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .checkout-page [hidden] {
    display: none !important;
  }
  .checkout-page :focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }
  @media (max-width: 1050px) {
    .checkout-page {
      gap: 2rem;
      padding-top: 10rem;
    }
    .checkout-fields {
      grid-template-columns: 1fr 1fr;
    }
    .checkout-fields label:first-child {
      grid-column: 1/-1;
    }
    .checkout-fields--extras label:first-child {
      grid-column: auto;
    }
    .checkout-panel {
      padding: 1.4rem;
    }
  }
  @media (max-width: 760px) {
    .checkout-page {
      grid-template-columns: 1fr;
      max-width: 40rem;
      margin: auto;
      padding-top: 9rem;
    }
    .checkout-intro h1 {
      font-size: 3.3rem;
    }
    .checkout-steps {
      margin: 1.5rem 0;
      gap: 0.7rem;
    }
    .checkout-panel {
      padding: 1.25rem;
    }
    .checkout-help {
      line-height: 1.8;
    }
  }
</style>
