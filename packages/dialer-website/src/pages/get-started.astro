---
import SiteHeader from '../components/site/SiteHeader.astro';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import PricingIcon from '../components/pricing/PricingIcon.astro';
---

<MarketingLayout
  title="Connect your team"
  description="Complete secure Stripe Checkout, then connect your team to GoHighLevel."
  canonicalPath="/get-started"
>
  <SiteHeader pageSections={[]} />
  <main class="checkout-page">
    <section class="checkout-panel" data-checkout-redirect>
      <h1>Opening Stripe Checkout…</h1>
      <p data-checkout-status role="status">Taking you to secure checkout.</p>
      <button type="button" data-retry-checkout hidden
        >Try again <PricingIcon /></button
      >
      <a href="/pricing">Back to pricing <PricingIcon /></a>
      <noscript
        ><p>
          Enable JavaScript to open Stripe Checkout and confirm your payment.
        </p></noscript
      >
    </section>
    <section
      class="checkout-panel"
      data-purchase-panel
      hidden
      aria-labelledby="purchase-heading"
    >
      <h2 id="purchase-heading">Connect your team</h2>
      <p data-purchase-status role="status">
        Confirming your purchase with Stripe…
      </p>
      <div data-purchase-ready hidden>
        <p>
          Your payment is confirmed. Connect GoHighLevel, open Consuelo Dialer
          settings, and enter this setup code.
        </p>
        <label class="setup-code-label"
          >Your private setup code<input
            data-purchase-code
            type="password"
            readonly
            autocomplete="off"
          /></label
        >
        <button type="button" class="checkout-button" data-copy-purchase
          >Copy setup code <PricingIcon /></button
        >
        <a
          class="checkout-button"
          data-connect-ghl
          href="https://app.gohighlevel.com/"
          target="_blank"
          rel="noopener noreferrer">Connect GoHighLevel <PricingIcon /></a
        >
      </div>
      <button type="button" class="checkout-button" data-retry-purchase
        >Check payment again <PricingIcon /></button
      >
      <p>
        Keep this confirmation tab until your team is connected. <a
          href="/support">Get setup help</a
        >
      </p>
    </section>
  </main>
</MarketingLayout>
<script>
  import { selectionFromQuery } from '../lib/checkout-selection';
  import {
    createStripeRedirect,
    readCheckoutRequest,
  } from '../lib/direct-checkout';
  const query = new URLSearchParams(location.search);
  const purchaseId = query.get('purchase');
  const redirect = document.querySelector<HTMLElement>(
    '[data-checkout-redirect]',
  )!;
  const panel = document.querySelector<HTMLElement>('[data-purchase-panel]')!;
  if (
    query.get('checkout') === 'cancelled' ||
    (!purchaseId && !query.has('plan'))
  ) {
    const pricing = new URL('/pricing', location.origin);
    if (query.has('addon')) {
      pricing.searchParams.set('addon', query.get('addon')!);
      pricing.hash = 'team-planner';
    }
    location.replace(pricing.href);
  } else if (!purchaseId) {
    let busy = false;
    const launch = async () => {
      if (busy) return;
      const message = redirect.querySelector<HTMLElement>(
        '[data-checkout-status]',
      )!;
      const retry = redirect.querySelector<HTMLButtonElement>(
        '[data-retry-checkout]',
      )!;
      try {
        const selection = selectionFromQuery(query);
        if (selection.plan === 'starter') {
          location.replace('https://app.gohighlevel.com/');
          return;
        }
        if (
          document.querySelector<HTMLElement>('[data-stripe-checkout-settings]')
            ?.dataset.stripeCheckoutEnabled !== 'true'
        )
          throw new Error('Checkout is not available in this preview.');
        busy = true;
        retry.hidden = true;
        location.replace(
          await createStripeRedirect(selection, { storage: sessionStorage }),
        );
      } catch {
        message.textContent =
          'Stripe Checkout could not open. Please try again or return to pricing.';
        retry.hidden = false;
      } finally {
        busy = false;
      }
    };
    redirect
      .querySelector('[data-retry-checkout]')!
      .addEventListener('click', launch);
    void launch();
  } else {
    redirect.hidden = true;
    panel.hidden = false;
    const message = panel.querySelector<HTMLElement>('[data-purchase-status]')!;
    let saved: ReturnType<typeof readCheckoutRequest>;
    try {
      saved = readCheckoutRequest(purchaseId, sessionStorage);
    } catch {
      /* Recovery message below handles unavailable storage. */
    }
    const verify = async () => {
      if (!saved) {
        message.textContent =
          'Open this confirmation in the browser where you checked out, or contact support with your Stripe receipt.';
        return;
      }
      try {
        const response = await fetch(
          'https://calls.consuelohq.com/v1/public/billing/purchase/' +
            encodeURIComponent(purchaseId),
          {
            headers: { 'X-Purchase-Claim': saved.claimToken },
            signal: AbortSignal.timeout(20000),
          },
        );
        if (!response.ok) throw new Error('Purchase unavailable');
        const result: unknown = await response.json();
        if (
          !result ||
          typeof result !== 'object' ||
          !('paid' in result) ||
          typeof result.paid !== 'boolean'
        )
          throw new Error('Invalid purchase response');
        if (!result.paid) {
          message.textContent =
            'status' in result && result.status === 'expired'
              ? 'This Checkout session expired. Return to pricing to start again.'
              : 'Stripe has not confirmed payment yet. You can check again in a moment.';
          return;
        }
        if ('claimed' in result && result.claimed === true) {
          message.textContent =
            'Your purchase is connected to GoHighLevel. Open your dialer to manage the team.';
          sessionStorage.removeItem('consuelo-checkout:' + purchaseId);
          return;
        }
        if (!('installUrl' in result) || typeof result.installUrl !== 'string')
          throw new Error('Installation link unavailable');
        const install = new URL(result.installUrl);
        if (
          install.protocol !== 'https:' ||
          ![
            'marketplace.leadconnectorhq.com',
            'marketplace.gohighlevel.com',
          ].includes(install.hostname)
        )
          throw new Error('Invalid installation link');
        message.textContent = 'Payment confirmed.';
        panel.querySelector<HTMLElement>('[data-purchase-ready]')!.hidden =
          false;
        panel.querySelector<HTMLInputElement>('[data-purchase-code]')!.value =
          purchaseId + '.' + saved.claimToken;
        panel.querySelector<HTMLAnchorElement>('[data-connect-ghl]')!.href =
          install.href;
      } catch {
        message.textContent =
          'Payment confirmation is temporarily unavailable. Check again; do not submit another payment.';
      }
    };
    panel
      .querySelector('[data-retry-purchase]')!
      .addEventListener('click', verify);
    panel
      .querySelector('[data-copy-purchase]')!
      .addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(
            panel.querySelector<HTMLInputElement>('[data-purchase-code]')!
              .value,
          );
          message.textContent =
            'Setup code copied. Paste it in Consuelo Dialer settings.';
        } catch {
          message.textContent =
            'Copy is unavailable. Select the setup code and copy it manually.';
          panel.querySelector<HTMLInputElement>('[data-purchase-code]')!.type =
            'text';
        }
      });
    void verify();
  }
</script>
<style>
  .checkout-page {
    width: min(48rem, calc(100% - 2rem));
    margin: auto;
    padding: 12rem 0 5rem;
    color: var(--site-color-ink);
  }
  .checkout-panel {
    padding: clamp(1.5rem, 5vw, 3rem);
    border-radius: 0.5rem;
    background: var(--site-color-surface);
  }
  .checkout-panel h1,
  .checkout-panel h2 {
    font: 450 clamp(2rem, 5vw, 3.5rem)/1.05 var(--site-font-display);
    margin: 0 0 1.5rem;
  }
  .checkout-panel p {
    font-size: 0.95rem;
    line-height: 1.7;
  }
  .checkout-panel a,
  .checkout-panel button {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: inherit;
    font: inherit;
    margin: 0.5rem 1rem 0.5rem 0;
  }
  .checkout-panel button {
    padding: 0.8rem 1rem;
    border: 1px solid currentColor;
    background: transparent;
    cursor: pointer;
  }
  .checkout-panel :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    flex: 0 0 auto;
  }
  .setup-code-label {
    display: grid;
    gap: 0.5rem;
    margin: 1.5rem 0;
  }
  .setup-code-label input {
    width: 100%;
    padding: 0.9rem;
    border: 1px solid var(--site-color-line-strong);
    border-radius: 0.25rem;
    font: inherit;
  }
  .checkout-panel [hidden] {
    display: none;
  }
</style>
