---
import { siteLinks } from '../data/site-links';
import InfoPage from '../components/site/InfoPage.astro';
---

<InfoPage
  title="Put Consuelo to work."
  description="Choose a calling plan for your team."
  eyebrow="GET STARTED"
>
  <h2>Start with your team.</h2>
  <p data-selected-plan>
    Tell us how your team calls today. We will help you choose a plan and plan
    your setup.
  </p>
  <ol>
    <li>
      <strong>Choose your calling motion.</strong> Make outbound calls, route inbound
      calls, or use both with the same rep seat.
    </li><li>
      <strong>Connect your tools.</strong> An administrator connects your GoHighLevel
      location and sets up reps and numbers.
    </li><li>
      <strong>Make the first calls.</strong> Check answering, routing and call history
      with your team.
    </li>
  </ol>
  <a
    class="setup-action"
    data-setup-request
    href="mailto:support@consuelohq.com?subject=Set%20up%20Consuelo%20Dialer"
    >REQUEST SETUP →</a
  >
  <p>
    This opens an email to support@consuelohq.com. We confirm your configuration
    and billing before a subscription starts.
  </p>
  <h2>Already installed?</h2><p>
    <a href="https://app.gohighlevel.com/">Open GoHighLevel</a>, choose your
    location, and select Consuelo Dialer.
  </p>
  <h2>Get the details.</h2><p>
    <a href="/pricing">Compare plans and add-ons</a> or <a
      href={siteLinks.docs + 'start/'}>read the setup guide</a
    >.
  </p>
</InfoPage>
<script>
  import { pricingPlans, quotePlan } from '../data/pricing-content';
  const query = new URLSearchParams(location.search);
  const plan = pricingPlans.find((p) => p.code === query.get('plan'));
  const billing = query.get('billing') === 'annual' ? 'annual' : 'monthly';
  if (plan) {
    const selected = document.querySelector('[data-selected-plan]');
    const request = document.querySelector<HTMLAnchorElement>(
      '[data-setup-request]',
    );
    const quote = quotePlan(plan.code, billing, 1);
    const money = (cents: number) =>
      new Intl.NumberFormat('en-US', {
        style: 'currency',
        currency: 'USD',
        maximumFractionDigits: 0,
      }).format(cents / 100);
    const label =
      plan.code === 'starter'
        ? 'Starter — 100 total trial minutes'
        : plan.name +
          ' — ' +
          plan.price +
          ' per seat / month' +
          (billing === 'annual'
            ? ' (' + money(quote.totalCents) + ' per seat billed annually)'
            : ' (billed monthly)');
    if (selected)
      selected.textContent =
        'You selected ' +
        label +
        '. We will confirm your team configuration and billing before any subscription starts.';
    if (request)
      request.href =
        'mailto:support@consuelohq.com?' +
        new URLSearchParams({
          subject: 'Set up Consuelo Dialer — ' + label,
        }).toString();
  }
</script>
