---
import SiteHeader from '../components/site/SiteHeader.astro';
import HomeFaq from '../components/home/HomeFaq.astro';
import PricingIcon from '../components/pricing/PricingIcon.astro';
import PricingAddons from '../components/pricing/PricingAddons.astro';
import PricingComparison from '../components/pricing/PricingComparison.astro';
import PricingTechnology from '../components/pricing/PricingTechnology.astro';
import {
  pricingPlans,
  pricingFaqItems,
  pricingAccountLink,
  minutePacks,
  numberPacks,
} from '../data/pricing-content';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import '../styles/pricing.css';
---

<MarketingLayout
  title="Pricing"
  description="Choose your calling plan. Inbound, outbound and analytics, with room for your whole team."
  canonicalPath="/pricing"
  image="/consuelo-dialer-pricing-og-20261030.png"
  imageAlt="Consuelo Dialer plans — Starter, Professional, Agency and Enterprise."
  imageWidth={1200}
  imageHeight={630}
>
  <SiteHeader pageSections={[]} />
  <main class="pricing-page" id="pricing" aria-labelledby="pricing-heading">
    <div class="pricing-frame">
      <section class="pricing-plans" aria-labelledby="pricing-heading">
        <a class="pricing-mercury-note" href="#addons"
          ><PricingIcon name="mercury" /><span
            >Meet Mercury coaching. Your playbook, in the conversation.</span
          ><PricingIcon /></a
        >
        <div class="pricing-intro">
          <div>
            <p class="pricing-eyebrow">CONSUELO / PRICING</p><h1
              id="pricing-heading"
            >
              More conversations.<br />Room to grow.
            </h1>
          </div>
          <a class="pricing-jump" href="#compare"
            >Compare all features <PricingIcon /></a
          >
        </div>
        <div class="pricing-toolbar">
          <div
            class="pricing-products"
            aria-label="One seat, both calling motions"
          >
            <span><PricingIcon name="outbound" />Consuelo Outbound</span><span
              ><PricingIcon name="inbound" />Consuelo Inbound</span
            ><span><PricingIcon name="analytics" />Analytics</span>
          </div>
          <fieldset class="billing-control" data-billing-control hidden>
            <legend class="sr-only">Billing period</legend><label
              ><input
                type="radio"
                name="billing"
                value="monthly"
                checked
              /><span>Monthly</span></label
            ><label
              ><input type="radio" name="billing" value="annual" /><span
                >Annual</span
              ></label
            >
          </fieldset>
        </div>
        <div class="plan-columns">
          {
            pricingPlans.map((plan) => (
              <article
                class:list={[
                  'plan-column',
                  { 'plan-column--agency': plan.code === 'agency' },
                ]}
                data-plan-code={plan.code}
              >
                <div class="plan-column__heading">
                  <h2>{plan.name}</h2>
                  {plan.code === 'agency' && (
                    <span class="plan-kicker">FOR AGENCIES</span>
                  )}
                </div>
                <div class="plan-seat">
                  <div class="plan-seat__row">
                    <span>
                      {plan.monthlyCents === 0 ? 'Try it out' : 'Rep seat'}
                    </span>
                    <div class="plan-column__price">
                      <strong>
                        {plan.monthlyCents === 0 ? 'Free' : plan.price}
                      </strong>
                      {plan.monthlyCents > 0 && <span>/mo</span>}
                    </div>
                  </div>
                  <div
                    class="plan-seat__products"
                    aria-label="Includes inbound, outbound and analytics"
                  >
                    <span title="Outbound">
                      <PricingIcon name="outbound" />
                    </span>
                    <span title="Inbound">
                      <PricingIcon name="inbound" />
                    </span>
                    <span title="Analytics">
                      <PricingIcon name="analytics" />
                    </span>
                    {plan.code !== 'starter' && (
                      <span title="Predictive dialing">
                        <PricingIcon name="connect" />
                      </span>
                    )}
                  </div>
                  <p class="plan-seat__usage">
                    {plan.includedMinutes.toLocaleString('en-US')} connected
                    minutes
                    {plan.monthlyCents > 0 ? ' / rep / month' : ' to try'}
                  </p>
                  <p
                    class="plan-billing"
                    data-plan-billing
                    data-monthly-cents={plan.monthlyCents}
                  >
                    {plan.monthlyCents === 0
                      ? 'No subscription required'
                      : 'Per rep · billed monthly · USD'}
                  </p>
                </div>
                <a
                  class:list={[
                    'pricing-button',
                    { 'pricing-button--solid': plan.code === 'agency' },
                  ]}
                  data-plan-cta
                  href={plan.href}
                >
                  {plan.monthlyCents > 0 ? 'Select plan' : plan.action}
                  <PricingIcon />
                </a>
                <p class="plan-column__description">{plan.description}</p>
                <p class="plan-features-label">
                  {plan.code === 'starter'
                    ? 'A simple first step'
                    : 'What you get'}
                </p>
                <ul class="plan-bullets">
                  {plan.bullets.map((bullet) => (
                    <li>
                      <PricingIcon name="check" />
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
        <div class="pricing-fineprint">
          <p>
            One rep. Inbound and outbound. Every plan includes GoHighLevel and
            support.
          </p><p>
            Paid minutes renew monthly per seat. Contiguous US local calling.
            Taxes extra. <a href="#pricing-faq"
              >How billing works <PricingIcon /></a
            >
          </p>
          <p>
            {pricingAccountLink.prompt}
            <a href={pricingAccountLink.href}
              >{pricingAccountLink.label} <PricingIcon /></a
            >
          </p>
        </div>
        <div class="team-planner" id="team-planner" data-team-planner hidden>
          <div class="team-planner__intro">
            <p class="pricing-eyebrow">BUYING FOR YOUR TEAM?</p><p>
              Choose a new plan for your team.
            </p>
          </div>
          <div class="team-planner__inputs">
            <label
              >Plan<select data-team-plan
                >{
                  pricingPlans
                    .filter((p) => p.monthlyCents > 0)
                    .map((p) => (
                      <option value={p.code} selected={p.code === 'agency'}>
                        {p.name}
                      </option>
                    ))
                }</select
              ></label
            ><label
              >Reps<input
                data-seat-count
                type="number"
                min="1"
                max="1000"
                step="1"
                value="5"
                inputmode="numeric"
              /></label
            >
          </div>
          <details class="team-planner__addons" data-team-addons-details>
            <summary
              >Add coaching, minutes or numbers <PricingIcon
                name="chevron"
              /></summary
            >
            <div class="team-planner__options">
              <label class="team-planner__mercury"
                ><input type="checkbox" data-team-mercury /><span
                  >Mercury coaching<br /><small
                    >$25 per rep / month · all selected reps</small
                  ></span
                ></label
              >
              <label
                >Extra connected minutes<select data-team-minutes
                  ><option value="0">No extra minutes</option>{
                    minutePacks.map((pack) => (
                      <option value={pack.minutes}>
                        {pack.minutes.toLocaleString('en-US')} minutes · $
                        {pack.priceCents / 100} once
                      </option>
                    ))
                  }</select
                ></label
              >
              <label
                >Extra numbers<select data-team-numbers
                  ><option value="0">No extra numbers</option>{
                    numberPacks.map((pack) => (
                      <option value={pack.numbers}>
                        {pack.numbers}{' '}
                        {pack.numbers === 1 ? 'number' : 'numbers'} · $
                        {pack.priceCents / 100} / month
                      </option>
                    ))
                  }</select
                ></label
              >
            </div>
            <p class="team-planner__note">
              These choices start a new subscription. Already subscribed? <a
                href={pricingAccountLink.href}>Manage your plan in Stripe</a
              > to change seats, add Mercury or update your payment details.
            </p>
          </details>
          <output data-team-total aria-live="polite"
            >$745 / month for 5 reps</output
          >
          <p class="team-planner__invoices" data-team-invoices hidden></p>
          <a
            class="pricing-button pricing-button--solid"
            data-team-checkout
            href="/get-started?plan=agency&seats=5&billing=monthly"
            >Checkout for your team <PricingIcon /></a
          >
        </div>
      </section>
      <PricingAddons />
      <PricingComparison />
      <HomeFaq
        title="Pricing FAQs"
        id="pricing-faq"
        items={pricingFaqItems}
        variant="pricing"
      />
      <PricingTechnology />
    </div>
    <section class="pricing-close" aria-labelledby="pricing-close-title">
      <p class="pricing-eyebrow">YOUR NEXT CALLING DAY</p><h2
        id="pricing-close-title"
      >
        Give your team<br />more room to sell.
      </h2><a class="pricing-button" href="/get-started"
        >Get started <PricingIcon /></a
      ><a class="pricing-close__contact" href="/contact"
        >Plan it with us <PricingIcon /></a
      >
    </section>
  </main>
</MarketingLayout>
<script>
  import {
    pricingPlans,
    minutePacks,
    numberPacks,
  } from '../data/pricing-content';
  import {
    quoteCheckout,
    selectionToQuery,
    type CheckoutSelection,
  } from '../lib/checkout-selection';
  const currency = (cents: number) =>
    new Intl.NumberFormat('en-US', {
      style: 'currency',
      currency: 'USD',
      maximumFractionDigits: 0,
    }).format(cents / 100);
  const seats = document.querySelector<HTMLInputElement>('[data-seat-count]');
  const plan = document.querySelector<HTMLSelectElement>('[data-team-plan]');
  const output = document.querySelector<HTMLOutputElement>('[data-team-total]');
  const mercury = document.querySelector<HTMLInputElement>(
    '[data-team-mercury]',
  );
  const minutes = document.querySelector<HTMLSelectElement>(
    '[data-team-minutes]',
  );
  const numbers = document.querySelector<HTMLSelectElement>(
    '[data-team-numbers]',
  );
  const addonDetails = document.querySelector<HTMLDetailsElement>(
    '[data-team-addons-details]',
  );
  const currentBilling = () =>
    document.querySelector<HTMLInputElement>('input[name="billing"]:checked')
      ?.value === 'annual'
      ? 'annual'
      : 'monthly';
  const updateTeam = () => {
    if (!seats || !plan || !output) return;
    const checkout = document.querySelector<HTMLAnchorElement>(
      '[data-team-checkout]',
    );
    const count = seats.valueAsNumber;
    if (!Number.isInteger(count) || count < 1 || count > 1000) {
      seats.setAttribute('aria-invalid', 'true');
      output.textContent = 'Enter a whole rep count from 1 to 1,000.';
      checkout?.setAttribute('aria-disabled', 'true');
      checkout?.removeAttribute('href');
      return;
    }
    seats.removeAttribute('aria-invalid');
    const selection: CheckoutSelection = {
      plan: plan.value as CheckoutSelection['plan'],
      billing: currentBilling(),
      seats: count,
      mercurySeats: mercury?.checked ? count : 0,
      minutePack: Number(minutes?.value ?? 0),
      numberPack: Number(numbers?.value ?? 0),
    };
    const quote = quoteCheckout(selection);
    checkout?.removeAttribute('aria-disabled');
    if (checkout)
      checkout.href = '/get-started?' + selectionToQuery(selection).toString();
    const numberRecurring =
      (numberPacks.find((pack) => pack.numbers === selection.numberPack)
        ?.priceCents ?? 0) * quote.months;
    const invoiceNote = document.querySelector<HTMLElement>(
      '[data-team-invoices]',
    );
    if (invoiceNote) {
      invoiceNote.hidden = !numberRecurring;
      invoiceNote.textContent =
        'Number pool: ' +
        currency(numberRecurring) +
        (quote.months === 12 ? ' / year' : ' / month') +
        ', invoiced separately after you confirm in Stripe.';
    }
    output.textContent =
      currency(quote.recurringCents - numberRecurring) +
      (quote.months === 12 ? ' / year' : ' / month') +
      ' for ' +
      count +
      (count === 1 ? ' rep' : ' reps') +
      (quote.oneTimeCents
        ? ' + ' + currency(quote.oneTimeCents) + ' once'
        : '');
  };
  const updateBilling = () => {
    const billing = currentBilling();
    document
      .querySelectorAll<HTMLElement>('[data-plan-billing]')
      .forEach((el) => {
        const cents = Number(el.dataset.monthlyCents);
        if (cents > 0)
          el.textContent =
            billing === 'annual'
              ? currency(cents * 12) + ' / seat billed annually'
              : 'Billed monthly · USD';
      });
    document
      .querySelectorAll<HTMLAnchorElement>('[data-plan-cta]')
      .forEach((link) => {
        const code =
          link.closest<HTMLElement>('[data-plan-code]')?.dataset.planCode;
        if (pricingPlans.some((p) => p.code === code))
          link.href =
            '/get-started?' +
            new URLSearchParams({ plan: code!, billing }).toString();
      });
    updateTeam();
  };
  document
    .querySelectorAll('[data-billing-control] input')
    .forEach((input) => input.addEventListener('change', updateBilling));
  const selectAddon = (addon: string | null) => {
    if (addon === 'mercury' && mercury) mercury.checked = true;
    else if (
      addon?.startsWith('minutes-') &&
      minutes &&
      minutePacks.some((pack) => String(pack.minutes) === addon.slice(8))
    )
      minutes.value = addon.slice(8);
    else if (
      addon?.startsWith('numbers-') &&
      numbers &&
      numberPacks.some((pack) => String(pack.numbers) === addon.slice(8))
    )
      numbers.value = addon.slice(8);
    else return false;
    if (addonDetails) addonDetails.open = true;
    updateTeam();
    return true;
  };
  document.addEventListener('click', (event) => {
    if (
      event.button ||
      event.metaKey ||
      event.ctrlKey ||
      event.shiftKey ||
      event.altKey
    )
      return;
    const link =
      event.target instanceof Element
        ? event.target.closest<HTMLAnchorElement>('a[href]')
        : null;
    if (!link || link.target === '_blank' || link.hasAttribute('download'))
      return;
    const url = new URL(link.href, location.href);
    if (
      url.origin !== location.origin ||
      !/^\/pricing\/?$/.test(url.pathname) ||
      !url.searchParams.has('addon')
    )
      return;
    event.preventDefault();
    if (selectAddon(url.searchParams.get('addon'))) {
      document.querySelector('[data-team-planner]')?.scrollIntoView({
        block: 'center',
        behavior: matchMedia('(prefers-reduced-motion: reduce)').matches
          ? 'instant'
          : 'smooth',
      });
      plan?.focus({ preventScroll: true });
    }
  });
  mercury?.addEventListener('change', updateTeam);
  minutes?.addEventListener('change', updateTeam);
  numbers?.addEventListener('change', updateTeam);
  seats?.addEventListener('input', updateTeam);
  plan?.addEventListener('change', updateTeam);
  document
    .querySelector<HTMLElement>('[data-billing-control]')
    ?.removeAttribute('hidden');
  document
    .querySelector<HTMLElement>('[data-team-planner]')
    ?.removeAttribute('hidden');
  updateBilling();
  selectAddon(new URLSearchParams(location.search).get('addon'));
</script>
