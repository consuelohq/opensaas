---
import SiteHeader from '../components/site/SiteHeader.astro';
import HomeFaq from '../components/home/HomeFaq.astro';
import PricingIcon from '../components/pricing/PricingIcon.astro';
import PricingAddons from '../components/pricing/PricingAddons.astro';
import PricingComparison from '../components/pricing/PricingComparison.astro';
import PricingTechnology from '../components/pricing/PricingTechnology.astro';
import {
  pricingHero,
  pricingPlans,
  pricingFaqItems,
} from '../data/pricing-content';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import '../styles/pricing.css';
---

<MarketingLayout
  title="Pricing"
  description={pricingHero.subtitle}
  canonicalPath="/pricing"
  image="/consuelo-dialer-pricing-og-20261030.png"
  imageAlt="Consuelo Dialer plans — Starter, Professional, Agency and Enterprise."
  imageWidth={1200}
  imageHeight={630}
>
  <SiteHeader pageSections={[]} />
  <main class="pricing-page" id="pricing" aria-labelledby="pricing-heading">
    <div class="pricing-frame">
      <section class="pricing-plans" aria-labelledby="pricing-heading">
        <a class="pricing-mercury-note" href="#addons"
          ><PricingIcon name="mercury" /><span
            >Meet Mercury coaching. Your playbook, in the conversation.</span
          ><PricingIcon /></a
        >
        <div class="pricing-intro">
          <div>
            <p class="pricing-eyebrow">CONSUELO / PRICING</p><h1
              id="pricing-heading"
            >
              More conversations.<br />Room to grow.
            </h1><p class="pricing-lede">{pricingHero.subtitle}</p>
          </div>
          <a class="pricing-jump" href="#compare"
            >Compare all features <PricingIcon /></a
          >
        </div>
        <div class="pricing-toolbar">
          <div
            class="pricing-products"
            aria-label="One seat, both calling motions"
          >
            <span><PricingIcon name="outbound" />Consuelo Outbound</span><span
              ><PricingIcon name="inbound" />Consuelo Inbound</span
            ><span><PricingIcon name="analytics" />Analytics</span>
          </div>
          <fieldset class="billing-control" data-billing-control hidden>
            <legend class="sr-only">Billing period</legend><label
              ><input
                type="radio"
                name="billing"
                value="monthly"
                checked
              /><span>Monthly</span></label
            ><label
              ><input type="radio" name="billing" value="annual" /><span
                >Annual</span
              ></label>
          </fieldset>
        </div>
        <div class="plan-columns">
          {
            pricingPlans.map((plan) => (
              <article
                class:list={[
                  'plan-column',
                  { 'plan-column--agency': plan.code === 'agency' },
                ]}
                data-plan-code={plan.code}
              >
                <div class="plan-column__heading">
                  <h2>{plan.name}</h2>
                  {plan.code === 'agency' && (
                    <span class="plan-kicker">FOR AGENCIES</span>
                  )}
                </div>
                <p class="plan-column__description">{plan.description}</p>
                <div class="plan-column__price">
                  <strong>
                    {plan.monthlyCents === 0 ? 'Free' : plan.price}
                  </strong>
                  {plan.monthlyCents > 0 && <span>/ seat / month</span>}
                </div>
                <p
                  class="plan-billing"
                  data-plan-billing
                  data-monthly-cents={plan.monthlyCents}
                >
                  {plan.monthlyCents === 0
                    ? '100 minutes to try Consuelo'
                    : 'Billed monthly · USD'}
                </p>
                <a
                  class:list={[
                    'pricing-button',
                    { 'pricing-button--solid': plan.code === 'agency' },
                  ]}
                  data-plan-cta
                  href={plan.href}
                >
                  {plan.action}
                  <PricingIcon />
                </a>
                <p class="plan-features-label">
                  {plan.code === 'starter'
                    ? 'A simple first step'
                    : 'What you get'}
                </p>
                <ul class="plan-bullets">
                  {plan.bullets.map((bullet) => (
                    <li>
                      <PricingIcon name="check" />
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
        <div class="pricing-fineprint">
          <p>
            One rep. Inbound and outbound. Every plan includes GoHighLevel and
            support.
          </p><p>
            Paid minutes renew monthly per seat. Contiguous US local calling.
            Taxes extra. <a href="#pricing-faq"
              >How billing works <PricingIcon /></a>
          </p>
        </div>
        <div class="team-planner" data-team-planner hidden>
          <div>
            <p class="pricing-eyebrow">BUYING FOR YOUR TEAM?</p><p>
              See the seat cost before you start.
            </p>
          </div>
          <div class="team-planner__inputs">
            <label
              >Plan<select data-team-plan
                >{
                  pricingPlans
                    .filter((p) => p.monthlyCents > 0)
                    .map((p) => (
                      <option value={p.code} selected={p.code === 'agency'}>
                        {p.name}
                      </option>
                    ))
                }</select
              ></label
            ><label
              >Reps<input
                data-seat-count
                type="number"
                min="1"
                max="1000"
                step="1"
                value="5"
                inputmode="numeric"
              /></label>
          </div>
          <output data-team-total aria-live="polite"
            >$745 / month for 5 reps</output
          >
        </div>
      </section>
      <PricingAddons />
      <PricingComparison />
      <HomeFaq
        title="Pricing FAQs"
        id="pricing-faq"
        items={pricingFaqItems}
        variant="pricing"
      />
    </div>
    <PricingTechnology />
    <section class="pricing-close" aria-labelledby="pricing-close-title">
      <p class="pricing-eyebrow">YOUR NEXT CALLING DAY</p><h2
        id="pricing-close-title"
      >
        Give your team<br />more room to sell.
      </h2><a class="pricing-button" href="/get-started"
        >Get started <PricingIcon /></a
      ><a class="pricing-close__contact" href="/contact"
        >Plan it with us <PricingIcon /></a>
    </section>
  </main>
</MarketingLayout>
<script>
  import { pricingPlans, quotePlan } from '../data/pricing-content';
  const currency = (cents: number) =>
    new Intl.NumberFormat('en-US', {
      style: 'currency',
      currency: 'USD',
      maximumFractionDigits: 0,
    }).format(cents / 100);
  const seats = document.querySelector<HTMLInputElement>('[data-seat-count]');
  const plan = document.querySelector<HTMLSelectElement>('[data-team-plan]');
  const output = document.querySelector<HTMLOutputElement>('[data-team-total]');
  const currentBilling = () =>
    document.querySelector<HTMLInputElement>('input[name="billing"]:checked')
      ?.value === 'annual'
      ? 'annual'
      : 'monthly';
  const updateTeam = () => {
    if (!seats || !plan || !output) return;
    const count = seats.valueAsNumber;
    if (!Number.isInteger(count) || count < 1 || count > 1000) {
      seats.setAttribute('aria-invalid', 'true');
      output.textContent = 'Enter a whole rep count from 1 to 1,000.';
      return;
    }
    seats.removeAttribute('aria-invalid');
    const quote = quotePlan(plan.value, currentBilling(), count);
    output.textContent =
      currency(quote.totalCents) +
      (quote.months === 12 ? ' / year' : ' / month') +
      ' for ' +
      count +
      (count === 1 ? ' rep' : ' reps');
  };
  const updateBilling = () => {
    const billing = currentBilling();
    document
      .querySelectorAll<HTMLElement>('[data-plan-billing]')
      .forEach((el) => {
        const cents = Number(el.dataset.monthlyCents);
        if (cents > 0)
          el.textContent =
            billing === 'annual'
              ? currency(cents * 12) + ' / seat billed annually'
              : 'Billed monthly · USD';
      });
    document
      .querySelectorAll<HTMLAnchorElement>('[data-plan-cta]')
      .forEach((link) => {
        const code =
          link.closest<HTMLElement>('[data-plan-code]')?.dataset.planCode;
        if (pricingPlans.some((p) => p.code === code))
          link.href =
            '/get-started?' +
            new URLSearchParams({ plan: code!, billing }).toString();
      });
    updateTeam();
  };
  document
    .querySelectorAll('[data-billing-control] input')
    .forEach((input) => input.addEventListener('change', updateBilling));
  seats?.addEventListener('input', updateTeam);
  plan?.addEventListener('change', updateTeam);
  document
    .querySelector<HTMLElement>('[data-billing-control]')
    ?.removeAttribute('hidden');
  document
    .querySelector<HTMLElement>('[data-team-planner]')
    ?.removeAttribute('hidden');
  updateBilling();
</script>
