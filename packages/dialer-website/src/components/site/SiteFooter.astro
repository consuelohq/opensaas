---
import { siteFooterGroups } from '../../data/site-navigation';

---

<footer class="dialer-footer">
  <div class="dialer-footer__main">
    <a class="dialer-footer__brand" href="/" aria-label="Consuelo Dialer home">
      <img
        src="/images/home/consuelo-mark.svg"
        width="48"
        height="48"
        alt=""
        loading="lazy"
      />
      <span>CONSUELO<br />DIALER</span>
    </a>
    <div class="dialer-footer__groups">
      {
        siteFooterGroups.map((group) => (
          <nav aria-label={group.name}>
            <>
              <h3>{group.name}</h3>
              <ul>
                {group.links.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </>
          </nav>
        ))
      }
    </div>
  </div>
  <div class="dialer-footer__bottom">
    <span>© {new Date().getFullYear()} Consuelo</span>
    <p>Made for the conversation.</p>
    <div><a href="/privacy">Privacy</a><a href="/terms">Terms</a></div>
  </div>
</footer>
<style>
  .dialer-footer {
    position: relative;
    z-index: 4;
    width: min(100%, var(--site-container-wide));
    margin-inline: auto;
    padding: var(--site-space-7) var(--site-gutter) var(--site-space-6);
    color: var(--site-color-on-brand);
    text-align: left;
  }
  .dialer-footer__main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    gap: var(--site-space-7);
    padding-block: var(--site-space-7) var(--site-space-8);
    border-top: 1px solid var(--site-color-muted-on-brand);
  }
  .dialer-footer__brand {
    display: flex;
    align-items: flex-start;
    gap: var(--site-space-3);
    width: fit-content;
    height: fit-content;
    font: 500 var(--site-text-xl)/0.9 var(--site-font-display);
  }
  .dialer-footer__brand img {
    width: var(--site-space-7);
    height: var(--site-space-7);
  }
  .dialer-footer__groups {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--site-space-6);
  }
  .dialer-footer h3 {
    margin: 0 0 var(--site-space-5);
    color: var(--site-color-on-brand);
    font: 500 var(--site-text-sm)/var(--site-leading-body) var(--site-font-body);
  }
  .dialer-footer ul {
    display: grid;
    gap: var(--site-space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .dialer-footer li {
    font-size: var(--site-text-sm);
    line-height: var(--site-leading-body);
  }
  .dialer-footer li a,
  .dialer-footer__bottom {
    color: var(--site-color-muted-on-brand);
  }
  .dialer-footer a {
    text-decoration: none;
  }
  .dialer-footer a:hover {
    color: var(--site-color-on-brand);
    text-decoration: underline;
    text-underline-offset: var(--site-space-1);
  }
  .dialer-footer a:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: var(--site-space-1);
  }
  .dialer-footer__bottom {
    display: flex;
    justify-content: space-between;
    gap: var(--site-space-5);
    font-size: var(--site-text-xs);
  }
  .dialer-footer__bottom p {
    margin: 0;
  }
  .dialer-footer__bottom div {
    display: flex;
    gap: var(--site-space-5);
  }
  @media (max-width: 1000px) {
    .dialer-footer__main {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .dialer-footer__groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--site-space-7) var(--site-space-4);
    }
    .dialer-footer__bottom {
      flex-wrap: wrap;
    }
    .dialer-footer__bottom p {
      display: none;
    }
  }
</style>