---
import { homeWorkspaceClose } from '../../data/dialer-content';
import CloudField from '../visuals/CloudField.astro';
import SiteFooter from '../site/SiteFooter.astro';
const { variant = 'home' } = Astro.props;
---

<div
  class:list={['cloud-close', { 'pricing-close': variant === 'pricing' }]}
  data-cloud-reveal
>
  <section
    class="cloud-cta"
    aria-labelledby="cloud-cta-title"
    data-section="cloud"
  >
    <CloudField />
    <div class="cloud-cta__copy" data-close-copy>
      <p class="cloud-cta__eyebrow">{homeWorkspaceClose.eyebrow}</p>
      <h2 id="cloud-cta-title">
        {
          homeWorkspaceClose.title
            .split('\n')
            .map((line) => <span data-cloud-title-line>{line}</span>)
        }
      </h2>
      <p class="cloud-cta__description">{homeWorkspaceClose.description}</p>
      <div class="cloud-cta__actions">
        <a class="cloud-cta__primary" href={homeWorkspaceClose.primaryHref}
          >{homeWorkspaceClose.primaryLabel}
          <span aria-hidden="true">↗</span></a
        >
        <a
          class="cloud-cta__secondary"
          href={variant === 'pricing'
            ? '/contact'
            : homeWorkspaceClose.secondaryHref}
          >{
            variant === 'pricing'
              ? 'TALK TO US'
              : homeWorkspaceClose.secondaryLabel
          }
          <span aria-hidden="true">↗</span></a
        >
      </div>
    </div>
  </section>
  <SiteFooter />
</div>
<style>
  .cloud-close {
    position: relative;
    z-index: 2;
    background: var(--site-color-brand);
    color: var(--site-color-on-brand);
  }
  .cloud-cta {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    overflow: hidden;
    min-height: min(80svh, 50rem);
    padding: var(--site-space-section) var(--site-gutter);
    text-align: center;
  }
  .cloud-cta :global(.cloud-field) {
    opacity: var(--dialer-footer-cloud-opacity);
  }
  .cloud-cta__copy {
    position: relative;
    z-index: 4;
    display: grid;
    width: min(100%, var(--site-container-max));
    justify-items: center;
    gap: var(--site-space-5);
  }
  .cloud-cta__eyebrow {
    margin: 0;
    font: 600 var(--site-text-xs)/var(--site-leading-body) var(--site-font-mono);
    letter-spacing: var(--site-tracking-control);
  }
  .cloud-cta h2 {
    width: 100%;
    margin: 0;
    color: var(--site-color-on-brand);
    font: 430 var(--site-footer-title-size)/var(--site-leading-tight)
      var(--site-font-display);
  }
  .cloud-cta h2 span {
    display: block;
  }
  .cloud-cta__description {
    max-width: 36rem;
    margin: 0;
    color: var(--site-color-muted-on-brand);
    font-size: var(--site-text-md);
    line-height: var(--site-leading-body);
    text-wrap: balance;
  }
  .cloud-cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--site-space-5);
    margin-top: var(--site-space-5);
  }
  .cloud-cta__primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--site-space-5);
    min-height: var(--site-space-7);
    padding: var(--site-space-4) var(--site-space-6);
    border: 1px solid var(--site-color-on-brand);
    background: var(--site-color-on-brand);
    color: var(--site-color-brand);
    font: 600 var(--site-text-xs)/1 var(--site-font-mono);
    letter-spacing: var(--site-tracking-control);
    transition:
      background var(--site-motion-fast),
      color var(--site-motion-fast);
  }
  .cloud-cta__primary:hover {
    background: transparent;
    color: var(--site-color-on-brand);
  }
  .cloud-cta__secondary {
    color: var(--site-color-on-brand);
    font: 600 var(--site-text-xs)/var(--site-leading-body) var(--site-font-mono);
    text-decoration: underline;
    text-underline-offset: var(--site-space-1);
  }
  .cloud-cta a:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: var(--site-space-2);
  }
  .cloud-cta__copy[data-reveal-ready] {
    opacity: 0;
    transform: translateY(var(--site-space-5));
    transition:
      opacity var(--site-motion-slow) var(--site-ease-emphasized),
      transform var(--site-motion-slow) var(--site-ease-emphasized);
  }
  .cloud-cta__copy[data-revealed] {
    opacity: 1;
    transform: none;
  }
  @media (max-width: 600px) {
    .cloud-cta h2 {
      font-size: var(--site-footer-title-size-mobile);
    }
  }
  @media (max-height: 600px) {
    .cloud-cta h2 {
      font-size: var(--site-footer-title-size-compact);
    }
    .cloud-cta {
      min-height: auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cloud-cta__copy[data-reveal-ready] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
<script>
  const copy = document.querySelector<HTMLElement>('[data-close-copy]');
  if (
    copy &&
    'IntersectionObserver' in window &&
    !matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    copy.setAttribute('data-reveal-ready', '');
    const reveal = () => {
      copy.setAttribute('data-revealed', '');
      observer.disconnect();
    };
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) reveal();
      },
      { threshold: 0.15 },
    );
    observer.observe(copy);
    // Keyboard navigation must reveal an off-screen link without waiting for scrolling.
    copy.addEventListener('focusin', reveal, { once: true });
  }
</script>