---
import { homeFeaturePreviewItems } from '../../data/dialer-content';
import PricingIcon from '../pricing/PricingIcon.astro';
import HomeFaq from './HomeFaq.astro';

type Props = { sectionId?: string };
const { sectionId = 'features' } = Astro.props as Props;
---

<section class="product-panel" id={sectionId} data-section="features">
  <div class="product-panel__paper">
    <header class="product-panel__intro">
      <p class="product-panel__eyebrow">CONSUELO DIALER / CAPABILITIES</p>
      <h2>Make the call. <em>Keep the momentum.</em></h2>
      <p class="product-panel__lead">From first outreach to the next follow-up, keep your team working in GoHighLevel.</p>
    </header>
    <div class="product-story" data-feature-story>
      {homeFeaturePreviewItems.map((item) => (
        <article id={item.icon} class="product-story__chapter" data-feature-chapter={item.label.toLowerCase()}>
          <p class="product-story__eyebrow">
            <PricingIcon name={item.icon} />
            <span>0{item.number} / {item.label}</span>
          </p>
          <h3>{item.title.split('\n').map((line) => <span>{line}</span>)}</h3>
          <p class="product-story__description">{item.body}</p>
        </article>
      ))}
    </div>
    <div class="product-panel__actions">
      <p>See how it feels to work a call.</p>
      <div>
        <a class="product-panel__demo" href="/demo">INTERACTIVE DEMO <span aria-hidden="true">↗</span></a>
        <a class="product-panel__start" href="/pricing">GET STARTED <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <HomeFaq />
  </div>
</section>

<style>
  .product-panel {
    position: relative;
    z-index: 3;
    margin-top: var(--site-sticky-sliver);
    padding: 0 var(--site-frame-inset) var(--site-frame-inset);
    background: var(--site-color-brand);
  }
  .product-panel__paper { background: var(--site-color-surface); color: var(--site-color-brand); }
  .product-panel__intro {
    display: grid;
    justify-items: center;
    gap: var(--site-space-5);
    padding: clamp(4rem, 8vw, 8rem) var(--site-space-4) var(--site-space-8);
    text-align: center;
  }
  .product-panel__eyebrow, .product-story__eyebrow {
    margin: 0;
    font: 650 var(--site-text-xs)/1.35 var(--site-font-mono);
    letter-spacing: var(--site-tracking-control);
  }
  .product-panel__intro h2 {
    max-width: 68rem;
    margin: 0;
    font: 430 clamp(3.5rem, 7.5vw, 7.5rem)/0.99 var(--site-font-display);
    text-wrap: balance;
  }
  .product-panel__intro h2 em { display: block; font-style: normal; }
  .product-panel__lead {
    max-width: 38rem;
    margin: 0;
    font: 400 var(--site-text-md)/var(--site-leading-body) var(--site-font-body);
    text-wrap: balance;
  }
  .product-story {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(var(--site-space-7), 7vw, var(--site-space-8));
    row-gap: var(--site-space-8);
    padding: var(--site-space-6) clamp(var(--site-space-5), 7vw, var(--site-space-8)) var(--site-space-8);
  }
  .product-story__chapter {
    display: grid;
    align-content: start;
    gap: var(--site-space-5);
    min-width: 0;
    scroll-margin-top: calc(var(--dialer-returning-nav-height) + var(--site-space-5));
  }
  .product-story__eyebrow { display: flex; align-items: center; gap: var(--site-space-3); }
  .product-story__eyebrow :global(svg) { width: var(--site-space-6); height: var(--site-space-6); }
  .product-story__chapter h3 {
    margin: 0;
    font: 440 clamp(2.8rem, 4.3vw, 5.25rem)/1.01 var(--site-font-display);
    text-wrap: balance;
  }
  .product-story__chapter h3 span { display: block; }
  .product-story__description {
    max-width: 31rem;
    margin: 0;
    font: 400 var(--site-text-md)/var(--site-leading-body) var(--site-font-body);
    text-wrap: pretty;
  }
  .product-panel__actions {
    display: grid;
    justify-items: center;
    gap: var(--site-space-4);
    padding: var(--site-space-6) var(--site-space-4) var(--site-space-8);
    text-align: center;
  }
  .product-panel__actions p { margin: 0; font: 440 var(--site-text-2xl)/var(--site-leading-tight) var(--site-font-display); }
  .product-panel__actions > div { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--site-space-3); }
  .product-panel__actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--site-space-2);
    min-height: var(--site-space-7);
    padding: var(--site-space-3) var(--site-space-5);
    font: 650 var(--site-text-xs)/1 var(--site-font-mono);
    letter-spacing: var(--site-tracking-control);
    text-decoration: none;
    transition: background var(--site-motion-fast), color var(--site-motion-fast);
  }
  .product-panel__demo { color: var(--site-color-brand); background: transparent; }
  .product-panel__demo:hover, .product-panel__demo:focus-visible { text-decoration: underline; }
  .product-panel__start { background: var(--site-color-brand); color: var(--site-color-on-brand); }
  .product-panel__start:hover, .product-panel__start:focus-visible { background: var(--site-color-secondary); }
  .product-panel__actions a:focus-visible { outline: 2px solid currentColor; outline-offset: var(--site-space-1); }
  @media (max-width: 760px) {
    .product-panel__intro { padding: var(--site-space-7) var(--site-space-4); }
    .product-panel__intro h2 { font-size: clamp(2.6rem, 11vw, 4.5rem); }
    .product-story { grid-template-columns: 1fr; row-gap: var(--site-space-7); padding: var(--site-space-4) var(--site-space-5) var(--site-space-7); }
    .product-story__chapter h3 { font-size: clamp(2.5rem, 11vw, 3.75rem); }
    .product-panel__actions p { font-size: var(--site-text-xl); }
  }
  @media (prefers-reduced-motion: reduce) { .product-panel__actions a { transition: none; } }
</style>
