---
import { homeFaqItems } from '../../data/dialer-content';
import PricingIcon from '../pricing/PricingIcon.astro';
interface Props {
  items?: typeof homeFaqItems;
  title?: string;
  id?: string;
  variant?: 'home' | 'pricing';
}
const {
  items = homeFaqItems,
  title = 'FAQ',
  id = 'faq',
  variant = 'home',
} = Astro.props;
---

<section
  class:list={['home-faq', { 'home-faq--pricing': variant === 'pricing' }]}
  id={id}
  aria-labelledby={id + '-title'}
  data-section="faq"
>
  <div class="home-faq__heading">
    <h2 id={id + '-title'}>{title}</h2>{
      variant === 'pricing' && (
        <a class="home-faq__more" href="/#faq">
          More about Consuelo <PricingIcon />
        </a>
      )
    }
  </div>
  <div class="home-faq__list" data-home-faq-list>
    {
      items.map((item) => (
        <details data-home-faq-item>
          <summary>
            <span>{item.question}</span>
            <span class="home-faq__icon" aria-hidden="true">
              {variant === 'pricing' ? <PricingIcon /> : '+'}
            </span>
          </summary>
          <div class="home-faq__answer">
            {item.details ? (
              item.details.map((block) =>
                block.type === 'paragraph' ? (
                  <p>{block.text}</p>
                ) : block.type === 'list' ? (
                  <ul class="home-faq__bullets">
                    {block.items.map((entry) => (
                      <li>{entry}</li>
                    ))}
                  </ul>
                ) : (
                  <ol class="home-faq__steps">
                    {block.items.map((entry) => (
                      <li>
                        <strong>{entry.label}</strong>
                        <span>{entry.text}</span>
                      </li>
                    ))}
                  </ol>
                ),
              )
            ) : (
              <p>{item.answer}</p>
            )}
            {item.linkHref && item.linkLabel && (
              <a class="home-faq__link" href={item.linkHref}>
                {item.linkLabel} →
              </a>
            )}
          </div>
        </details>
      ))
    }
  </div>
</section>

<script>
  document
    .querySelectorAll<HTMLElement>('[data-home-faq-list]')
    .forEach((list) => {
      const items = Array.from(
        list.querySelectorAll<HTMLDetailsElement>('[data-home-faq-item]'),
      );

      items.forEach((item) => {
        item.addEventListener('toggle', () => {
          if (!item.open) {
            return;
          }

          items.forEach((otherItem) => {
            if (otherItem !== item) {
              otherItem.open = false;
            }
          });
        });
      });
    });
</script>

<style>
  .home-faq {
    padding: clamp(7.5rem, 12vw, 11rem) clamp(1rem, 5vw, 5rem)
      clamp(7rem, 12vw, 11rem);
  }

  .home-faq h2 {
    margin: 0 0 clamp(2.75rem, 4.5vw, 4.5rem);
    color: var(--site-color-brand);
    font-family: var(--site-font-display);
    font-size: clamp(5rem, 12vw, 11rem);
    font-weight: 430;
    letter-spacing: 0;
    line-height: 0.72;
    text-align: center;
  }

  .home-faq__list {
    width: min(100%, 60rem);
    margin: 0 auto;
    border-top: 1px dashed var(--site-color-line-strong);
  }

  .home-faq details {
    border-bottom: 1px dashed var(--site-color-line-strong);
    padding-inline: 0.85rem;
    transition: background var(--site-motion-fast);
  }

  .home-faq details:hover,
  .home-faq details:focus-within,
  .home-faq details[open] {
    background: var(--site-color-soft-white);
  }

  .home-faq summary {
    display: flex;
    min-height: 4.1rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--site-color-brand);
    cursor: pointer;
    font-family: var(--site-font-display);
    font-size: clamp(1.2rem, 1.8vw, 1.7rem);
    font-weight: 400;
    line-height: 1.05;
    list-style: none;
  }

  .home-faq summary::-webkit-details-marker {
    display: none;
  }

  .home-faq__icon {
    flex: 0 0 auto;
    font-family: var(--site-font-body);
    font-size: 1.8rem;
    font-weight: 700;
    transition: transform var(--site-motion-medium);
  }

  .home-faq details[open] .home-faq__icon {
    transform: rotate(45deg);
  }

  .home-faq__answer {
    display: grid;
    max-width: 48rem;
    gap: 0.9rem;
    margin: -0.15rem 0 1.75rem;
    color: var(--site-color-muted);
    font-size: 0.94rem;
    line-height: 1.65;
  }

  .home-faq__answer p {
    max-width: 44rem;
    margin: 0;
  }

  .home-faq__bullets,
  .home-faq__steps {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-faq__bullets li,
  .home-faq__steps li {
    position: relative;
    padding-left: 1.35rem;
  }

  .home-faq__bullets li::before {
    position: absolute;
    top: 0.62em;
    left: 0.18rem;
    width: 0.32rem;
    height: 0.32rem;
    background: var(--site-color-brand);
    content: '';
  }

  .home-faq__steps {
    counter-reset: faq-step;
  }

  .home-faq__steps li {
    display: grid;
    grid-template-columns: minmax(7rem, 0.32fr) 1fr;
    gap: 0.8rem;
    border-top: 1px solid var(--site-color-line);
    padding: 0.7rem 0 0;
    counter-increment: faq-step;
  }

  .home-faq__steps li:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .home-faq__steps strong {
    color: var(--site-color-brand);
    font: 650 0.72rem/1.35 var(--site-font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .home-faq__steps strong::before {
    content: counter(faq-step, decimal-leading-zero) ' ';
    opacity: 0.45;
  }

  .home-faq__link {
    width: fit-content;
    color: var(--site-color-brand);
    font: 650 0.72rem/1 var(--site-font-mono);
    letter-spacing: 0.08em;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-transform: uppercase;
  }

  @media (max-width: 600px) {
    .home-faq h2 {
      font-size: clamp(4.25rem, 22vw, 6rem);
    }

    .home-faq summary {
      min-height: 3.55rem;
      font-size: 1.15rem;
    }

    .home-faq__answer {
      font-size: 0.84rem;
      line-height: 1.6;
    }

    .home-faq__steps li {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-faq details,
    .home-faq__icon {
      transition: none;
    }
  }
</style>

<style>
  .home-faq--pricing {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.8fr);
    gap: var(--site-space-8);
    padding: var(--site-space-8) var(--site-panel-pad);
    background: var(--site-color-panel);
  }
  .home-faq--pricing .home-faq__heading {
    position: sticky;
    top: var(--site-space-7);
    align-self: start;
  }
  .home-faq--pricing h2 {
    text-align: left;
    font: 450 clamp(2.5rem, 4vw, 4rem)/1 var(--site-font-display);
    letter-spacing: -0.035em;
    margin: 0 0 var(--site-space-6);
  }
  .home-faq--pricing .home-faq__list {
    width: 100%;
    border-top: 1px solid var(--site-color-line-strong);
  }
  .home-faq--pricing details {
    padding: 0;
    border-bottom: 1px solid var(--site-color-line-strong);
  }
  .home-faq--pricing details:hover,
  .home-faq--pricing details:focus-within,
  .home-faq--pricing details[open] {
    background: transparent;
  }
  .home-faq--pricing summary {
    padding: var(--site-space-5) 0;
    font: 450 clamp(1.15rem, 1.6vw, 1.5rem)/1.35 var(--site-font-body);
    align-items: flex-start;
  }
  .home-faq--pricing .home-faq__answer {
    font-size: var(--site-text-sm);
    line-height: 1.8;
    margin: 0 0 var(--site-space-5);
    padding-right: var(--site-space-6);
  }
  .home-faq--pricing .home-faq__icon {
    display: flex;
    transform: rotate(90deg);
    padding-top: 0.1rem;
  }
  .home-faq--pricing details[open] .home-faq__icon {
    transform: rotate(-90deg);
  }
  .home-faq__more {
    display: inline-flex;
    gap: var(--site-space-2);
    align-items: center;
    font-size: var(--site-text-sm);
    color: inherit;
    text-underline-offset: 0.2em;
  }
  .home-faq__more :global(svg),
  .home-faq--pricing .home-faq__icon :global(svg) {
    width: 1.4rem;
    height: 1.4rem;
  }
  @media (max-width: 760px) {
    .home-faq--pricing {
      grid-template-columns: 1fr;
      gap: var(--site-space-6);
      padding: var(--site-space-7) var(--site-space-4);
    }
    .home-faq--pricing .home-faq__heading {
      position: static;
    }
  }
  @media (max-height: 500px) {
    .home-faq--pricing .home-faq__heading {
      position: static;
    }
  }
</style>
