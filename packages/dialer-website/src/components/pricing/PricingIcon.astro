---
interface Props {
  name?: string;
  class?: string;
}
const { name = 'arrow', class: className = '' } = Astro.props;
const paths: Record<string, string> = {
  arrow: 'M4 12h15m-6-6 6 6-6 6',
  outbound: 'M5 18 18 5M7 5h11v11',
  inbound: 'M18 5 5 18M5 7v11h11',
  connect: 'M9 7H7a5 5 0 0 0 0 10h2m6-10h2a5 5 0 0 1 0 10h-2M8 12h8',
  analytics: 'M4 19h16M6 15v-4m6 4V5m6 10V8',
  mercury: 'M12 3v18M3 12h18M6 6l12 12M6 18 18 6',
  team: 'M8 12a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm8-1a2 2 0 1 0 0-4m-13 13v-2a5 5 0 0 1 10 0v2m2-6a4 4 0 0 1 6 4v2',
  shield: 'M12 3 4 6v6c0 4 4 7 8 9 4-2 8-5 8-9V6l-8-3Zm-4 9 3 3 5-6',
  code: 'm8 6-6 6 6 6m8-12 6 6-6 6m-3-14-2 16',
  number: 'M8 3 5 21M17 3l-3 18M3 9h18M2 15h18',
  check: 'm4.5 12 5 5L20 6.5',
  chevron: 'm9 5 7 7-7 7',
  minus: 'M6 12h12',
};
---

<svg
  class={className}
  data-icon={name}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={name === 'check' ? '1.6' : name === 'chevron' ? '1.5' : '1.35'}
  stroke-linecap={['check', 'chevron', 'minus'].includes(name)
    ? 'round'
    : 'square'}
  stroke-linejoin={['check', 'chevron'].includes(name) ? 'round' : 'miter'}
  aria-hidden="true"
  ><path
    d={paths[name] ?? paths.arrow}
    vector-effect={['check', 'chevron', 'minus'].includes(name)
      ? 'non-scaling-stroke'
      : undefined}></path></svg
>
