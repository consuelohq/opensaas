---
type Props = { variant?: 'pricing' | 'home' };
const { variant = 'pricing' } = Astro.props as Props;

const technologies = [
  ['twilio', 'Twilio', true],
  ['openai', 'OpenAI'],
  ['claude', 'Claude'],
  ['opencode', 'OpenCode'],
  ['pi', 'Pi', true],
  ['bun', 'Bun', true],
  ['hono', 'Hono', true],
  ['postgresql', 'PostgreSQL'],
  ['redis', 'Redis', true],
  ['cloudflare', 'Cloudflare', true],
  ['github', 'GitHub'],
  ['groq', 'Groq'],
] as const;
---

<section
  class:list={['pricing-technology', { 'pricing-technology--home': variant === 'home' }]}
  aria-labelledby="technology-heading"
  data-logo-carousel
>
  <h2 id="technology-heading">Built for scale</h2>
  <div
    class="technology-strip"
    data-technology-strip
    tabindex="0"
    role="region"
    aria-label="Tools in our stack — pause on hover or focus"
  >
    <div class="technology-track" data-logo-track>
      {
        [false, true].map((duplicate) =>
          technologies.map(([slug, name, symbol]) => (
            <span
              class:list={[
                'technology-wordmark',
                { 'technology-wordmark--symbol': symbol },
              ]}
              aria-hidden={duplicate || undefined}
            >
              <img
                src={'/images/technology/wordmarks/' + slug + '.svg'}
                width="112"
                height="32"
                alt={duplicate ? '' : name}
                loading="lazy"
              />
            </span>
          )),
        )
      }
    </div>
  </div>
</section>
<style is:global>
  .pricing-technology {
    background: var(--site-color-surface);
    color: var(--site-color-stack-ink);
    padding: var(--site-space-8) 0;
    text-align: center;
    overflow: hidden;
  }
  .pricing-technology--home {
    background: var(--site-color-brand);
    color: var(--site-color-on-brand);
    padding: var(--site-space-7) 0 var(--site-space-6);
  }
  .pricing-technology h2 {
    margin: 0 0 var(--site-space-7);
    font: 500 0.9rem/1.4 var(--site-font-mono);
    letter-spacing: var(--site-tracking-control);
  }
  .pricing-technology--home h2 {
    margin-bottom: var(--site-space-5);
    font-size: var(--site-text-xs);
    text-transform: uppercase;
  }
  .technology-strip {
    --visible-logos: 7;
    overflow: hidden;
  }
  .technology-track {
    display: flex;
    width: max-content;
  }
  .technology-wordmark {
    display: grid;
    place-items: center;
    flex: 0 0 calc((100vw - 2 * var(--site-frame-inset)) / var(--visible-logos));
    width: calc((100vw - 2 * var(--site-frame-inset)) / var(--visible-logos));
    height: var(--site-space-8);
    padding: 0 var(--site-space-5);
  }
  .technology-wordmark img {
    width: min(100%, var(--dialer-logo-size));
    height: var(--dialer-logo-height);
    max-width: none;
    max-height: none;
    object-fit: contain;
  }
  .pricing-technology--home .technology-wordmark img {
    filter: grayscale(1) brightness(0) invert(1);
    opacity: 0.85;
  }
  .technology-wordmark--symbol img {
    width: var(--dialer-logo-height);
    height: var(--dialer-logo-height);
  }
  @media (max-width: 1050px) {
    .technology-strip { --visible-logos: 5; }
  }
  @media (max-width: 600px) {
    .technology-strip { --visible-logos: 3; }
  }
  @media (prefers-reduced-motion: reduce) {
    .technology-strip { overflow-x: auto; }
    .technology-track [aria-hidden] { display: none; }
  }
</style>
<script>
  const root = document.querySelector<HTMLElement>('[data-logo-carousel]');
  const track = root?.querySelector<HTMLElement>('[data-logo-track]');
  if (root && track) {
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    let animation: Animation | undefined;
    let visible = false;
    let hovering = false;
    const sync = () => {
      if (motion.matches) {
        animation?.cancel();
        animation = undefined;
        return;
      }
      animation ??= track.animate(
        [{ transform: 'translateX(0)' }, { transform: 'translateX(-50%)' }],
        { duration: 48000, iterations: Infinity, easing: 'linear' },
      );
      if (
        hovering ||
        !visible ||
        document.hidden ||
        root.contains(document.activeElement)
      )
        animation.pause();
      else animation.play();
    };
    const observer = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      sync();
    });
    observer.observe(root);
    root.addEventListener('mouseenter', () => {
      hovering = true;
      sync();
    });
    root.addEventListener('mouseleave', () => {
      hovering = false;
      sync();
    });
    root.addEventListener('focusin', sync);
    root.addEventListener('focusout', () => requestAnimationFrame(sync));
    motion.addEventListener('change', sync);
    document.addEventListener('visibilitychange', sync);
    window.addEventListener('pagehide', () => {
      animation?.cancel();
      animation = undefined;
    });
    window.addEventListener('pageshow', sync);
    sync();
  }
</script>
