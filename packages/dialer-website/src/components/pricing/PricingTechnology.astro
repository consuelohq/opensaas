---
const technologies = [
  ['twilio', 'Twilio', true],
  ['openai', 'OpenAI'],
  ['claude', 'Claude'],
  ['opencode', 'OpenCode'],
  ['pi', 'Pi', true],
  ['bun', 'Bun', true],
  ['hono', 'Hono', true],
  ['postgresql', 'PostgreSQL'],
  ['redis', 'Redis', true],
  ['cloudflare', 'Cloudflare', true],
  ['github', 'GitHub'],
  ['groq', 'Groq'],
] as const;
---

<section
  class="pricing-technology"
  aria-labelledby="technology-heading"
  data-logo-carousel
>
  <h2 id="technology-heading">Built for scale</h2>
  <div
    class="technology-strip"
    data-technology-strip
    tabindex="0"
    role="region"
    aria-label="Tools in our stack"
  >
    <div class="technology-track" data-logo-track>
      {
        [false, true].map((duplicate) =>
          technologies.map(([slug, name, symbol]) => (
            <span
              class:list={[
                'technology-wordmark',
                { 'technology-wordmark--symbol': symbol },
              ]}
              aria-hidden={duplicate || undefined}
            >
              <img
                src={'/images/technology/wordmarks/' + slug + '.svg'}
                width="112"
                height="32"
                alt={duplicate ? '' : name}
                loading="lazy"
              />
            </span>
          )),
        )
      }
    </div>
  </div>
  <button
    class="technology-pause"
    type="button"
    data-logo-pause
    hidden
    aria-pressed="false">Pause logos</button
  >
</section>
<script>
  const root = document.querySelector<HTMLElement>('[data-logo-carousel]');
  const track = root?.querySelector<HTMLElement>('[data-logo-track]');
  const button = root?.querySelector<HTMLButtonElement>('[data-logo-pause]');
  if (root && track && button) {
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    let animation: Animation | undefined;
    let paused = false;
    let visible = false;
    let hovering = false;
    const sync = () => {
      if (motion.matches) {
        animation?.cancel();
        animation = undefined;
        button.hidden = true;
        return;
      }
      button.hidden = false;
      animation ??= track.animate(
        [{ transform: 'translateX(0)' }, { transform: 'translateX(-50%)' }],
        { duration: 48000, iterations: Infinity, easing: 'linear' },
      );
      if (
        paused ||
        hovering ||
        !visible ||
        document.hidden ||
        root.contains(document.activeElement)
      )
        animation.pause();
      else animation.play();
    };
    const observer = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      sync();
    });
    observer.observe(root);
    button.addEventListener('click', () => {
      paused = !paused;
      button.setAttribute('aria-pressed', String(paused));
      button.textContent = paused ? 'Play logos' : 'Pause logos';
      sync();
    });
    root.addEventListener('mouseenter', () => {
      hovering = true;
      sync();
    });
    root.addEventListener('mouseleave', () => {
      hovering = false;
      sync();
    });
    root.addEventListener('focusin', sync);
    root.addEventListener('focusout', () => requestAnimationFrame(sync));
    motion.addEventListener('change', sync);
    document.addEventListener('visibilitychange', sync);
    window.addEventListener('pagehide', () => {
      animation?.cancel();
      animation = undefined;
    });
    window.addEventListener('pageshow', sync);
    sync();
  }
</script>
