#!/bin/sh
# Lint staged Consuelo TypeScript/JavaScript sources.

STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^packages/.*\.(ts|tsx|js|mjs|cjs)$' || true)

if [ -z "$STAGED" ]; then
  exit 0
fi

echo "→ linting staged Consuelo sources..."
npx eslint $STAGED --no-warn-ignored --quiet
